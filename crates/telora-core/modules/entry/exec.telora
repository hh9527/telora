import "entry/rt.native.telora" *;
import "std/array" as array;
import "std/codec" as codec;
import "std/json" as json;
import "std/rt-types/exec.telora" {
    ExecFn,
    ExecSettings,
    ExecRequest,
    ExecEnvironment,
    ExecEnv,
    Install,
};

def unwrap = fn(result) {
    match result {
        'Ok(value) => value,
        'Err(error) => fail!("entry operation failed", error),
    }
};

def capture_names = fn(options) {
    array.flat_map(options, fn(action) {
        if action.key == "exec.capture-envs" {
            unwrap(option_names(action.value))
        } else {
            []
        }
    })
};

def capture_env = fn(handle, options) {
    capture_vars(handle, capture_names(options))
};

export def entry = fn(handle) {
    let options = module_options(handle);
    let settings: ExecSettings = unwrap(validate(ExecSettings, {
        platform: platform(handle),
        download_prefix: download_prefix(handle),
        install_prefix: install_prefix(handle),
    }));
    let request: ExecRequest = {
        args: args(handle),
        env: capture_env(handle, options),
        cwd: cwd(handle),
    };
    let initialized = unwrap(initialize_module(handle));
    let raw_exec = unwrap(module_export(initialized, "exec"));
    let exec = unwrap(check_type(ExecFn, raw_exec));
    let output = exec(settings, request);
    let encoded = unwrap(codec.encode(ExecEnv, output));
    {
        install: json.stringify(encoded.install),
        exec_opts: json.stringify({
            cwd: encoded.cwd,
            bin: encoded.bin,
            args: encoded.args,
            env: encoded.env,
        }),
    }
};
