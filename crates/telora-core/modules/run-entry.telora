import "std/rt.priv.telora" as rt;
import "std/dyn" as dyn;

export type MainType = Dyn;

@struct
type State = {
    main: Dyn,
    completed: Bool,
};

export def prepare:
    Fn(rt.SystemOptions) -> rt.SystemCaps
    = fn(options) {
        {
            input: match options.input {
                'Some(_) => 'True,
                'None => 'False,
            },
        }
    };

type Transition = Tuple([State, Array(rt.SystemEffect)]);
type Reducer = Fn(State, rt.SystemEvent) -> Transition;

export def initialize:
    Fn(MainType) -> Tuple([State, Reducer])
    = fn(main) {
        let state: State = {
            main: main,
            completed: 'False,
        };
        let reduce: Reducer = fn(state, event) {
            if state.completed {
                fail!("built-in run entry received an event after completion", event)
            } else match event {
                'Initialize => {
                    let output = match dyn.field(state.main, "output") {
                        'Ok(value) => value,
                        'Err(error) => fail!("cannot observe the Main export record", error, state.main),
                    };
                    let text = match dyn.check_string(output) {
                        'Some(value) => value,
                        'None => fail!("the built-in run Entry requires a String output export", output),
                    };
                    (
                        {main: state.main, completed: 'True},
                        ['Output(text), 'Exit(0)],
                    )
                },
                _ => fail!("built-in run entry received an unsupported event", event),
            }
        };
        (state, reduce)
    };

export { State };
