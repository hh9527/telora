type RenameCase = enum {CamelCase};

@property(PropertyTarget.Type)
type JsonRenameAll = struct {case: RenameCase};

@property(PropertyTarget.Type)
type JsonUntagged = struct {};

def rename_all: Fn(RenameCase) -> Fn(Type, Option(JsonRenameAll)) -> JsonRenameAll = fn(case) {
    fn(target, previous) {
        if case == RenameCase.CamelCase {
            let property: JsonRenameAll = {case};
            property
        } else {
            fail!("std/json.rename_all expects RenameCase.CamelCase")
        }
    }
};

def untagged: Fn(Type, Option(JsonUntagged)) -> JsonUntagged = fn(target, previous) {
    let property: JsonUntagged = {};
    property
};

export {RenameCase, JsonRenameAll, JsonUntagged, rename_all, untagged};
