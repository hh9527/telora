import "std/_rt" as rt;
import "std/actor" as actor;
import "std/array" as array;
import "std/codec" as codec;
import "std/dict" as dict;
import "std/ees" as ees;
import "std/entry" as entry;
import "std/fmt" as fmt;
import "std/json" as json;
import "std/result" as result;
import "std/string" as string;
import "std/value" {Value};

export type MainType = struct {
    config: entry.ContextConfig,
    ees: ees.Config,
    start: Fn(entry.Context) -> actor.Service,
};

type RequestContext = struct {
    id: String,
    diagnostics: Array(Value),
};
type Pending = struct { id: String, request_id: String };
type State = struct {
    service: actor.Service,
    next_request: Int,
    requests: Array(RequestContext),
    pending: Array(Pending),
    eof: Bool,
};
type Collected = struct {
    requests: Array(RequestContext),
    pending: Array(Pending),
    effects: Array(rt.SystemEffect),
};
type Transition = Tuple([State, Array(rt.SystemEffect)]);
type Reducer = Fn(State, rt.SystemEvent) -> Transition;
type Initializer = Fn(rt.SystemResources, MainType) -> Tuple([State, Reducer]);

def configure_sources: Fn(Array(String), Dict(rt.DataSrc)) -> Dict(rt.DataSrc) =
    fn(declared, sources) {
        let provided = dict.keys(sources);
        let unique = array.all(declared, fn(name) {
            array.length(array.filter(declared, fn(other) { other == name })) == 1
        });
        if unique == 'False {
            fail!("entry ContextConfig.sources must contain unique names")
        } else if array.all(declared, fn(name) {
            array.any(provided, fn(other) { other == name })
        }) == 'False {
            fail!("a source declared by entry ContextConfig was not provided", declared, provided)
        } else if array.all(provided, fn(name) {
            array.any(declared, fn(other) { other == name })
        }) == 'False {
            fail!("an undeclared source was provided", declared, provided)
        } else {
            sources
        }
    };

def declared_ees: Fn(Array(ees.Model)) -> Dict(String) = fn(models) {
    let pairs = array.map(models, fn(model) { (model.name, model.kind) });
    let unique = array.all(pairs, fn(declaration) {
        declaration.0 != "" && array.length(array.filter(pairs, fn(other) {
            other.0 == declaration.0
        })) == 1
    });
    if unique == 'False {
        fail!("EES model declarations must contain unique non-empty names")
    } else {
        dict.from_pairs(pairs)
    }
};

def diagnostics: Fn(Array(rt.Diagnostic)) -> Array(Value) = fn(found) {
    array.map(found, fn(diagnostic) {
        'Object({message: 'String(codec.format_error(diagnostic))})
    })
};

def success_response: Fn(Value, Array(Value)) -> String = fn(value, found) {
    string.join([json.stringify('Object({
        ok: value,
        error: 'False,
        diagnostics: 'Array(found),
    })), ""], "\n")
};

def failure_response: Fn(Array(Value)) -> String = fn(found) {
    string.join([json.stringify('Object({
        ok: 'None,
        error: 'True,
        diagnostics: 'Array(found),
    })), ""], "\n")
};

def find_request: Fn(Array(RequestContext), String) -> Option(RequestContext) =
    fn(requests, id) { array.find(requests, fn(item) { item.id == id }) };

def remove_request: Fn(Array(RequestContext), String) -> Array(RequestContext) =
    fn(requests, id) { array.filter(requests, fn(item) { item.id != id }) };

def add_diagnostics: Fn(Array(RequestContext), String, Array(Value)) -> Array(RequestContext) =
    fn(requests, id, found) {
        array.map(requests, fn(item) {
            if item.id == id {
                {id: item.id, diagnostics: array.concat([item.diagnostics, found])}
            } else {
                item
            }
        })
    };

def remove_pending: Fn(Array(Pending), String) -> Array(Pending) = fn(pending, id) {
    array.filter(pending, fn(item) { item.id != id })
};

def maybe_exit: Fn(State, Array(rt.SystemEffect)) -> Transition = fn(state, effects) {
    if state.eof && array.length(state.requests) == 0 && array.length(state.pending) == 0 {
        (state, array.push(effects, 'Exit(0)))
    } else {
        (state, effects)
    }
};

def advance: Fn(State, String, actor.Event) -> Transition = fn(state, active_id, event) {
    match rt.with_diagnostics(state.service.reduce)((state.service.state, event)) {
        'Err(found) => {
            let current = match find_request(state.requests, active_id) {
                'Some(current) => current,
                'None => fail!("actor reducer failed for an unknown request", active_id),
            };
            let state: State = {
                service: state.service,
                next_request: state.next_request,
                requests: remove_request(state.requests, active_id),
                pending: state.pending,
                eof: state.eof,
            };
            maybe_exit(state, ['Output(failure_response(array.concat([
                current.diagnostics,
                diagnostics(found),
            ])))])
        },
        'Ok(observed) => {
            let requests = add_diagnostics(state.requests, active_id, diagnostics(observed.1));
            let service: actor.Service = {
                state: observed.0.0,
                reduce: state.service.reduce,
            };
            let initial: Collected = {requests, pending: state.pending, effects: []};
            let collected = array.fold(observed.0.1, initial, fn(found, effect) {
                match effect {
                    'EesCall(call) => {
                        if find_request(found.requests, call.request_id) == 'None {
                            fail!("actor emitted EesCall for an unknown request", call.request_id)
                        } else if array.any(found.pending, fn(item) { item.id == call.id }) {
                            fail!("actor reused an active EES call id", call.id)
                        } else {
                            {
                                requests: found.requests,
                                pending: array.push(found.pending, {
                                    id: call.id,
                                    request_id: call.request_id,
                                }),
                                effects: array.push(found.effects, 'EesCall({
                                    actor: call.request.0,
                                    input: call.request.2,
                                    key: call.id,
                                    operation: call.request.1,
                                })),
                            }
                        }
                    },
                    'Reply(reply) => match find_request(found.requests, reply.request_id) {
                        'None => fail!("actor replied to an unknown request", reply.request_id),
                        'Some(current) => if array.any(found.pending, fn(item) {
                            item.request_id == reply.request_id
                        }) {
                            fail!("actor replied while EES calls were still active", reply.request_id)
                        } else {
                            {
                                requests: remove_request(found.requests, reply.request_id),
                                pending: found.pending,
                                effects: array.push(found.effects, 'Output(success_response(
                                    reply.value,
                                    current.diagnostics,
                                ))),
                            }
                        },
                    },
                }
            });
            maybe_exit(
                {
                    service,
                    next_request: state.next_request,
                    requests: collected.requests,
                    pending: collected.pending,
                    eof: state.eof,
                },
                collected.effects,
            )
        },
    }
};

export def config:
    Fn(rt.Env, MainType) -> Tuple([rt.SystemCaps, Initializer]) =
    fn(env, main) {
        let _mode = if env.mode == 'Serve { 'True } else {
            fail!("serve Entry policy requires Serve mode")
        };
        let data_srcs = configure_sources(main.config.sources, env.sources);
        let models = declared_ees(main.ees.models);
        let args = if main.config.args { env.args } else if array.length(env.args) == 0 {
            []
        } else {
            fail!("entry ContextConfig does not accept command-line arguments")
        };
        (
            {
                data_srcs,
                ees: models,
                ees_models: main.ees.models,
                ees_vars: main.ees.vars,
                text_srcs: {},
                vars: main.config.envs,
                stdin: 'Lined,
            },
            fn(resources, main) {
                let values = dict.map_values(resources.data, fn(item) { item.data });
                let ctx: entry.Context = {sources: values, env: resources.vars, args};
                let initial: State = {
                    service: main.start(ctx),
                    next_request: 0,
                    requests: [],
                    pending: [],
                    eof: 'False,
                };
                let reduce: Reducer = fn(state, event) {
                    match event {
                        'Initialize => (state, []),
                        'StdinLine('Some(line)) => {
                            let input = json.parse(line) |> result.unwrap;
                            let id = string.join([
                                "request-",
                                fmt.render(fmt.from_int(state.next_request)),
                            ], "");
                            let state: State = {
                                service: state.service,
                                next_request: state.next_request + 1,
                                requests: array.push(state.requests, {id, diagnostics: []}),
                                pending: state.pending,
                                eof: state.eof,
                            };
                            advance(state, id, 'Request({id, input}))
                        },
                        'StdinLine('None) => maybe_exit(
                            {
                                service: state.service,
                                next_request: state.next_request,
                                requests: state.requests,
                                pending: state.pending,
                                eof: 'True,
                            },
                            [],
                        ),
                        'EesReply(reply) => match array.find(state.pending, fn(item) {
                            item.id == reply.key
                        }) {
                            'None => fail!("actor received an unknown EES reply", reply.key),
                            'Some(pending) => {
                                let state: State = {
                                    service: state.service,
                                    next_request: state.next_request,
                                    requests: state.requests,
                                    pending: remove_pending(state.pending, pending.id),
                                    eof: state.eof,
                                };
                                match find_request(state.requests, pending.request_id) {
                                    'None => maybe_exit(state, []),
                                    'Some(_) => advance(
                                        state,
                                        pending.request_id,
                                        'EesReply({
                                            id: pending.id,
                                            request_id: pending.request_id,
                                            result: reply.result,
                                        }),
                                    ),
                                }
                            },
                        },
                        _ => fail!("serve actor received an unsupported event", event),
                    }
                };
                (initial, reduce)
            },
        )
    };

export { State };
