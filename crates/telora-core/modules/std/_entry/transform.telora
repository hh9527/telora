import "std/transform-service" {Context, TransformService, Sources};
import "std/type-property" as property;
import "std/value" {Value};
import "std/_rt" as rt;
import "std/codec" as codec;
import "std/json" as json;

type Reply = struct {
    schema: String,
    ok: Value,
    error: Bool,
    diagnostics: Array(rt.Diagnostic),
};
type Handler = Fn(Value) -> String;
type Plan = (Array(String), Fn(Context) -> Handler);

def prepare: for(S: TransformService) Fn(TypeOf(S)) -> Plan = fn(target) {
    let sources = match property.get_type_prop(target, Sources.type) {
        Some(sources) => sources.names,
        None => [],
    };
    (sources, fn(ctx) {
        let service: S = TransformService(S).init(ctx);
        let observe = rt.with_diagnostics(fn(input: Value) {
            TransformService(S).transform(service, input)
        });
        fn(input: Value) {
            let reply: Reply = match observe(input) {
                Ok((value, diagnostics)) => {
                    schema: "telora.service/v1", ok: value, error: False, diagnostics,
                },
                Err(diagnostics) => {
                    schema: "telora.service/v1", ok: Value.None, error: True, diagnostics,
                },
            };
            let encode = rt.with_diagnostics(fn(value: Reply) {
                json.stringify(codec.encode(Value.type, value))
            });
            match encode(reply) {
                Ok((text, _)) => text,
                Err(errors) => {
                    let failed: Reply = {
                        schema: "telora.service/v1", ok: Value.None, error: True,
                        diagnostics: [...reply.diagnostics, ...errors],
                    };
                    json.stringify(codec.encode(Value.type, failed))
                },
            }
        }
    })
};

export {Handler, Plan, prepare};
