type ParseError = struct {message: String, value: String};

native parse_with: for(A) Fn(TypeOf(A), String) -> Result(A, String);

def parse_target: for(A) Fn(TypeOf(A), String) -> Result(A, ParseError) = fn(target, input) {
    match parse_with(target, input) {
        Ok(value) => Ok(value),
        Err(message) => Err({message, value: input}),
    }
};

trait FromStr {
    from_str: Fn(String) -> Result(Self, ParseError),
};

impl FromStr for String {
    from_str: fn(input) { parse_target(String.type, input) },
};

impl FromStr for Int {
    from_str: fn(input) { parse_target(Int.type, input) },
};

impl FromStr for Float {
    from_str: fn(input) { parse_target(Float.type, input) },
};

impl(T: FromStr) FromStr for Option(T) {
    from_str: fn(input) { parse_target((Option(T)).type, input) },
};

export { FromStr, ParseError, parse_target };
