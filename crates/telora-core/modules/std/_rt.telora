import "std/value" {Value};
import "std/ees" as ees;

type Diagnostic = BlameError;

native call_with_diagnostics:
    for(A, R) Fn(Fn(A) -> R, A)
        -> Result(Tuple([R, Array(BlameError)]), Array(BlameError));

def with_diagnostics:
    for(A, R) Fn(Fn(A) -> R)
        -> Fn(A) -> Result(Tuple([R, Array(BlameError)]), Array(BlameError)) =
    fn(callable) { fn(argument) { call_with_diagnostics(callable, argument) } };

type Platform = struct {
    os: String,
    arch: String,
};

type Env = struct {
    args: Array(String),
    ees: Dict(String),
    mode: EntryMode,
    platform: Platform,
    sources: Dict(DataSrc),
};

type EntryMode = enum {
    'Run,
    'Serve,
};

type DataFormat = enum {
    'Json,
    'Yaml,
    'Toml,
};

type DataSrc = struct {
    default: Option(Value),
    fmt: DataFormat,
    src: String,
};

type TextSrc = struct {
    default: Option(String),
    src: String,
};

type Stdin = enum {
    'Text,
    'Lined,
    'Null,
};

type SystemCaps = struct {
    data_srcs: Dict(DataSrc),
    ees: Dict(String),
    ees_models: Array(ees.Model),
    ees_vars: Dict(String),
    text_srcs: Dict(TextSrc),
    vars: Array(String),
    stdin: Stdin,
};

type SrcItem(T) = struct {
    data: T,
    src: String,
};

type SystemResources = struct {
    data: Dict(SrcItem(Value)),
    texts: Dict(SrcItem(String)),
    vars: Dict(String),
    stdin: Option(String),
};

type EesCall = struct {
    actor: String,
    input: Value,
    key: String,
    operation: String,
};

type EesReply = struct {
    key: String,
    result: Result(Value, String),
};

type SystemEvent = enum {
    'Initialize,
    'EesReply(EesReply),
    'StdinLine(Option(String)),
};

type SystemEffect = enum {
    'EesCall(EesCall),
    'Output(String),
    'Exit(Int),
};

native state_type: for(State) Fn(State) -> TypeOf(State);

export {
    Diagnostic,
    with_diagnostics,
    Platform,
    Env,
    EntryMode,
    DataFormat,
    DataSrc,
    TextSrc,
    Stdin,
    SystemCaps,
    SrcItem,
    SystemResources,
    EesCall,
    EesReply,
    SystemEvent,
    SystemEffect,
    state_type,
};
