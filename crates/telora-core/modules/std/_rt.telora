import "std/value" {Value};

type Diagnostic = BlameError;

native call_with_diagnostics:
    for(A, R) Fn(Fn(A) -> R, A)
        -> Result(Tuple([R, Array(BlameError)]), Array(BlameError));

def with_diagnostics:
    for(A, R) Fn(Fn(A) -> R)
        -> Fn(A) -> Result(Tuple([R, Array(BlameError)]), Array(BlameError)) =
    fn(callable) { fn(argument) { call_with_diagnostics(callable, argument) } };

type OptionAction = struct {
    key: String,
    value: Dyn,
};

type SystemOptions = Array(OptionAction);

type Platform = struct {
    os: String,
    arch: String,
};

type Env = struct {
    args: Array(String),
    ees: Dict(String),
    platform: Platform,
    sources: Dict(DataSrc),
};

type DataFormat = enum {
    'Json,
    'Yaml,
    'Toml,
};

type DataSrc = struct {
    default: Option(Value),
    fmt: DataFormat,
    src: String,
};

type TextSrc = struct {
    default: Option(String),
    src: String,
};

type Stdin = enum {
    'Text,
    'Lined,
    'Null,
};

type SystemCaps = struct {
    data_srcs: Dict(DataSrc),
    ees: Dict(String),
    spawn_child: Bool,
    text_srcs: Dict(TextSrc),
    vars: Array(String),
    stdin: Stdin,
};

type SrcItem(T) = struct {
    data: T,
    src: String,
};

type SystemResources = struct {
    data: Dict(SrcItem(Value)),
    texts: Dict(SrcItem(String)),
    vars: Dict(String),
    stdin: Option(String),
};

type ChildStdin = enum {
    'Piped,
    'Inherit,
    'Null,
};

type Stdout = enum {
    'PipedLine,
    'PipedToEnd,
    'Inherit,
    'Null,
};

type Stdio = struct {
    stdin: ChildStdin,
    stdout: Stdout,
    stderr: Stdout,
};

type ChildOpts = struct {
    bin: String,
    cwd: Option(String),
    envs: Dict(Option(String)),
    clear_env: Bool,
};

type SpawnStdioChild = struct {
    key: String,
    opts: ChildOpts,
    stdio: Stdio,
};

type ChildText = struct {
    key: String,
    data: Option(String),
};

type ChildExited = struct {
    key: String,
    exited: Result(Int, Option(Int)),
};

type ChildSpawnResult = struct {
    key: String,
    result: Result(Int, String),
};

type EesCall = struct {
    actor: String,
    input: Value,
    key: String,
    operation: String,
};

type EesReply = struct {
    key: String,
    result: Result(Value, String),
};

type SystemEvent = enum {
    'Initialize,
    'EesReply(EesReply),
    'StdinLine(Option(String)),
    'ChildStdout(ChildText),
    'ChildStderr(ChildText),
    'ChildSpawnResult(ChildSpawnResult),
    'ChildExited(ChildExited),
};

type SystemEffect = enum {
    'EesCall(EesCall),
    'SpawnStdioChild(SpawnStdioChild),
    'PostStdin(ChildText),
    'Exec(ChildOpts),
    'Output(String),
    'Exit(Int),
};

export {
    Diagnostic,
    with_diagnostics,
    OptionAction,
    SystemOptions,
    Platform,
    Env,
    DataFormat,
    DataSrc,
    TextSrc,
    Stdin,
    SystemCaps,
    SrcItem,
    SystemResources,
    ChildStdin,
    Stdout,
    Stdio,
    ChildOpts,
    SpawnStdioChild,
    ChildText,
    ChildExited,
    ChildSpawnResult,
    EesCall,
    EesReply,
    SystemEvent,
    SystemEffect,
};
