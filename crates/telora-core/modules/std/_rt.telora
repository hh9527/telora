type Severity = enum {Error, Warning, Info};
# Source lines start at 1; line 0 denotes unpartitioned input with absolute byte offsets.
type SourcePoint = struct {line: Int, offset: Int};
type SourceRange = struct {source: String, start: SourcePoint, end: SourcePoint};
type Diagnostic = struct {
    severity: Severity,
    message: String,
    locs: Array(SourceRange),
};

native call_with_diagnostics:
    for(A, R) Fn(Fn(A) -> R, A, TypeOf(Diagnostic), TypeOf(Severity), TypeOf(SourceRange))
        -> Result(Tuple([R, Array(Diagnostic)]), Array(Diagnostic));

def with_diagnostics:
    for(A, R) Fn(Fn(A) -> R)
        -> Fn(A) -> Result(Tuple([R, Array(Diagnostic)]), Array(Diagnostic)) =
    fn(callable) { fn(argument) { call_with_diagnostics(callable, argument, (Diagnostic).type, (Severity).type, (SourceRange).type) } };

native service_reply: Fn(String, Bool, Array(Diagnostic)) -> String;

pub use self::{Severity, SourcePoint, SourceRange, Diagnostic, with_diagnostics, service_reply};
