import "std/value" {Value};
import "std/ees" as ees;

type Severity = enum {Error, Warning, Info};
type SourceRange = struct {source: String, start: Int, end: Int};
type Label = struct {location: SourceRange, message: String, primary: Bool};
type Diagnostic = struct {
    severity: Severity,
    message: String,
    labels: Array(Label),
    notes: Array(String),
};

native call_with_diagnostics:
    for(A, R) Fn(Fn(A) -> R, A, TypeOf(Diagnostic), TypeOf(Severity), TypeOf(Label), TypeOf(SourceRange))
        -> Result(Tuple([R, Array(Diagnostic)]), Array(Diagnostic));

def with_diagnostics:
    for(A, R) Fn(Fn(A) -> R)
        -> Fn(A) -> Result(Tuple([R, Array(Diagnostic)]), Array(Diagnostic)) =
    fn(callable) { fn(argument) { call_with_diagnostics(callable, argument, (Diagnostic).type, (Severity).type, (Label).type, (SourceRange).type) } };

type Platform = struct {
    os: String,
    arch: String,
};

type Env = struct {
    args: Array(String),
    ees: Dict(String),
    mode: EntryMode,
    platform: Platform,
    sources: Dict(DataSrc),
};

type EntryMode = enum {
    Run,
    Serve,
};

type DataFormat = enum {
    Json,
    Yaml,
    Toml,
};

type DataSrc = struct {
    default: Option(Value),
    fmt: DataFormat,
    src: String,
};

type TextSrc = struct {
    default: Option(String),
    src: String,
};

type Stdin = enum {
    Text,
    Lined,
    Null,
};

type SystemCaps = struct {
    data_srcs: Dict(DataSrc),
    ees: Dict(String),
    ees_models: Array(ees.Model),
    ees_vars: Dict(String),
    text_srcs: Dict(TextSrc),
    vars: Array(String),
    stdin: Stdin,
};

type SrcItem(T) = struct {
    data: T,
    src: String,
};

type SystemResources = struct {
    data: Dict(SrcItem(Value)),
    texts: Dict(SrcItem(String)),
    vars: Dict(String),
    stdin: Option(String),
};

type EesCall = struct {
    actor: String,
    input: Value,
    key: String,
    operation: String,
};

type EesReply = struct {
    key: String,
    result: Result(Value, String),
};

type SystemEvent = enum {
    Initialize,
    EesReply(EesReply),
    StdinLine(Option(String)),
};

type SystemEffect = enum {
    EesCall(EesCall),
    Output(String),
    Exit(Int),
};


export {
    Diagnostic,
    Severity,
    SourceRange,
    Label,
    with_diagnostics,
    Platform,
    Env,
    EntryMode,
    DataFormat,
    DataSrc,
    TextSrc,
    Stdin,
    SystemCaps,
    SrcItem,
    SystemResources,
    EesCall,
    EesReply,
    SystemEvent,
    SystemEffect,
};
