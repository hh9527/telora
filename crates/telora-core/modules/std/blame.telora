native type BlameError @0;
use std::string as string;

native message: Fn(BlameError) -> String;
native with_message: Fn(BlameError, String) -> BlameError;

def with_context: Fn(BlameError, String) -> BlameError = fn(error, context) {
    with_message(error, string::join([message(error), context], "; "))
};

pub use self::{BlameError, with_context};
