import "std/value" { Value };

native decode: for(A) Fn(TypeOf(A), Value) -> Result(A, BlameError);
native encode: for(A) Fn(TypeOf(Value), A) -> Result(Value, BlameError);
def format_error: Fn(BlameError) -> String = fn(error) { error.message };
export {
    Value,
    decode,
    encode,
    format_error,
};
