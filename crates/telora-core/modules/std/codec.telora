import "std/_codec" {RenameCase, CodecProp};
import "std/value" {Value};
import "std/blame" {BlameError};
import "std/fmt" { Display };
import "std/string" {DecodeByParse, EncodeByDisplay, FromStr};

native decode_with: for(A) Fn(TypeOf(CodecProp), TypeOf(A), Value) -> Result(A, BlameError);
native encode_with: for(A) Fn(TypeOf(CodecProp), TypeOf(Value), A) -> Value;

trait Encode {
    encode: Fn(Self) -> Value,
};

trait Decode {
    decode: Fn(Value) -> Result(Self, BlameError),
};

impl(A: Property(EncodeByDisplay) + Display) Encode for A {
    encode: fn(value) { encode_with(CodecProp.type, Value.type, value) },
};

impl(A) Encode for A {
    encode: fn(value) { encode_with(CodecProp.type, Value.type, value) },
};

impl(A: Property(DecodeByParse) + FromStr) Decode for A {
    decode: fn(value) { decode_with(CodecProp.type, A.type, value) },
};

impl(A) Decode for A {
    decode: fn(value) { decode_with(CodecProp.type, A.type, value) },
};

def decode: for(A: Decode) Fn(Value) -> Result(A, BlameError) = fn(value) {
    Decode.decode(value)
};
def encode: for(A: Encode) Fn(A) -> Value = fn(value) {
    Encode.encode(value)
};
export {
    Value,
    BlameError,
    RenameCase,
    CodecProp,
    Encode,
    Decode,
    decode,
    encode,
};
