import "std/_codec" {RenameCase, JsonRenameAll, JsonUntagged};
import "std/value" {Value};
import "std/blame" {BlameError};
import "std/fmt" { DisplayBy };

type Properties = struct {
    display_by: Type,
    json_rename_all: Type,
    json_untagged: Type,
};
def properties: Properties = {
    display_by: DisplayBy.type,
    json_rename_all: JsonRenameAll.type,
    json_untagged: JsonUntagged.type,
};
native decode_with: for(A) Fn(Properties, TypeOf(A), Value) -> Result(A, BlameError);
native encode_with: for(A) Fn(Properties, TypeOf(Value), A) -> Value;
def decode: for(A) Fn(TypeOf(A), Value) -> Result(A, BlameError) = fn(target, value) {
    decode_with(properties, target, value)
};
def encode: for(A) Fn(TypeOf(Value), A) -> Value = fn(target, value) {
    encode_with(properties, target, value)
};
export {
    Value,
    BlameError,
    RenameCase,
    JsonRenameAll,
    JsonUntagged,
    Properties,
    properties,
    decode,
    encode,
};
