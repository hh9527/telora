import "std/_codec" {RenameCase, JsonRenameAll, JsonUntagged};
import "std/value" {Value};
import "std/regex" { ParseBy };
import "std/string" { DecodeByParse, EncodeByDisplay };
import "std/fmt" { DisplayBy };

type Properties = struct {
    parse_by: Type,
    decode_by_parse: Type,
    encode_by_display: Type,
    display_by: Type,
    json_rename_all: Type,
    json_untagged: Type,
};
type DecodeError = struct {message: String, value: Value};
def properties: Properties = {
    parse_by: ParseBy,
    decode_by_parse: DecodeByParse,
    encode_by_display: EncodeByDisplay,
    display_by: DisplayBy,
    json_rename_all: JsonRenameAll,
    json_untagged: JsonUntagged,
};
native decode_with: for(A) Fn(Properties, TypeOf(A), Value, TypeOf(DecodeError)) -> Result(A, DecodeError);
native encode_with: for(A) Fn(Properties, TypeOf(Value), A) -> Value;
def decode: for(A) Fn(TypeOf(A), Value) -> Result(A, DecodeError) = fn(target, value) {
    decode_with(properties, target, value, DecodeError)
};
def encode: for(A) Fn(TypeOf(Value), A) -> Value = fn(target, value) {
    encode_with(properties, target, value)
};
export {
    Value,
    DecodeError,
    RenameCase,
    JsonRenameAll,
    JsonUntagged,
    Properties,
    properties,
    decode,
    encode,
};
