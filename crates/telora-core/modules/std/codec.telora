import "std/_codec" {RenameCase, JsonRenameAll, JsonUntagged};
import "std/value" {Value};
import "std/blame" {BlameError};
import "std/fmt" { DisplayBy };

type Properties = struct {
    display_by: Type,
    json_rename_all: Type,
    json_untagged: Type,
};
def properties: Properties = {
    display_by: DisplayBy.type,
    json_rename_all: JsonRenameAll.type,
    json_untagged: JsonUntagged.type,
};
native decode_with: for(A) Fn(Properties, TypeOf(A), Value) -> Result(A, BlameError);
native encode_with: for(A) Fn(Properties, TypeOf(Value), A) -> Value;

trait Encode {
    encode: Fn(Self) -> Value,
};

trait Decode {
    decode: Fn(Value) -> Result(Self, BlameError),
};

impl(A) Encode for A {
    encode: fn(value) { encode_with(properties, Value.type, value) },
};

impl(A) Decode for A {
    decode: fn(value) { decode_with(properties, A.type, value) },
};

def decode_static: for(A: Decode) Fn(Value) -> Result(A, BlameError) = fn(value) {
    Decode.decode(value)
};
def encode_static: for(A: Encode) Fn(A) -> Value = fn(value) {
    Encode.encode(value)
};

def decode: for(A: Decode) Fn(TypeOf(A), Value) -> Result(A, BlameError) = fn(target, value) {
    Decode.decode(value)
};
def encode: for(A: Encode) Fn(TypeOf(Value), A) -> Value = fn(target, value) {
    Encode.encode(value)
};
export {
    Value,
    BlameError,
    RenameCase,
    JsonRenameAll,
    JsonUntagged,
    Properties,
    properties,
    Encode,
    Decode,
    decode,
    encode,
    decode_static,
    encode_static,
};
