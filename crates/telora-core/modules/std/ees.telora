import "std/codec" as codec;
import "std/dict" as dict;
import "std/value" {ScalarValue, Value};

type Request = Tuple([String, String, Value]);

type Model = struct {
    kind: String,
    name: String,
    config: Value,
};

type Config = struct {
    vars: Dict(String),
    models: Array(Model),
};

def request: Fn(String, String, Value) -> Request = fn(actor, operation, input) {
    (actor, operation, input)
};

def model: Fn(String, String, Value) -> Model = fn(kind, name, config) {
    {kind, name, config}
};

def none: Config = {vars: {}, models: []};

def sqlite_model: Fn(String, String) -> Model = fn(name, path) {
    model("sqlite-query", name, Value.Object({path: Value.String(path)}))
};

def sqlite_query: Fn(String, String, Array(ScalarValue)) -> Request = fn(actor, sql, bindings) {
    request(
        actor,
        "Query",
        codec.encode(codec.Value.type, {sql, bindings}),
    )
};

def imos_model: Fn(String, String, String) -> Model = fn(name, store, home) {
    model(
        "imos",
        name,
        Value.Object({store: Value.String(store), home: Value.String(home)}),
    )
};

def install_shared: Fn(String, Value) -> Request = fn(actor, plan) {
    request(
        actor,
        "InstallShared",
        Value.Object(dict.map_values({plan}, fn(value) { value })),
    )
};

export {
    Request,
    Model,
    Config,
    request,
    model,
    none,
    sqlite_model,
    sqlite_query,
    imos_model,
    install_shared,
};
