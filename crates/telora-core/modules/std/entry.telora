import "std/_rt" as rt;
import "std/actor" as actor;
import "std/ees" as ees;
import "std/value" {Value};

type ContextConfig = struct {
    sources: Array(String),
    envs: Array(String),
    args: Bool,
};

type Context = struct {
    sources: Dict(Value),
    env: Dict(String),
    args: Array(String),
};

type Eval = struct {
    config: ContextConfig,
    evaluate: Fn(Context) -> Value,
};

type Run(State) = struct {
    config: ContextConfig,
    ees: ees.Config,
    start: Fn(Context) -> actor.Service,
};

type Serve(State) = struct {
    config: ContextConfig,
    ees: ees.Config,
    start: Fn(Context) -> actor.Service,
};

def main: Fn(ContextConfig, Fn(Context) -> Value) -> Eval = fn(config, evaluate) {
    {config, evaluate}
};

def run: for(State)
    Fn(
        ContextConfig,
        ees.Config,
        Fn(Context) -> Tuple([
            State,
            Fn(State, actor.Event) -> actor.Transition(State),
        ]),
    ) -> Run(State) =
    fn(config, ees_config, prepare) {
        {
            config,
            ees: ees_config,
            start: fn(ctx) {
                let prepared = prepare(ctx);
                actor.service(rt.state_type(prepared.0), prepared.0, prepared.1)
            },
        }
    };

def serve: for(State)
    Fn(
        ContextConfig,
        ees.Config,
        Fn(Context) -> Tuple([
            State,
            Fn(State, actor.Event) -> actor.Transition(State),
        ]),
    ) -> Serve(State) =
    fn(config, ees_config, prepare) {
        {
            config,
            ees: ees_config,
            start: fn(ctx) {
                let prepared = prepare(ctx);
                actor.service(rt.state_type(prepared.0), prepared.0, prepared.1)
            },
        }
    };

export {
    ContextConfig,
    Context,
    Eval,
    Run,
    Serve,
    main,
    run,
    serve,
};
