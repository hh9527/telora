import "std/_rt" as rt;
import "std/actor" as actor;
import "std/array" as array;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/json" as json;
import "std/value" {Value};

export type MainType = struct {
    config: entry.ContextConfig,
    ees: entry.Ees,
    start: Fn(entry.Context) -> actor.Service,
};

type Pending = struct { id: String, request_id: String };
type State = struct {
    service: actor.Service,
    pending: Array(Pending),
    completed: Bool,
};
type Collected = struct {
    pending: Array(Pending),
    effects: Array(rt.SystemEffect),
    reply: Option(actor.Reply),
};
type Transition = Tuple([State, Array(rt.SystemEffect)]);
type Reducer = Fn(State, rt.SystemEvent) -> Transition;
type Initializer = Fn(rt.SystemResources, MainType) -> Tuple([State, Reducer]);

def configure_sources: Fn(Array(String), Dict(rt.DataSrc)) -> Dict(rt.DataSrc) =
    fn(declared, sources) {
        let provided = dict.keys(sources);
        let unique = array.all(declared, fn(name) {
            array.length(array.filter(declared, fn(other) { other == name })) == 1
        });
        if unique == 'False {
            fail!("entry ContextConfig.sources must contain unique names")
        } else if array.all(declared, fn(name) {
            array.any(provided, fn(other) { other == name })
        }) == 'False {
            fail!("a source declared by entry ContextConfig was not provided", declared, provided)
        } else if array.all(provided, fn(name) {
            array.any(declared, fn(other) { other == name })
        }) == 'False {
            fail!("an undeclared source was provided", declared, provided)
        } else {
            sources
        }
    };

def declared_ees: Fn(Array(entry.EesModel)) -> Dict(String) = fn(models) {
    let pairs = array.map(models, fn(model) { (model.name, model.kind) });
    let unique = array.all(pairs, fn(declaration) {
        declaration.0 != "" && array.length(array.filter(pairs, fn(other) {
            other.0 == declaration.0
        })) == 1
    });
    if unique == 'False {
        fail!("EES model declarations must contain unique non-empty names")
    } else {
        dict.from_pairs(pairs)
    }
};

def remove_pending: Fn(Array(Pending), String) -> Array(Pending) = fn(pending, id) {
    array.filter(pending, fn(item) { item.id != id })
};

def advance: Fn(State, actor.Event) -> Transition = fn(state, event) {
    let transition = state.service.reduce((state.service.state, event));
    let service: actor.Service = {state: transition.0, reduce: state.service.reduce};
    let initial: Collected = {pending: state.pending, effects: [], reply: 'None};
    let collected = array.fold(transition.1, initial, fn(found, effect) {
        match effect {
            'EesCall(call) => {
                if call.request_id != "run" {
                    fail!("run actor emitted EesCall for an unknown request", call.request_id)
                } else if array.any(found.pending, fn(item) { item.id == call.id }) {
                    fail!("run actor reused an active EES call id", call.id)
                } else {
                    {
                        pending: array.push(found.pending, {
                            id: call.id,
                            request_id: call.request_id,
                        }),
                        effects: array.push(found.effects, 'EesCall({
                            actor: call.request.0,
                            input: call.request.2,
                            key: call.id,
                            operation: call.request.1,
                        })),
                        reply: found.reply,
                    }
                }
            },
            'Reply(reply) => if reply.request_id != "run" {
                fail!("run actor replied to an unknown request", reply.request_id)
            } else match found.reply {
                'Some(_) => fail!("run actor replied more than once"),
                'None => {
                    pending: found.pending,
                    effects: found.effects,
                    reply: 'Some(reply),
                },
            },
        }
    });
    match collected.reply {
        'Some(reply) => if array.length(collected.pending) != 0 ||
            array.length(collected.effects) != 0 {
            fail!("run actor replied while EES calls were still active")
        } else {
            (
                {service, pending: [], completed: 'True},
                ['Output(json.stringify(reply.value)), 'Exit(0)],
            )
        },
        'None => (
            {service, pending: collected.pending, completed: 'False},
            collected.effects,
        ),
    }
};

export def config:
    Fn(rt.Env, MainType) -> Tuple([rt.SystemCaps, Initializer]) =
    fn(env, main) {
        let data_srcs = configure_sources(main.config.sources, env.sources);
        let models = declared_ees(main.ees.models);
        let args = if main.config.args { env.args } else if array.length(env.args) == 0 {
            []
        } else {
            fail!("entry ContextConfig does not accept command-line arguments")
        };
        (
            {
                data_srcs,
                ees: models,
                ees_models: main.ees.models,
                ees_vars: main.ees.vars,
                text_srcs: {},
                vars: main.config.envs,
                stdin: 'Null,
            },
            fn(resources, main) {
                let values = dict.map_values(resources.data, fn(item) { item.data });
                let ctx: entry.Context = {sources: values, env: resources.vars, args};
                let state: State = {
                    service: main.start(ctx),
                    pending: [],
                    completed: 'False,
                };
                let reduce: Reducer = fn(state, event) {
                    if state.completed {
                        fail!("run actor received an event after completion", event)
                    } else match event {
                        'Initialize => advance(state, 'Request({id: "run", input: 'None})),
                        'EesReply(reply) => match array.find(state.pending, fn(item) {
                            item.id == reply.key
                        }) {
                            'None => fail!("run actor received an unknown EES reply", reply.key),
                            'Some(pending) => advance(
                                {
                                    service: state.service,
                                    pending: remove_pending(state.pending, pending.id),
                                    completed: 'False,
                                },
                                'EesReply({
                                    id: pending.id,
                                    request_id: pending.request_id,
                                    result: reply.result,
                                }),
                            ),
                        },
                        _ => fail!("run actor received an unsupported event", event),
                    }
                };
                (state, reduce)
            },
        )
    };

export { State };
