import "std/_rt" as rt;
import "std/array" as array;
import "std/dict" as dict;
import "std/dyn" as dyn;
import "std/ees" as ees;
import "std/fmt" as fmt;
import "std/json" as json;
import "std/string" as string;
import "std/value" {Value};

export type MainType = struct {
    main: Fn(Dict(Value)) -> ees.Task,
};

type Waiting = struct {
    key: String,
    then: Fn(Result(Value, String)) -> ees.Task,
};

type State = struct {
    next_key: Int,
    waiting: Option(Waiting),
    completed: Bool,
};

type Transition = Tuple([State, Array(rt.SystemEffect)]);
type Reducer = Fn(State, rt.SystemEvent) -> Transition;
type Initializer = Fn(rt.SystemResources, MainType) -> Tuple([State, Reducer]);

def declared_sources: Fn(rt.SystemOptions) -> Array(String) = fn(options) {
    let declarations = array.filter(options, fn(action) {
        action.key == "run-ctx.sources"
    });
    if array.length(declarations) > 1 {
        fail!("option run-ctx.sources may be declared only once")
    } else match array.get(declarations, 0) {
        'None => [],
        'Some(action) => match dyn.project_with(Array(String), action.value) {
            'Some(names) => names,
            'None => fail!("option run-ctx.sources must be Array(String)"),
        },
    }
};

def configure_sources: Fn(rt.SystemOptions, Dict(rt.DataSrc)) -> Dict(rt.DataSrc) =
    fn(options, sources) {
        let declared = declared_sources(options);
        let provided = dict.keys(sources);
        let unique = array.all(declared, fn(name) {
            array.length(array.filter(declared, fn(other) { other == name })) == 1
        });
        if unique == 'False {
            fail!("option run-ctx.sources must contain unique names")
        } else if array.all(declared, fn(name) {
            array.any(provided, fn(other) { other == name })
        }) == 'False {
            fail!("a source declared by run-ctx.sources was not provided", declared, provided)
        } else if array.all(provided, fn(name) {
            array.any(declared, fn(other) { other == name })
        }) == 'False {
            fail!("an undeclared source was provided", declared, provided)
        } else {
            sources
        }
    };

def declared_ees: Fn(rt.SystemOptions, Dict(String)) -> Dict(String) = fn(options, provided) {
    let actions = array.filter(options, fn(action) { action.key == "run-ctx.ees" });
    if array.length(actions) != 1 {
        fail!("option run-ctx.ees must be declared exactly once")
    } else match array.get(actions, 0) {
        'None => fail!("option run-ctx.ees must be declared exactly once"),
        'Some(action) => match dyn.array_items(action.value) {
            'Err(_) => fail!("option run-ctx.ees must be an Array of actor declarations"),
            'Ok(declarations) => {
                let pairs = array.map(declarations, fn(declaration) {
                    let name = match dyn.field(declaration, "name") {
                        'Ok(value) => match dyn.check_string(value) {
                            'Some(found) => found,
                            'None => fail!("run-ctx.ees actor name must be String"),
                        },
                        'Err(_) => fail!("run-ctx.ees actor declaration must contain name"),
                    };
                    let kind = match dyn.field(declaration, "kind") {
                        'Ok(value) => match dyn.check_string(value) {
                            'Some(found) => found,
                            'None => fail!("run-ctx.ees actor kind must be String"),
                        },
                        'Err(_) => fail!("run-ctx.ees actor declaration must contain kind"),
                    };
                    (name, kind)
                });
                let unique = array.all(pairs, fn(declaration) {
                    declaration.0 != "" && declaration.1 != "" &&
                        array.length(array.filter(pairs, fn(other) {
                            other.0 == declaration.0
                        })) == 1
                });
                if unique == 'False {
                    fail!("option run-ctx.ees must contain unique non-empty names and kinds")
                } else if array.length(pairs) != array.length(dict.keys(provided)) ||
                    array.all(pairs, fn(declaration) {
                        match dict.get(provided, declaration.0) {
                            'Some(kind) => kind == declaration.1,
                            'None => 'False,
                        }
                    }) == 'False {
                    fail!("run-ctx.ees declarations do not match Host actor bindings")
                } else {
                    provided
                }
            },
        },
    }
};

def advance: Fn(State, ees.Task) -> Transition = fn(state, task) {
    match task {
        'Done(value) => (
            {next_key: state.next_key, waiting: 'None, completed: 'True},
            ['Output(json.stringify(value)), 'Exit(0)],
        ),
        'Call(pending) => {
            let key = string.join(["ees", fmt.render(fmt.from_int(state.next_key))], "-");
            (
                {
                    next_key: state.next_key + 1,
                    waiting: 'Some({key, then: pending.1}),
                    completed: 'False,
                },
                ['EesCall({
                    key,
                    actor: pending.0.0,
                    operation: pending.0.1,
                    input: pending.0.2,
                })],
            )
        },
    }
};

export def config:
    Fn(rt.SystemOptions, rt.Env) -> Tuple([rt.SystemCaps, Initializer]) =
    fn(options, env) {
        let data_srcs = configure_sources(options, env.sources);
        let actors = declared_ees(options, env.ees);
        (
            {
                data_srcs,
                ees: actors,
                spawn_child: 'False,
                text_srcs: {},
                vars: [],
                stdin: 'Null,
            },
            fn(resources, main) {
                let values = dict.map_values(resources.data, fn(item) { item.data });
                let initial: State = {next_key: 0, waiting: 'None, completed: 'False};
                let task = main.main(values);
                let reduce: Reducer = fn(state, event) {
                    if state.completed {
                        fail!("EES run Entry received an event after completion", event)
                    } else match event {
                        'Initialize => advance(state, task),
                        'EesReply(reply) => match state.waiting {
                            'Some(waiting) => if waiting.key == reply.key {
                                advance(
                                    {next_key: state.next_key, waiting: 'None, completed: 'False},
                                    waiting.then(reply.result),
                                )
                            } else {
                                fail!("EES reply key does not match the active task", reply.key)
                            },
                            'None => fail!("EES run Entry received a reply without an active task"),
                        },
                        _ => fail!("EES run Entry received an unsupported event", event),
                    }
                };
                (initial, reduce)
            },
        )
    };

export { State };
