import "std/_rt" as rt;
import "std/array" as array;
import "std/dict" as dict;
import "std/dyn" as dyn;
import "std/ees" as ees;
import "std/fmt" as fmt;
import "std/json" as json;
import "std/result" as result;
import "std/string" as string;
import "std/value" {Value};

export type MainType = struct {
    serve: Fn(Dict(Value)) -> Fn(Value) -> ees.Task,
};

type Pending = struct {
    key: String,
    then: Fn(Result(Value, String)) -> ees.Task,
    diagnostics: Array(Value),
};

type State = struct {
    handler: Fn(Value) -> ees.Task,
    next_key: Int,
    pending: Array(Pending),
    eof: Bool,
};

type Transition = Tuple([State, Array(rt.SystemEffect)]);
type Reducer = Fn(State, rt.SystemEvent) -> Transition;
type Initializer = Fn(rt.SystemResources, MainType) -> Tuple([State, Reducer]);

def declared_sources: Fn(rt.SystemOptions) -> Array(String) = fn(options) {
    let declarations = array.filter(options, fn(action) {
        action.key == "run-ctx.sources"
    });
    if array.length(declarations) > 1 {
        fail!("option run-ctx.sources may be declared only once")
    } else match array.get(declarations, 0) {
        'None => [],
        'Some(action) => match dyn.project_with(Array(String), action.value) {
            'Some(names) => names,
            'None => fail!("option run-ctx.sources must be Array(String)"),
        },
    }
};

def configure_sources: Fn(rt.SystemOptions, Dict(rt.DataSrc)) -> Dict(rt.DataSrc) =
    fn(options, sources) {
        let declared = declared_sources(options);
        let provided = dict.keys(sources);
        let unique = array.all(declared, fn(name) {
            array.length(array.filter(declared, fn(other) { other == name })) == 1
        });
        if unique == 'False {
            fail!("option run-ctx.sources must contain unique names")
        } else if array.all(declared, fn(name) {
            array.any(provided, fn(other) { other == name })
        }) == 'False {
            fail!("a source declared by run-ctx.sources was not provided", declared, provided)
        } else if array.all(provided, fn(name) {
            array.any(declared, fn(other) { other == name })
        }) == 'False {
            fail!("an undeclared source was provided", declared, provided)
        } else {
            sources
        }
    };

def declared_ees: Fn(rt.SystemOptions, Dict(String)) -> Dict(String) = fn(options, provided) {
    let actions = array.filter(options, fn(action) {
        action.key == "ees.imos" || action.key == "ees.sqlite"
    });
    let pairs = array.map(actions, fn(action) {
        let name = match dyn.field(action.value, "name") {
            'Ok(value) => match dyn.check_string(value) {
                'Some(found) => found,
                'None => fail!("EES actor name must be String"),
            },
            'Err(_) => fail!("EES actor declaration must contain name"),
        };
        let kind = if action.key == "ees.imos" { "imos" } else { "sqlite-query" };
        (name, kind)
    });
    let unique = array.all(pairs, fn(declaration) {
        declaration.0 != "" && array.length(array.filter(pairs, fn(other) {
            other.0 == declaration.0
        })) == 1
    });
    if unique == 'False {
        fail!("EES actor declarations must contain unique non-empty names")
    } else if array.length(pairs) != array.length(dict.keys(provided)) ||
        array.all(pairs, fn(declaration) {
            match dict.get(provided, declaration.0) {
                'Some(kind) => kind == declaration.1,
                'None => 'False,
            }
        }) == 'False {
        fail!("EES actor declarations do not match Host actor bindings")
    } else {
        provided
    }
};

def without: Fn(Array(Pending), String) -> Array(Pending) = fn(pending, key) {
    array.filter(pending, fn(item) { item.key != key })
};

def success_response: Fn(Value, Array(Value)) -> String = fn(value, diagnostics) {
    let response = json.stringify('Object({
        ok: value,
        error: 'False,
        diagnostics: 'Array(diagnostics),
    }));
    string.join([response, ""], "\n")
};

def failure_response: Fn(Array(Value)) -> String = fn(diagnostics) {
    let response = json.stringify('Object({
        ok: 'None,
        error: 'True,
        diagnostics: 'Array(diagnostics),
    }));
    string.join([response, ""], "\n")
};

def diagnostic_value: Fn(String) -> Value = fn(message) {
    'Object({message: 'String(message)})
};

def finish_failure: Fn(State, Array(Value)) -> Transition = fn(state, diagnostics) {
    let effects: Array(rt.SystemEffect) = ['Output(failure_response(diagnostics))];
    if state.eof && array.length(state.pending) == 0 {
        (state, array.push(effects, 'Exit(0)))
    } else {
        (state, effects)
    }
};

def advance: Fn(State, ees.Task, Array(Value)) -> Transition = fn(state, task, diagnostics) {
    match task {
        'Done(value) => {
            let effects: Array(rt.SystemEffect) = ['Output(success_response(value, diagnostics))];
            if state.eof && array.length(state.pending) == 0 {
                (state, array.push(effects, 'Exit(0)))
            } else {
                (state, effects)
            }
        },
        'Call(waiting) => {
            let key = string.join(["ees", fmt.render(fmt.from_int(state.next_key))], "-");
            (
                {
                    handler: state.handler,
                    next_key: state.next_key + 1,
                    pending: array.push(state.pending, {key, then: waiting.1, diagnostics}),
                    eof: state.eof,
                },
                ['EesCall({
                    key,
                    actor: waiting.0.0,
                    operation: waiting.0.1,
                    input: waiting.0.2,
                })],
            )
        },
    }
};

export def config:
    Fn(rt.SystemOptions, rt.Env) -> Tuple([rt.SystemCaps, Initializer]) =
    fn(options, env) {
        let data_srcs = configure_sources(options, env.sources);
        let actors = declared_ees(options, env.ees);
        (
            {
                data_srcs,
                ees: actors,
                spawn_child: 'False,
                text_srcs: {},
                vars: [],
                stdin: 'Lined,
            },
            fn(resources, main) {
                let values = dict.map_values(resources.data, fn(item) { item.data });
                let initial: State = {
                    handler: main.serve(values),
                    next_key: 0,
                    pending: [],
                    eof: 'False,
                };
                let reduce: Reducer = fn(state, event) {
                    match event {
                        'Initialize => (state, []),
                        'StdinLine('Some(line)) => {
                            let request = json.parse(line) |> result.unwrap;
                            match rt.with_diagnostics(state.handler)(request) {
                                'Ok(observed) => {
                                    let diagnostics = array.map(observed.1, fn(diagnostic) {
                                        diagnostic_value(diagnostic.message)
                                    });
                                    advance(state, observed.0, diagnostics)
                                },
                                'Err(found) => {
                                    let diagnostics = array.map(found, fn(diagnostic) {
                                        diagnostic_value(diagnostic.message)
                                    });
                                    (state, ['Output(failure_response(diagnostics))])
                                },
                            }
                        },
                        'StdinLine('None) => {
                            let ended: State = {
                                handler: state.handler,
                                next_key: state.next_key,
                                pending: state.pending,
                                eof: 'True,
                            };
                            if array.length(state.pending) == 0 {
                                (ended, ['Exit(0)])
                            } else {
                                (ended, [])
                            }
                        },
                        'EesReply(reply) => match array.find(state.pending, fn(item) {
                            item.key == reply.key
                        }) {
                            'None => fail!("EES serve Entry received a reply with an unknown key", reply.key),
                            'Some(waiting) => {
                                let remaining = without(state.pending, reply.key);
                                let resumed: State = {
                                    handler: state.handler,
                                    next_key: state.next_key,
                                    pending: remaining,
                                    eof: state.eof,
                                };
                                match rt.with_diagnostics(waiting.then)(reply.result) {
                                    'Ok(observed) => {
                                        let found = array.map(observed.1, fn(diagnostic) {
                                            diagnostic_value(diagnostic.message)
                                        });
                                        advance(
                                            resumed,
                                            observed.0,
                                            array.concat([waiting.diagnostics, found]),
                                        )
                                    },
                                    'Err(found) => {
                                        let diagnostics = array.map(found, fn(diagnostic) {
                                            diagnostic_value(diagnostic.message)
                                        });
                                        finish_failure(
                                            resumed,
                                            array.concat([waiting.diagnostics, diagnostics]),
                                        )
                                    },
                                }
                            },
                        },
                        _ => fail!("EES serve Entry received an unsupported event", event),
                    }
                };
                (initial, reduce)
            },
        )
    };

export { State };
