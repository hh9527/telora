import "std/ees" as ees;
import "std/dict" as dict;
import "std/entry" as entry;
import "std/value" {Value};

def install_shared: Fn(String, Value) -> ees.Request = fn(actor, plan) {
    ees.request(
        actor,
        "InstallShared",
        'Object(dict.map_values({plan}, fn(value) { value })),
    )
};

def model: Fn(String, String, String) -> entry.EesModel = fn(name, store, home) {
    entry.model(
        "imos",
        name,
        'Object({store: 'String(store), home: 'String(home)}),
    )
};

export { install_shared, model };
