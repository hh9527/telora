use std::value::{ Value };
use std::codec as codec;
use std::codec::{ BlameError, RenameCase, CodecProp };
use std::_codec::{rename_all, untagged};

native parse_raw: Fn(TypeOf(Value), String) -> Result(Value, BlameError);
native stringify: Fn(Value) -> String;
native stringify_pretty: Fn(Int) -> Fn(Value) -> String;
def decode: for(A: codec::Decode) Fn(String) -> Result(A, BlameError) = fn(text) {
    match parse(text) {
        Ok(value) => codec::decode@[A](value),
        Err(error) => Err(error),
    }
};
def parse: Fn(String) -> Result(Value, BlameError) = fn(text) {
    parse_raw(Value.type, text)
};
pub use self::{
    parse,
    BlameError,
    decode,
    stringify,
    stringify_pretty,
    RenameCase,
    CodecProp,
    rename_all,
    untagged,
};
