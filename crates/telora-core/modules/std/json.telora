import "std/value" { Value };
import "std/codec" as codec;
import "std/codec" { BlameError, RenameCase, JsonRenameAll as RenameAll, JsonUntagged as Untagged };
import "std/_codec" {rename_all, untagged};

native parse_raw: Fn(TypeOf(Value), String) -> Result(Value, BlameError);
native stringify: Fn(Value) -> String;
native stringify_pretty: Fn(Int) -> Fn(Value) -> String;
def decode: for(A) Fn(TypeOf(A), String) -> Result(A, BlameError) = fn(target, text) {
    match parse(text) {
        Ok(value) => codec.decode(target, value),
        Err(error) => Err(error),
    }
};
def parse: Fn(String) -> Result(Value, BlameError) = fn(text) {
    parse_raw(Value.type, text)
};
export {
    parse,
    BlameError,
    decode,
    stringify,
    stringify_pretty,
    RenameAll,
    RenameCase,
    Untagged,
    rename_all,
    untagged,
};
