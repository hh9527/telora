import "std/value" { Value };
import "std/codec" as codec;
import "std/codec" { DecodeError, RenameCase, JsonRenameAll as RenameAll, JsonUntagged as Untagged };
import "std/_codec" {rename_all, untagged};

native parse_raw: Fn(TypeOf(Value), String, TypeOf(DecodeError)) -> Result(Value, DecodeError);
native stringify: Fn(Value) -> String;
native stringify_pretty: Fn(Int) -> Fn(Value) -> String;
native schema_with: Fn(codec.Properties, Type, TypeOf(Value)) -> Value;
def decode: for(A) Fn(TypeOf(A), String) -> Result(A, DecodeError) = fn(target, text) {
    match parse(text) {
        Ok(value) => codec.decode(target, value),
        Err(error) => Err(error),
    }
};
def schema: Fn(Type) -> Value = fn(target) {
    schema_with(codec.properties, target, Value)
};
def parse: Fn(String) -> Result(Value, DecodeError) = fn(text) {
    parse_raw(Value, text, DecodeError)
};
export {
    parse,
    DecodeError,
    decode,
    stringify,
    stringify_pretty,
    RenameAll,
    RenameCase,
    Untagged,
    rename_all,
    untagged,
    schema,
};
