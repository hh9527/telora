type Platform = struct {
    os: String,
    arch: String,
};
type ExecSettings = struct {
    platform: Platform,
    download_prefix: String,
    install_prefix: String,
};
type ExecRequest = struct {
    args: Array(String),
    env: Dict(String),
    cwd: String,
};
type UnpackType = enum {
    'TarGzip,
    'Tar,
};
type UnpackOpt = struct {
    file: String,
    dest: String,
    ty: UnpackType,
    src: String,
    strip: Int,
    digest: Option(String),
};
type ExecEnvironment = struct {
    clear: Bool,
    update: Dict(Option(String)),
};
type Install = enum {
    'Unpack(UnpackOpt),
};
type ExecEnv = struct {
    install: Array(Install),
    cwd: Option(String),
    bin: String,
    args: Array(String),
    env: ExecEnvironment,
};
type ExecFn = Fn(ExecSettings, ExecRequest) -> ExecEnv;
export {
    Platform,
    ExecSettings,
    ExecRequest,
    UnpackType,
    UnpackOpt,
    Install,
    ExecEnvironment,
    ExecEnv,
    ExecFn,
};
