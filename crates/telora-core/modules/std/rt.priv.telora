type OptionAction = struct {
    key: String,
    value: Dyn,
};

type SystemOptions = Array(OptionAction);

type Platform = struct {
    os: String,
    arch: String,
};

type Env = struct {
    args: Array(String),
    input: Bool,
    platform: Platform,
};

type SystemCaps = struct {
    input: Bool,
};

type SystemInjection = struct {
    input: Option(Dyn),
};

type Stdin = enum {
    'Piped,
    'Inherit,
    'Null,
};

type Stdout = enum {
    'PipedLine,
    'PipedToEnd,
    'Inherit,
    'Null,
};

type Stdio = struct {
    stdin: Stdin,
    stdout: Stdout,
    stderr: Stdout,
};

type ChildOpts = struct {
    bin: String,
    cwd: Option(String),
    envs: Dict(Option(String)),
    clear_env: Bool,
};

type SpawnStdioChild = struct {
    key: String,
    opts: ChildOpts,
    stdio: Stdio,
};

type ChildText = struct {
    key: String,
    data: Option(String),
};

type ChildExited = struct {
    key: String,
    exited: Result(Int, Option(Int)),
};

type ChildSpawnResult = struct {
    key: String,
    result: Result(Int, String),
};

type SystemEvent = enum {
    'Initialize,
    'ChildStdout(ChildText),
    'ChildStderr(ChildText),
    'ChildSpawnResult(ChildSpawnResult),
    'ChildExited(ChildExited),
};

type SystemEffect = enum {
    'SpawnStdioChild(SpawnStdioChild),
    'PostStdin(ChildText),
    'Exec(ChildOpts),
    'Output(String),
    'Exit(Int),
};

export {
    OptionAction,
    SystemOptions,
    Platform,
    Env,
    SystemCaps,
    SystemInjection,
    Stdin,
    Stdout,
    Stdio,
    ChildOpts,
    SpawnStdioChild,
    ChildText,
    ChildExited,
    ChildSpawnResult,
    SystemEvent,
    SystemEffect,
};
