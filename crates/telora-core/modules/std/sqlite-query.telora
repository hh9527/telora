import "std/ees" as ees;
import "std/entry" as entry;
import "std/value" {Value};

def query: Fn(String, String, Array(Value)) -> ees.Request = fn(actor, sql, bindings) {
    ees.request(
        actor,
        "Query",
        'Object({sql: 'String(sql), bindings: 'Array(bindings)}),
    )
};

def model: Fn(String, String) -> entry.EesModel = fn(name, path) {
    entry.model("sqlite-query", name, 'Object({path: 'String(path)}))
};

export { query, model };
