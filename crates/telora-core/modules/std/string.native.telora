native length: Fn(String) -> Int;
native join: Fn(Array(String), String) -> String;
native join_lines: Fn(Array(String)) -> String;
native split: Fn(String, String) -> Array(String);
native lines: Fn(String) -> Array(String);
native starts_with: Fn(String, String) -> Bool;
native ends_with: Fn(String, String) -> Bool;
native contains: Fn(String, String) -> Bool;
native replace: Fn(String, String, String) -> String;
native indent: Fn(String, Int) -> String;
native ensure_trailing_newline: Fn(String) -> String;
native trim_margin: Fn(String, String) -> String;
import "std/regex" { ParseBy };
import "std/type-desc" { TypeDesc };

@property('Type)
type DecodeByParse = struct {};

@property('Type)
type EncodeByDisplay = struct {};

native parse_with: for(A) Fn(Type, TypeOf(A), String) -> Result(A, BlameError);
def parse: for(A) Fn(TypeOf(A), String) -> Result(A, BlameError) = fn(target, input) {
    parse_with(ParseBy, target, input)
};
def decode_by_parse: Fn(TypeDesc, Option(DecodeByParse)) -> DecodeByParse = fn(target, previous) {
    let property: DecodeByParse = {};
    property
};
def encode_by_display: Fn(TypeDesc, Option(EncodeByDisplay)) -> EncodeByDisplay = fn(target, previous) {
    let property: EncodeByDisplay = {};
    property
};

export { length, join, join_lines, split, lines, starts_with, ends_with, contains, replace, indent, ensure_trailing_newline, trim_margin, parse, DecodeByParse, EncodeByDisplay, decode_by_parse, encode_by_display };
