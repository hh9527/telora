import "std/value" {Value};
import "std/array" as array;
import "std/dict" as dict;

type Context = struct {sources: Dict(Value)};

trait TransformService {
    init: Fn(Context) -> Self,
    transform: Fn(Self, Value) -> Value,
};

@property(PropertyTarget.Type)
type Sources = struct {names: Array(String)};

def source: Fn(String) -> Fn(Type, Option(Sources)) -> Sources = fn(name) {
    fn(target, previous) {
        let names = match previous {
            Some(previous) => previous.names,
            None => [],
        };
        if name == "" {
            fail!("service source name must not be empty", name)
        } else if array.any(names, fn(existing) { existing == name }) {
            fail!("duplicate service source declaration", name)
        } else {
            let sorted = dict.keys(dict.from_pairs(array.map(array.push(names, name), fn(key) { (key, ()) })));
            {names: sorted}.ty!(Sources)
        }
    }
};

export {Context, TransformService, Sources, source};
