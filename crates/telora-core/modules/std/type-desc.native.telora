type TypeDescKind = enum {
    'Any, 'Never, 'Type, 'TypeOf,
    'Int, 'Float, 'String, 'Bytes,
    'Atom, 'Array, 'Dict, 'Tagged,
    'Tuple, 'Struct, 'Enum, 'Union,
    'Func, 'Opaque, 'WithAttributes, 'Bound, 'Dyn, 'Ref,
};
native kind: Fn(Type) -> TypeDescKind;
native children: Fn(Type) -> Array(Type);
native opaque_name: Fn(Type) -> Option(String);
native resolve: Fn(Type) -> Result(Type, BlameError);
export {
    Type as TypeDesc,
    TypeDescKind,
    kind,
    children,
    opaque_name,
    resolve,
};
