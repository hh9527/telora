type TypeDescKind = enum {
    Never, Type, TypeOf,
    Int, Float, String, Bytes,
    Array, Dict,
    Tuple, Struct, Newtype, Enum,
    Func, Opaque, Bound, Dyn, Ref,
};
type FieldDesc = struct { index: Int, name: String, ty: Type };
type VariantDesc = struct { index: Int, name: String, payload: Option(Type) };
native kind: Fn(Type) -> TypeDescKind;
native children: Fn(Type) -> Array(Type);
native fields: Fn(Type) -> Array(FieldDesc);
native variants: Fn(Type) -> Array(VariantDesc);
native opaque_name: Fn(Type) -> Option(String);
type ResolveError = struct {message: String, value: Type};
native resolve_raw: Fn(Type) -> Result(Type, String);
def resolve: Fn(Type) -> Result(Type, ResolveError) = fn(value) {
    match resolve_raw(value) {
        Ok(target) => Ok(target),
        Err(message) => Err({message, value}),
    }
};

export {
    Type as TypeDesc,
    TypeDescKind,
    ResolveError,
    FieldDesc,
    VariantDesc,
    kind,
    children,
    fields,
    variants,
    opaque_name,
    resolve,
};
