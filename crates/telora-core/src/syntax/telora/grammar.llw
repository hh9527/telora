token Let='let' Decl='decl' Def='def' Native='native' Option='option' For='for' Type='type' Fn='fn' FunctionType='Fn' Interpreter='interpreter' If='if' Else='else' Match='match' Return='return';
token Import='import' Export='export' As='as';
token SectionLParen='\\(' LParen='(' RParen=')' LBrace='{' RBrace='}' LBracket='[' RBracket=']';
token Comma=',' Colon=':' Semicolon=';' Ellipsis='...' Dot='.' At='@' Bang='!' Question='?';
token Plus='+' Minus='-' Star='*' Slash='/' Percent='%' Less='<' LessEqual='<=' Greater='>' GreaterEqual='>=' EqualEqual='==' BangEqual='!=' Equal='=';
token BitAnd='&' BitOr='|' BitXor='^' AndAnd='&&' OrOr='||';
token Arrow='->' FatArrow='=>' Pipe='|>';
token Int='<integer>' Float='<float>' Bytes='<bytes>';
token DoubleQuote='"' Backtick='`' RawString='<raw string>' StringText='<string text>' EscapeSequence='<escape>';
token UnknownEscapeSequence='<unknown escape>' UnterminatedEscapeSequence='<unterminated escape>';
token InterpolationStart='<interpolation start>';
token Atom='<atom>' Placeholder='_' IndexedPlaceholder='<indexed placeholder>' Identifier='<identifier>';
token StructInitializer='<struct initializer>' EnumInitializer='<enum initializer>';
token Whitespace Comment;

skip Whitespace Comment;
start program;

program: body;
body: (?1 binding)* [expression];
binding^: ?6 option_binding | ?5 export_statement | ?4 let_else_binding | ?3 let_pattern_binding | let_binding | decl_binding | def_binding | ?1 native_type_binding | ?2 native_binding | type_binding | import_binding;
option_binding: 'option' string_literal expression ';';
export_statement: 'export' (let_binding | def_binding | type_binding | export_items ';');
export_items: '{' export_item (?1 ',' export_item)* [','] '}';
export_item: Identifier ['as' Identifier];
let_binding: 'let' Identifier [':' expression] '=' expression ';';
let_pattern_binding: 'let' pattern '=' expression ';';
let_else_binding: 'let' pattern '=' expression 'else' block ';';
decl_binding: 'decl' Identifier ':' type_scheme ';';
def_binding: 'def' Identifier [':' type_scheme] '=' expression ';';
native_binding: 'native' Identifier ':' type_scheme ';';
native_type_binding: 'native' 'type' Identifier '@' Int ';';
type_scheme: ['for' type_parameters] contract;
type_parameters: '(' Identifier (?1 ',' Identifier)* [','] ')';
type_binding: decorator* 'type' Identifier [type_parameters] '=' type_initializer ';';
type_initializer^: struct_initializer | enum_initializer | expression;
struct_initializer: StructInitializer '{' [struct_initializer_field (?1 ',' struct_initializer_field)* [',']] '}';
struct_initializer_field: decorator* Identifier ':' expression;
enum_initializer: EnumInitializer '{' [enum_initializer_variant (?1 ',' enum_initializer_variant)* [',']] '}';
enum_initializer_variant: decorator* Atom ['(' expression ')'];
import_binding: 'import' string_literal import_selector ';';
import_selector: 'as' Identifier [',' ('*' | import_items)] | '*' | import_items;
import_items: '{' import_item (?1 ',' import_item)* [','] '}';
import_item: Identifier ['as' Identifier];

expression:
  expression Question @propagate_expr
| expression arguments @call_expr
| expression '@' type_arguments @type_apply_expr
| expression '[' expression ']' @index_expr
| expression section_arguments @section_expr
| expression '.' dot_suffix @dot_postfix_expr
| ('-' | '!') expression @unary_expr
| expression ('*' | '/' | '%') expression @binary_expr
| expression ('+' | '-') expression @binary_expr
| expression '&' expression @binary_expr
| expression '^' expression @binary_expr
| expression '|' expression @binary_expr
| expression ('<' | '<=' | '>' | '>=' | '==' | '!=') expression @binary_expr
| expression '&&' expression @binary_expr
| expression '||' expression @binary_expr
| expression '|>' expression @pipeline_expr
| primary ^
;

primary:
  Int @int_expr
| Float @float_expr
| string_literal @string_expr
| concat_expression @string_expr
| Bytes @bytes_expr
| Atom @atom_expr
| ?4 named_intrinsic
| Identifier @variable_expr
| ?5 interpreter_intrinsic
| ?6 if_let_expr
| legacy_interpreter_expr
| '(' [expression (?1 ',' expression)* [',']] ')' @paren_expr
| '[' [array_item (?2 ',' array_item)* [',']] ']' @array_expr
| braced
| ?3 function_contract
| ?t closure
| if_expr
| match_expr
| return_expr
;

braced:
  ?1 '{' [dict_item (?2 ',' dict_item)* [',']] '}' @dict_expr
| ?t block
;
dict_field: ?1 Identifier | decorator* (Identifier | string_literal) ':' expression;
dict_item^: spread_item | dict_field;
decorator: '@' decorator_path [arguments];
decorator_path: Identifier ('.' Identifier)*;
block: '{' body '}';
closure: 'fn' parameters ['->' expression] block;
interpreter_intrinsic: 'interpreter' '!' '(' [expression (?1 ',' expression)* [',']] ')';
named_intrinsic: Identifier '!' '(' [expression (?1 ',' expression)* [',']] ')';
dot_suffix^: ?1 postfix_intrinsic_suffix | projection_suffix;
postfix_intrinsic_suffix: Identifier '!' arguments;
projection_suffix: Identifier | Int;
legacy_interpreter_expr: 'interpreter' '(' expression ')';
function_contract: 'Fn' '(' [contract (?1 ',' contract)* [',']] ')' '->' contract;
contract: contract_path [?1 '(' [contract_argument (?2 ',' contract_argument)* [',']] ')'] @contract_expr | function_contract;
contract_path: Identifier (?1 '.' Identifier)*;
contract_argument^: contract | contract_array;
contract_array: '[' [contract (?1 ',' contract)* [',']] ']';
parameters: '(' [parameter (?1 ',' parameter)* [',']] ')';
parameter: Identifier [':' expression];
arguments: '(' [expression (?1 ',' expression)* [',']] ')';
type_arguments: '[' type_argument (?1 ',' type_argument)* [','] ']';
type_argument: expression | Placeholder;
section_arguments: '\\(' [argument (?1 ',' argument)* [',']] ')';
argument: expression | Placeholder | IndexedPlaceholder;
array_item^: spread_item | expression;
spread_item: '...' expression @spread_expr;
ctrl_block^: block | ?1 if_let_expr | if_expr | match_expr | return_expr;
if_expr: 'if' expression block 'else' ctrl_block;
if_let_expr: 'if' 'let' pattern '=' expression block 'else' ctrl_block;
match_expr: 'match' expression '{' match_arm (?1 ',' match_arm)* [','] '}';
return_expr: 'return' expression Semicolon @return_expr;
match_arm: pattern ['if' expression] '=>' expression;
pattern:
  (Identifier | Placeholder) @identifier_pattern
| Int @int_pattern
| Float @float_pattern
| string_literal @string_pattern
| ?2 Atom '(' pattern ')' @tagged_pattern
| ?t Atom @atom_pattern
| '(' [pattern (?1 ',' pattern)* [',']] ')' @tuple_pattern
| '{' [struct_pattern_field (?3 ',' struct_pattern_field)* [',']] '}' @struct_pattern
;
struct_pattern_field: Identifier [':' pattern];
string_literal: DoubleQuote string_text_part* DoubleQuote | RawString;
concat_expression: Backtick string_part* Backtick;
string_text_part^:
  StringText
| EscapeSequence
| UnknownEscapeSequence
| UnterminatedEscapeSequence
;
string_part^:
  StringText
| EscapeSequence
| UnknownEscapeSequence
| UnterminatedEscapeSequence
| interpolation
;
interpolation: InterpolationStart expression RBrace;
