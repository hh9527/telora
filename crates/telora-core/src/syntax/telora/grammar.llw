token Let='let' Decl='decl' Def='def' Do='do' Native='native' For='for' Type='type' Trait='trait' Impl='impl' Fn='fn' FunctionType='Fn' Interpreter='interpreter' If='if' Else='else' Match='match' Return='return';
token Import='import' Export='export' As='as';
token SectionLParen='\\(' LParen='(' RParen=')' LBrace='{' RBrace='}' LBracket='[' RBracket=']';
token Comma=',' Colon=':' Semicolon=';' Ellipsis='...' Dot='.' At='@' Bang='!' Question='?';
token Plus='+' Minus='-' Star='*' Slash='/' Percent='%' Less='<' LessEqual='<=' Greater='>' GreaterEqual='>=' EqualEqual='==' BangEqual='!=' Equal='=';
token BitAnd='&' BitOr='|' BitXor='^' AndAnd='&&' OrOr='||';
token Arrow='->' FatArrow='=>' Pipe='|>' StructUpdate='<~';
token Int='<integer>' Float='<float>' Bytes='<bytes>';
token DoubleQuote='"' Backtick='`' RawString='<raw string>' StringText='<string text>' EscapeSequence='<escape>';
token UnknownEscapeSequence='<unknown escape>' UnterminatedEscapeSequence='<unterminated escape>';
token InterpolationStart='<interpolation start>';
token Placeholder='_' IndexedPlaceholder='<indexed placeholder>' Identifier='<identifier>';
token StructInitializer='<struct initializer>' EnumInitializer='<enum initializer>';
token Whitespace Comment;

skip Whitespace Comment;
start program;

program: module_body;
module_body: (?1 binding)* [expression];
// Open one Body per sequence tail, then close in reverse to preserve scopes.
body^: #1 #2 (?1 binding)* [expression #4 (?2 ';' #2 (?1 binding)* [expression #4])*] #3;
binding^: ?5 export_statement | let_binding | decl_binding | def_binding | ?1 native_type_binding | ?2 native_binding | type_binding | trait_binding | impl_binding | import_binding;
export_statement: 'export' (let_binding | def_binding | type_binding | trait_binding | export_items ';' | member_selector ';');
export_items: '{' export_item (?1 ',' export_item)* [','] '}';
export_item: Identifier ['as' Identifier];
let_binding: 'let' (?1 Identifier [':' expression] | pattern @let_pattern_binding)
  '=' expression ['else' block @let_else_binding] ';';
decl_binding: 'decl' Identifier ':' type_scheme ';';
def_binding: 'def' Identifier [':' type_scheme] '=' expression ';';
native_binding: 'native' Identifier ':' type_scheme ';';
native_type_binding: 'native' 'type' Identifier '@' Int ';';
type_scheme: ['for' type_parameters] contract;
type_parameters: '(' type_parameter (?1 ',' type_parameter)* [','] ')';
type_parameter: Identifier [':' trait_bound ('+' trait_bound)*];
trait_bound: contract;
type_binding: decorator* 'type' Identifier [type_parameters] '=' type_initializer ';';
type_initializer^: struct_initializer | enum_initializer | expression;
struct_initializer: StructInitializer ('{' [struct_initializer_field (?1 ',' struct_initializer_field)* [',']] '}' | '(' expression ')');
struct_initializer_field: decorator* Identifier ':' expression;
enum_initializer: EnumInitializer '{' [enum_initializer_variant (?1 ',' enum_initializer_variant)* [',']] '}';
enum_initializer_variant: decorator* Identifier ['(' expression ')'];
trait_binding: 'trait' Identifier '{' [trait_member (?1 ',' trait_member)* [',']] '}' ';';
trait_member: Identifier ':' contract;
impl_binding: 'impl' [?2 type_parameters] contract 'for' contract '{' [impl_member (?1 ',' impl_member)* [',']] '}' ';';
impl_member: Identifier ':' expression;
import_binding: 'import' (string_literal import_selector | member_selector) ';';
member_selector: Identifier (?1 '.' Identifier)* '.' import_items;
import_selector: 'as' Identifier [',' ('*' | import_items)] | '*' | import_items;
import_items: '{' import_item (?1 ',' import_item)* [','] '}';
import_item: Identifier ['as' Identifier];

expression:
  expression ('*' | '/' | '%') expression @binary_expr
| expression ('+' | '-') expression @binary_expr
| expression '&' expression @binary_expr
| expression '^' expression @binary_expr
| expression '|' expression @binary_expr
| expression '<~' expression @binary_expr
| expression ('<' | '<=' | '>' | '>=' | '==' | '!=') expression @binary_expr
| expression '&&' expression @binary_expr
| expression '||' expression @binary_expr
| expression '|>' expression @pipeline_expr
| unary_expr ^
| postfix_expr ^
;

// Prefix chains are collected iteratively; callbacks close their CST nodes
// from right to left after the postfix operand has been parsed.
unary_expr^: #1 (#2 ('-' | '!'))+ postfix_expr #3;
postfix_expr:
  postfix_expr Question @propagate_expr
| postfix_expr arguments @call_expr
| postfix_expr '@' type_arguments @type_apply_expr
| postfix_expr '[' expression ']' @index_expr
| postfix_expr section_arguments @section_expr
| postfix_expr '.' dot_suffix @dot_postfix_expr
| primary ^
;

primary:
  Int @int_expr
| Float @float_expr
| string_literal @string_expr
| concat_expression @string_expr
| Bytes @bytes_expr
| ?4 named_intrinsic
| Identifier @variable_expr
| ?5 interpreter_intrinsic
| ?6 if_let_expr
| ?7 do_expr
| legacy_interpreter_expr
| '(' [array_item (?1 ',' array_item)* [',']] ')' @paren_expr
| '[' [array_item (?2 ',' array_item)* [',']] ']' @array_expr
| braced
| ?3 function_contract
| ?t closure
| if_expr
| match_expr
| return_expr
;

braced:
  ?1 '{' [dict_item (?2 ',' dict_item)* [',']] '}' @dict_expr
| ?t block
;
dict_field: ?1 Identifier | decorator* (Identifier | string_literal) ':' expression;
dict_item^: spread_item | dict_field;
decorator: '@' decorator_path [arguments];
decorator_path: Identifier ('.' Identifier)*;
block: '{' body '}';
do_expr: 'do' block;
closure: #1 'fn' parameters ['->' #2 expression #3] block;
interpreter_intrinsic: 'interpreter' '!' '(' [expression (?1 ',' expression)* [',']] ')';
named_intrinsic: Identifier '!' '(' [expression (?1 ',' expression)* [',']] ')';
dot_suffix^: ?1 postfix_intrinsic_suffix | field_projection_suffix | projection_suffix | metadata_suffix;
metadata_suffix: 'type';
field_projection_suffix: '{' [field_projection_entry (?1 ',' field_projection_entry)* [',']] '}';
field_projection_entry: Identifier ['as' Identifier];
postfix_intrinsic_suffix: Identifier '!' arguments;
projection_suffix: Identifier | Int;
legacy_interpreter_expr: 'interpreter' '(' expression ')';
// Each subsequent head opens the same Contract -> FunctionContract wrappers
// as the former recursive return contract. Parameters still use contract.
function_contract^: #1 #2 function_contract_head (?1 #3 #2 function_contract_head)* contract #4;
function_contract_head^: 'Fn' '(' [contract (?1 ',' contract)* [',']] ')' '->';
contract: contract_path [?1 '(' [contract_argument (?2 ',' contract_argument)* [',']] ')'] @contract_expr | function_contract | unit_contract;
unit_contract: '(' [contract (?1 ',' contract)* [',']] ')';
contract_path: Identifier (?1 '.' Identifier)*;
contract_argument^: contract | contract_array;
contract_array: '[' [contract (?1 ',' contract)* [',']] ']';
parameters: '(' [parameter (?1 ',' parameter)* [',']] ')';
parameter: Identifier [':' expression];
arguments: '(' [expression (?1 ',' expression)* [',']] ')';
type_arguments: '[' type_argument (?1 ',' type_argument)* [','] ']';
type_argument: expression | Placeholder;
section_arguments: '\\(' [argument (?1 ',' argument)* [',']] ')';
argument: expression | Placeholder | IndexedPlaceholder;
array_item^: spread_item | expression;
spread_item: '...' expression @spread_expr;
ctrl_block^: block | match_expr | return_expr;
// The callback selects IfExpr / IfLetExpr for each head and closes rightward
// branches in reverse. Conditions and branch blocks keep their own frames.
if_expr^: #1 #2 if_head (?1 #2 if_head)* ctrl_block #3;
if_let_expr^: if_expr;
if_head^: 'if' ['let' pattern '='] #1 expression #2 block 'else';
match_expr: #1 'match' #2 expression #3 '{' match_arm (?1 ',' match_arm)* [','] '}';
return_expr: #1 'return' #2 expression #3 Semicolon @return_expr;
match_arm: pattern ['if' expression] '=>' expression;
pattern:
  ?4 constructor_pattern ^
| (Identifier | Placeholder) @identifier_pattern
| Int @int_pattern
| Float @float_pattern
| string_literal @string_pattern
| '(' [pattern (?1 ',' pattern)* [',']] ')' @tuple_pattern
| '{' [struct_pattern_field (?3 ',' struct_pattern_field)* [',']] '}' @struct_pattern
;
constructor_pattern: Identifier ('.' Identifier)* ['(' pattern ')'];
struct_pattern_field: Identifier [':' pattern];
string_literal: DoubleQuote string_text_part* DoubleQuote | RawString;
concat_expression: Backtick string_part* Backtick;
string_text_part^:
  StringText
| EscapeSequence
| UnknownEscapeSequence
| UnterminatedEscapeSequence
;
string_part^:
  StringText
| EscapeSequence
| UnknownEscapeSequence
| UnterminatedEscapeSequence
| interpolation
;
interpolation: InterpolationStart expression RBrace;
