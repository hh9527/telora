token LBrace='{' RBrace='}' LBracket='[' RBracket=']' Comma=',' Equals='=' Dot='.';
token String='<string>' Atom='<atom>' Newline Whitespace Comment;

skip Whitespace Comment;
start document;

document: (Newline | statement Newline)*;
statement^: '[' table_tail | key_value;
table_tail: '[' key ']' ']' | key ']';
key_value: key '=' value;
key: key_part ('.' key_part)*;
key_part: String | Atom;
value^: String | Atom | array | inline_table;
array: '[' [value [array_tail]] ']';
array_tail: ',' [value [array_tail]];
inline_table: '{' [key_value (',' key_value)*] '}';
