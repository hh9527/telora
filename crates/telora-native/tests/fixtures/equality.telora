import "std/eq" as eq;
import "std/codec" {encode, Value};
import "std/entry" as entry;
import "std/dyn" as dynamic;
import "std/hash" as hash;
import "std/regex" as regex;
import "std/fmt" as fmt;
type Node = struct {value: Int, children: Array(Node)};
type Count = struct(Int);
type Choice = enum {Empty, Item(Node)};
type Box(T) = struct {value: T, label: String};
type LabelPatch = struct {label: String};
def replace: for(T) Fn(Box(T), T) -> Box(T) = fn(base, value) { base <~ {value: value} };
@check(fn(value) { if value.number > 0 { Ok(()) } else { Err(blame!("positive required", value.number)) } })
type Positive = struct {number: Int};
def first: Node = {value: 1, children: [{value: 2, children: []}]};
def second: Node = {value: 1, children: [{value: 2, children: []}]};
def dictionary: Dict(Int) = {a: 1, b: 2};
def reversed: Dict(Int) = {b: 2, a: 1};
def packed = dynamic.pack(Int.type, 1);
def empty_factory = fn() { fn(n: Int) { n + 1 } };
def captured_factory = fn(base: Int) { fn(n: Int) { n + base } };
def empty = empty_factory();
def captured = captured_factory(1);
def pattern = regex.compile("a+");
def formatted = fmt.concat(["before", "after"], [fmt.from_int(42)]);
def state = hash.update_string(hash.new(), "prefix");
def error = blame!("same message");
def option_text: Fn(Option(Int)) -> Option(String) = fn(value) { let number = value?; Some("success") };
def result_text: Fn(Result(Int, String)) -> Result(String, String) = fn(value) { let number = value?; Ok("success") };
def nested: Fn(Option(Int)) -> Option(Int) = fn(value) {
    let inside: Fn() -> Option(Int) = fn() { let number = value?; Some(number + 1) };
    let ignored = inside();
    Some(42)
};
def always_ok: Fn(Result(Int, Never)) -> Result(Int, Never) = fn(value) { let number = value?; Ok(number + 1) };
def always_none: Fn(Option(Never)) -> Option(String) = fn(value) { let impossible = value?; Some("unreachable") };
def checks: Fn() -> Value = fn() {
    let base: Box(Int) = {value: 1, label: "before"};
    let patch: LabelPatch = {label: "after"};
    let updated = replace(base, 42) <~ patch <~ {};
    let positive: Positive = {number: 1};
    encode(Value.type, [
        option_text(Some(1)) == Some("success"), option_text(None) == None,
        result_text(Ok(1)) == Ok("success"), result_text(Err("failure")) == Err("failure"),
        nested(None) == Some(42),
        always_ok(Ok(41)) == Ok(42), always_none(None) == None,
        updated.value == 42, updated.label == "after", base.value == 1, base.label == "before",
        (positive <~ {number: 2}).number == 2,
        (first <~ {children: []}).children == [],
        eq.equal(first, second), first == second,
        first != {value: 1, children: []},
        dictionary == reversed,
        dictionary != {a: 1, b: 3},
        eq.equal((), ()), eq.equal((1, "text"), (1, "text")),
        Choice.Item(first) == Choice.Item(second),
        Choice.Item(first) != Choice.Empty,
        Count(1) == Count(1), Count(1) != Count(2),
        eq.equal(Int.type, Int.type),
        eq.equal(0.0, -0.0),
        eq.equal([1, 2], [1, 2]), [1, 2] != [1, 3],
        eq.equal(packed, packed), !eq.equal(packed, dynamic.pack(Int.type, 1)),
        eq.equal(empty, empty), !eq.equal(empty, empty_factory()),
        eq.equal(captured, captured), !eq.equal(captured, captured_factory(1)),
        eq.equal(empty_factory, empty_factory),
        eq.equal(hash.sha256, hash.sha256),
        eq.equal(pattern, regex.compile("a+")), !eq.equal(pattern, regex.compile("aa*")),
        eq.equal(formatted, fmt.concat(["before", "after"], [fmt.from_int(42)])),
        !eq.equal(formatted, fmt.from_string("before42after")),
        !eq.equal(fmt.from_int(1), fmt.from_string("1")),
        !eq.equal(fmt.from_float(0.0), fmt.from_float(-0.0)),
        eq.equal(state, hash.update_string(hash.new(), "prefix")),
        !eq.equal(state, hash.update_string(hash.new(), "different")),
        eq.equal(hash.update_int(state, -42), hash.update_int(state, -42)),
        !eq.equal(hash.update_int(state, -42), hash.update_int(state, 42)),
        eq.equal(error, error), !eq.equal(error, blame!("same message")),
    ])
};
export def answer = checks();
export def main = entry.main({sources: [], envs: [], args: False}, fn(ctx) { checks() });
