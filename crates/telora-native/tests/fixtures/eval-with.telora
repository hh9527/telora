import "std/entry" as entry;
import "std/codec" {encode, decode, Value};
import "std/dict" as dict;
import "./base.json" as base;

@check(fn(value) {
    if value > 0 { Ok(()) } else { Err(blame!("positive input required", value)) }
})
type Count = struct(Int);

export def answer = entry.main(
    { sources: ["input"], envs: ["TELORA_NATIVE_TEST_ENV"], args: True },
    fn(ctx) { encode(Value.type, (ctx, base.data)) },
);

export def selected = entry.main(
    { sources: ["input"], envs: [], args: False },
    fn(ctx) {
        match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        }
    },
);

export def decoded = entry.main(
    { sources: ["input"], envs: [], args: False },
    fn(ctx) {
        let input = match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        };
        match decode(Dict(Count).type, input) {
            Ok(value) => encode(Value.type, value),
            Err(error) => raise!(error),
        }
    },
);
