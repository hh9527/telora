import "std/entry" as entry;
import "std/codec" {encode, decode, Value};
import "std/dict" as dict;
import "./base.json" as base;
import "std/codec" {JsonRenameAll, JsonUntagged, RenameCase};
import "std/string" as string;
import "std/regex" as regex;
import "std/fmt" as fmt;
import "std/yaml" as yaml;
import "std/toml" as toml;
import "std/json" as json;

export def schema = entry.main(
    {sources: [], envs: [], args: False},
    fn(ctx) { json.schema(Endpoint.type) },
);

export def formats = entry.main(
    {sources: [], envs: [], args: False},
    fn(ctx) {
        Value.Array([
            match yaml.parse("answer: 42\n") {Ok(value) => value, Err(error) => raise!(error)},
            match toml.parse("answer = 43\n") {Ok(value) => value, Err(error) => raise!(error)},
            match json.parse("{\"answer\":44}") {Ok(value) => value, Err(error) => raise!(error)},
        ])
    },
);

@string.decode_by_parse @string.encode_by_display
@fmt.display_by("{host}:{port}")
@regex.parse_by(regex.compile(r"^(?P<host>[^:]+):(?P<port>\d+)$"))
type Endpoint = struct {host: String, port: Int};

export def text_decoded = entry.main(
    {sources: ["input"], envs: [], args: False},
    fn(ctx) {
        let input = match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        };
        match decode(Endpoint.type, input) {
            Ok(value) => encode(Value.type, value),
            Err(error) => raise!(error),
        }
    },
);

def camel_case: Fn(Type, Option(JsonRenameAll)) -> JsonRenameAll = fn(owner, previous) {
    {case: RenameCase.CamelCase}
};
def without_tag: Fn(Type, Option(JsonUntagged)) -> JsonUntagged = fn(owner, previous) { {} };

@check(fn(value) {
    if value > 0 { Ok(()) } else { Err(blame!("positive input required", value)) }
})
type Count = struct(Int);

@camel_case
type External = struct {answer_value: Count};
@without_tag
type ExternalChoice = enum {Data(External)};

export def property_decoded = entry.main(
    {sources: ["input"], envs: [], args: False},
    fn(ctx) {
        let input = match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        };
        match decode(ExternalChoice.type, input) {
            Ok(value) => encode(Value.type, value),
            Err(error) => raise!(error),
        }
    },
);

export def answer = entry.main(
    { sources: ["input"], envs: ["TELORA_NATIVE_TEST_ENV"], args: True },
    fn(ctx) { encode(Value.type, (ctx, base.data)) },
);

export def selected = entry.main(
    { sources: ["input"], envs: [], args: False },
    fn(ctx) {
        match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        }
    },
);

export def decoded = entry.main(
    { sources: ["input"], envs: [], args: False },
    fn(ctx) {
        let input = match dict.get(ctx.sources, "input") {
            Some(value) => value,
            None => fail!("declared input is absent"),
        };
        match decode(Dict(Count).type, input) {
            Ok(value) => encode(Value.type, value),
            Err(error) => raise!(error),
        }
    },
);
