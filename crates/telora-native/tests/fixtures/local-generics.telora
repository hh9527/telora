import "std/codec" {encode, Value};
import "std/entry" as entry;
def make: Fn(Int) -> Fn() -> Int = fn(offset) {
    def add: for(T) Fn(T) -> Int = fn(value) {offset};
    fn() {add(0) + add@[String]("ignored")}
};
def shared = make(21);
def checks: Fn() -> Value = fn() {
    let offset = 2;
    def sum: Fn(Int) -> Int = fn(n) {if n == 0 {offset} else {n + sum(n - 1)}};
    encode(Value.type, [shared() == 42, make(20)() == 40, sum(8) == 38])
};
export def answer = checks();
export def main = entry.main({sources: [], envs: [], args: False}, fn(ctx) {checks()});
