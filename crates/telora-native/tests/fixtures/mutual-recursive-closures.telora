import "std/value" as value;
import "std/codec" as codec;
import "std/entry" as entry;
def functions = do {
    let offset = 42;
    def even: Fn(Int) -> Int = fn(n) {
        if n == 0 { offset } else { odd(n - 1) }
    };
    def odd: Fn(Int) -> Int = fn(n) {
        if n == 0 { 0 } else { even(n - 1) }
    };
    (even, odd)
};
export def answer = codec.encode(value.Value.type, functions.0(4));
export def main = entry.main(
    {sources: [], envs: [], args: False},
    fn(ctx) {codec.encode(value.Value.type, functions.0(4))},
);
