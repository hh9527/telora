use std::transform_service as service;
use std::value::{Value};
use std::regex as regex;
type MainService = struct {pattern: regex::Regex};
impl service::TransformService for MainService {
    init: fn(ctx) { {pattern: regex::compile("(")}.ty!(Self) },
    transform: fn(self, input) { input },
};
pub use self::{MainService};
