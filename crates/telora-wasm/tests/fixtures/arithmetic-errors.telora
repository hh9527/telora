def minimum: Int = -9223372036854775807 - 1;
export def add: Int = 9223372036854775807 + 1;
export def subtract: Int = minimum - 1;
export def multiply: Int = 4611686018427387904 * 4;
export def multiply_min: Int = -1 * minimum;
export def divide_min: Int = minimum / -1;
export def negate: Int = -minimum;
export def divide_zero: Int = 42 / 0;
export def remainder_zero: Int = 42 % 0;
export def remainder_min: Int = minimum % -1;
