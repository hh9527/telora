def minimum: Int = -9223372036854775807 - 1;
pub def add: Int = 9223372036854775807 + 1;
pub def subtract: Int = minimum - 1;
pub def multiply: Int = 4611686018427387904 * 4;
pub def multiply_min: Int = -1 * minimum;
pub def divide_min: Int = minimum / -1;
pub def negate: Int = -minimum;
pub def divide_zero: Int = 42 / 0;
pub def remainder_zero: Int = 42 % 0;
pub def remainder_min: Int = minimum % -1;
