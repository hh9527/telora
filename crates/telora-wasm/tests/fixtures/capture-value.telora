use std::_rt as rt;
use std::array as array;
use std::value::{Value};

def captured: Result((Int, Array(rt::Diagnostic)), Array(rt::Diagnostic)) = rt::with_diagnostics(fn(n: Int) -> Int {
    let warning: Option(Int) = warn!("before failure");
    fail!("captured failure", n)
})(42);

pub def answer: Value = match captured {
    Err(reports) => Value::Array(array::map(reports, fn(report) {
        Value::Object({
            message: Value::String(report.message),
            locs: Value::Array(array::map(report.locs, fn(loc) {
                Value::Object({
                    source: Value::String(loc.source),
                    start: Value::Object({line: Value::Int(loc.start.line), offset: Value::Int(loc.start.offset)}),
                    end: Value::Object({line: Value::Int(loc.end.line), offset: Value::Int(loc.end.offset)}),
                })
            })),
        })
    })),
    Ok(_) => Value::None,
};
