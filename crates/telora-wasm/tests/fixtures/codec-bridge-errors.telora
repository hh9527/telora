import "std/codec" as codec;
import "std/string" as string;
import "std/value" { Value };
import "std/_rt" as rt;
@string.decode_by_parse
type DecodeOnly = struct { value: Int };
@string.encode_by_display
type EncodeOnly = struct { value: Int };
export def answer = fn() {
    let decode: DecodeOnly = {value: 1};
    let encode: EncodeOnly = {value: 2};
    (match rt.with_diagnostics(fn(value: DecodeOnly) { codec.encode(Value.type,value) })(decode) { Err(reports) => reports[0], Ok(_) => fail!("expected missing encode marker") },
     match rt.with_diagnostics(fn(value: EncodeOnly) { codec.encode(Value.type,value) })(encode) { Err(reports) => reports[0], Ok(_) => fail!("expected missing decode marker") })
};
