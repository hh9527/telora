import "std/codec" as codec;
import "std/value" { Value };
import "std/_rt" as rt;
export def answer = fn() {
    let input = Value.String("wrong type");
    match rt.with_diagnostics(fn(value: Value) {
        match codec.decode(Int.type,value) {Ok(value) => value,Err(error) => raise!(error)}
    })(input) {Err(reports) => reports[0],Ok(_) => fail!("expected mismatch")}
};
