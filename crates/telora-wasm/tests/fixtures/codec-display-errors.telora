use std::codec as codec;
use std::string as string;
use std::fmt::{ DisplayBy };
use std::value::{ Value };
use std::_rt as rt;
def broken_display: Fn(Type, Option(DisplayBy)) -> DisplayBy = fn(owner, previous) {
    {template: {strings: [""],fields: []},display: fn(value) {fail!("display execution failed")}}
};
@string::decode_by_parse
@string::encode_by_display
@broken_display
type Broken = struct { value: Int };
impl string::FromStr for Broken {
    from_str: fn(input) { Ok({value: 0}) },
};
pub def answer: Fn() -> Array(rt::Diagnostic) = fn() {
    let broken: Broken = {value: 2};
    match rt::with_diagnostics(fn(value: Broken) {codec::encode(value)})(broken) {
        Err(reports) => reports,
        Ok(_) => fail!("expected display failure"),
    }
};
