use std::codec as codec;
use std::json as json;
use std::value::{ Value };
use std::_rt as rt;
@json::rename_all(json::RenameCase::CamelCase)
type Choice = enum { A_b, AB };
pub def answer: Fn() -> rt::Diagnostic = fn() {
    match rt::with_diagnostics(fn(value: Choice) { codec::encode(value) })(Choice::A_b) {
        Err(reports) => reports[0], Ok(_) => fail!("expected collision"),
    }
};
