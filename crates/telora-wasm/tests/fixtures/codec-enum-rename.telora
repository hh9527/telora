import "std/codec" as codec;
import "std/json" as json;
import "std/value" { Value };
@json.rename_all(json.RenameCase.CamelCase)
type Choice = enum { No_value, Has_value(Int) };
export def inspect = fn() { (codec.encode(Value.type, Choice.No_value),codec.encode(Value.type, Choice.Has_value(42))) };
export def answer = codec.encode(Value.type, inspect());
