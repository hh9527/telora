import "std/codec" as codec;
import "std/json" as json;
import "std/value" { Value };
import "std/_rt" as rt;
@json.untagged
type Ambiguous = enum { First, Second };
@json.untagged
@json.rename_all(json.RenameCase.CamelCase)
type Both = enum { Empty, Number(Int) };
export def answer = fn() {
    let ambiguous = rt.with_diagnostics(fn(value: Ambiguous) { codec.encode(Value.type,value) })(Ambiguous.First);
    let both = rt.with_diagnostics(fn(value: Both) { codec.encode(Value.type,value) })(Both.Empty);
    (match ambiguous { Err(reports) => reports[0], Ok(_) => fail!("expected ambiguity") },
     match both { Err(reports) => reports[0], Ok(_) => fail!("expected incompatible properties") })
};
