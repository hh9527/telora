use std::toml as toml;
use std::yaml as yaml;
use std::_rt as rt;
pub def toml_rejected: Fn() -> rt::Diagnostic = fn() {
    let input = "duplicate=1\nduplicate=2\n";
    match rt::with_diagnostics(fn(text:String) {unwrap!(toml::parse(text))})(input) {
        Err(reports) => reports[0],
        Ok(_) => fail!("expected TOML rejection"),
    }
};
pub def yaml_rejected: Fn() -> rt::Diagnostic = fn() {
    let input = "duplicate: 1\nduplicate: 2\n";
    match rt::with_diagnostics(fn(text:String) {unwrap!(yaml::parse(text))})(input) {
        Err(reports) => reports[0],
        Ok(_) => fail!("expected YAML rejection"),
    }
};
