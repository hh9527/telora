import "std/codec" {encode, Value};
import "std/dyn" as dyn;
def seed: Int = dbg!(41, "initialize");
type Row = struct {name: String, value: Int};
def original: Row = {name: "é🦀", value: 42};
def callback: Fn(Int) -> Int = fn(n) { n + 1 };
export def answer: Fn() -> Value = fn() {
    let number = dbg!(seed + 1);
    let record = dbg!(original);
    let function = dbg!(callback);
    let dict: Dict(Int) = {b: 2, a: 1};
    let other = dbg!((True, (), b"ab", [1, 2], dict, Some(3), -0.0, dyn.pack(Int.type, number)));
    encode(Value.type, [number == 42, record == original, function == callback])
};
export def evaluated: Value = answer();
