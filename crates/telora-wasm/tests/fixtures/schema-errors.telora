import "std/json" as json;
import "std/string" as string;
import "std/value" {Value};
import "std/array" as array;
import "std/_rt" as rt;
@string.decode_by_parse
type Broken = struct(Int);
@json.rename_all(json.RenameCase.CamelCase)
type Collision = struct {foo_bar:Int,fooBar:Int};
@json.untagged
type Units = enum {First,Second};
export def answer = do {
    let types:Array(Type)=[Bytes.type,Dyn.type,Broken.type,Collision.type,Units.type];
    Value.Array(array.map(types,fn(target:Type) {
        match rt.with_diagnostics(json.schema)(target) {
            Err(reports) => Value.String(reports[0].message),
            Ok(_) => Value.String("unexpected success"),
        }
    }))
};
