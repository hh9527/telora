import "std/json" as json;
import "std/value" {Value};
import "std/string" as string;
@json.rename_all(json.RenameCase.CamelCase)
type Named = struct {some_field:Int,optional_field:Option(String)};
type Count = struct(Int);
type Node = struct {children:Array(Node),value:Count};
@string.decode_by_parse
@string.encode_by_display
type Text = struct {value:Int};
export def answer = Value.Array([json.schema(Named.type),json.schema(Node.type),json.schema(Text.type)]);
