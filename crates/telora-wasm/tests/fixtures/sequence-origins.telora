use std::_rt as rt;

def notice: Fn(String) -> () = fn(message) {
    let warning: Option(Int) = warn!(message);
};
def pair: Fn(String) -> (Int,) = fn(message) { let ignored = notice(message); (7,) };
def unit: Fn(String) -> () = fn(message) { notice(message) };
def array: Fn(String) -> Array(Int) = fn(message) { let ignored = notice(message); [7] };
def original: (Int,) = (42,);

pub def answer: Fn() -> ((Int, Int), Array(Int), rt::Diagnostic, rt::Diagnostic, String, String, String) = fn() {
    let tuple = (...pair("first"), ...unit("middle"), ...pair("last"));
    let values = [...array("a"), do { let ignored = notice("b"); 8 }, ...array("c")];
    let copied = (...original, 3);
    let origin = rt::with_diagnostics(fn(ignored: ()) { fail!("original", copied.0) })(());
    let container = rt::with_diagnostics(fn(ignored: ()) { fail!("container", copied) })(());
    let stopped = rt::with_diagnostics(fn(ignored: ()) {
        let broken: Fn() -> (Int,) = fn() { fail!("tuple spread failed") };
        (...broken(), ...pair("must not execute"))
    })(());
    let array_stopped = rt::with_diagnostics(fn(ignored: ()) {
        let broken: Fn() -> Array(Int) = fn() { fail!("array spread failed") };
        [...broken(), ...array("must not execute")]
    })(());
    let never = rt::with_diagnostics(fn(ignored: ()) {
        (fail!("uninhabited tuple"), ...pair("must not execute"))
    })(());
    (tuple, values,
     match origin { Err(reports) => reports[0], Ok(_) => fail!("unexpected success") },
     match container { Err(reports) => reports[0], Ok(_) => fail!("unexpected success") },
     match stopped { Err(reports) => reports[0].message, Ok(_) => "unexpected success" },
     match array_stopped { Err(reports) => reports[0].message, Ok(_) => "unexpected success" },
     match never { Err(reports) => reports[0].message, Ok(_) => "unexpected success" })
};
