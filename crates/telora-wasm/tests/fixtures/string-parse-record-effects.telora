import "std/regex" as regex;
import "std/string" as string;
import "std/_rt" as rt;
@regex.parse_by(regex.compile("^(?P<number>.+)$"))
@check(fn(value) { if value.number > 0 { Ok(()) } else { Err(blame!("positive required", value.number)) } })
type Positive = struct { number: Int };
@regex.parse_by(regex.compile("^(?P<label>x)?$"))
type Maybe = struct { label: Option(String) };
export def answer: Fn() -> (Array(rt.Diagnostic), Int, rt.Diagnostic) = fn() {
    let rejected = rt.with_diagnostics(fn(input: String) { string.parse@[Positive](input) })("-7");
    let success = string.parse@[Positive]("42");
    let absent = match string.parse@[Maybe]("") { Ok(value) => value.label, Err(_) => fail!("optional parse") };
    let origin = rt.with_diagnostics(fn(value: Option(String)) { fail!("optional origin", value) })(absent);
    (match rejected { Err(reports) => reports, Ok(_) => fail!("checker was not invoked") },
     match success { Ok(value) => value.number, Err(_) => fail!("valid parse rejected") },
     match origin { Err(reports) => reports[0], Ok(_) => fail!("missing optional origin") })
};
