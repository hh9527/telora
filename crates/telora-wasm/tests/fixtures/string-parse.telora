import "std/string" as string;
import "std/array" as array;
import "std/value" { Value };
export def checks = fn() {
    [string.parse(Int.type, "42") == Ok(42),
     string.parse(Int.type, "-9223372036854775808") == Ok(-9223372036854775807 - 1),
     string.parse(Int.type, "+1") == Ok(1),
     string.parse(Float.type, "-0.0") == Ok(-0.0),
     string.parse(Float.type, "1.25e2") == Ok(125.0),
     string.parse(String.type, "é🦀 original text") == Ok("é🦀 original text"),
     string.parse(Option(Int).type, "42") == Ok(Some(42)),
     string.parse(Option(Option(String)).type, "") == Ok(Some(Some(""))),
     match string.parse(Int.type, "9223372036854775808") { Err(error) => error.message == "$: input is not a valid Int" && error.value == "9223372036854775808", Ok(_) => False },
     match string.parse(Int.type, " 42") { Err(error) => error.message == "$: input is not a valid Int", Ok(_) => False },
     match string.parse(Float.type, "NaN") { Err(error) => error.message == "$: input is not a finite Float", Ok(_) => False },
     match string.parse(Float.type, "inf") { Err(error) => error.message == "$: input is not a finite Float", Ok(_) => False },
     match string.parse(Float.type, "1e999") { Err(error) => error.message == "$: input is not a finite Float", Ok(_) => False }]
};
export def answer = Value.Array(array.map(checks(), fn(value) { if value { Value.True } else { Value.False } }));
