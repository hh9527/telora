use crate::helper as helper;
use std::value::{ Value };
def local: Fn() -> Int = fn() { fail!("root-local") };
pub def a: Int = { let value = local(); fail!("false-continuation", value) };
pub def b: Int = { let value = helper::reject("root-module"); fail!("false-continuation", value) };
pub def c: Int = { let value = helper::forward("root-facade"); fail!("false-continuation", value) };
pub def d: Int = { let value = helper::make("root-closure")(); fail!("false-continuation", value) };
pub def dependent: Int = { let value = a; fail!("false-dependent", value) };
pub def healthy: Int = 42;
pub def answer: Value = Value::Array([Value::Int(a), Value::Int(b), Value::Int(c), Value::Int(d)]);
