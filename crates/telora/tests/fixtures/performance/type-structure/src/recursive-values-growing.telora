type Leaf = struct { value: String };
type AndExpr = struct { items: Array(Expr) };
type Expr = enum { Leaf(Leaf), And(AndExpr) };

def e00: Expr = Expr.Leaf({ value: "x" });
def e01: Expr = Expr.And({ items: [e00, e00] });
