import "std/value" {Value};
@check(fn(value) {
    if value.value >= 0 { Ok(()) } else { Err(blame!("negative value", value.value)) }
})
type Box = struct {value: Int};
def run: Fn(Int, Int) -> Int = fn(n, total) {
    if n == 0 { total } else {
        let item: Box = {value: n};
        run(n - 1, total + item.value)
    }
};
export def result: Value = Value.Int(run(2000, 0));
