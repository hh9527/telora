import "std/value" {Value};
type Box(T) = struct {value: T};
def make: for(T) Fn(T) -> Box(T) = fn(value) { {value} };
def run: Fn(Int, Int) -> Int = fn(n, total) {
    if n == 0 { total } else {
        let item = make(n);
        run(n - 1, total + item.value)
    }
};
export def result: Value = Value.Int(run(20000, 0));
