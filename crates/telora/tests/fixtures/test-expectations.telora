use std::test as test;

pub def a_expected: test::Test = test::should_fail_with(fn() {
    let notice: Option(Int) = warn!("warning survives expected failure");
    fail!("expected error");
}, "expected error");
pub def b_recovered: test::Test = test::should_ok(fn() { 42 });
pub def c_wrong_message: test::Test = test::should_fail_with(fn() { fail!("actual error"); }, "other error");
pub def d_returned_normally: test::Test = test::should_fail(fn() { 1 });
pub def e_last: test::Test = test::should_ok(fn() { 2 });
