import "std/array" as array;
import "ontology-method/types.telora" as types;
import "ontology-method/ontology.telora" as ontology;

@enum type Entity = {
    Consumer: 'None,
    Household: 'None,
    Address: 'None,
    Region: 'None,
    Session: 'None,
    Cart: 'None,
    CartItem: 'None,
    Order: 'None,
    OrderItem: 'None,
    Product: 'None,
    Category: 'None,
    Campaign: 'None,
};

@enum type Measure = {
    PurchaseRevenue: 'None,
    SessionConversions: 'None,
};

@enum type Dimension = {
    PurchaseMonth: 'None,
    ConsumerRegion: 'None,
    AcquisitionCampaign: 'None,
    ProductCategory: 'None,
    LoyaltyTier: 'None,
};

@enum type Alignment = { Natural: 'None };

@enum type SemanticValueType = {
    MoneyCents: 'None,
    Count: 'None,
};

@enum type Aggregation = {
    Additive: 'None,
    NonAdditive: 'None,
};

@enum type Cardinality = {
    ManyToOne: 'None,
    OneToMany: 'None,
};

@struct type RelationMapping = {
    table: String,
    on: String,
};

@struct type MeasurePlan = {
    source: Measure,
    base_entity: Entity,
    required_entities: Array(Entity),
    expression: String,
};

@struct type DimensionPlan = {
    source: Dimension,
    required_entity: Entity,
    expression: String,
};

@struct type PathPlan = {
    joins: Array(Relation),
    fanout: Array(Entity),
    missing: Array(Entity),
};

@struct type ExecutionPlan = {
    revision: String,
    base_entity: Entity,
    measures: Array(MeasurePlan),
    dimensions: Array(DimensionPlan),
    joins: Array(Relation),
    read_only: Bool,
};

type Relation = types.RelationDefinition(Entity, Cardinality, RelationMapping);

type MeasureCapability = types.MeasureDefinition(
    Measure,
    Entity,
    SemanticValueType,
    Aggregation,
    Alignment,
    MeasurePlan,
);

type DimensionCapability = types.DimensionDefinition(
    Dimension,
    Array(Measure),
    DimensionPlan,
);

type MeasureCompilation = types.Compilation(MeasurePlan);
type DimensionCompilation = types.Compilation(DimensionPlan);

def purchase_revenue: MeasureCapability = {
    id: 'PurchaseRevenue,
    value_type: 'MoneyCents,
    natural_grain: 'Order,
    aggregation: 'Additive,
    lower: fn(requested, alignment) {
        'Some({
            source: requested,
            base_entity: 'Order,
            required_entities: ['Consumer],
            expression: "SUM(orders.total_cents)",
        })
    },
};

def session_conversions: MeasureCapability = {
    id: 'SessionConversions,
    value_type: 'Count,
    natural_grain: 'Session,
    aggregation: 'NonAdditive,
    lower: fn(requested, alignment) {
        'Some({
            source: requested,
            base_entity: 'Session,
            required_entities: ['Consumer],
            expression: "SUM(CASE WHEN orders.id IS NULL THEN 0 ELSE 1 END)",
        })
    },
};

def measure_capabilities: Array(MeasureCapability) = [purchase_revenue, session_conversions];

def dimension:
    Fn(Dimension, Entity, String) -> DimensionCapability =
    fn(id, required_entity, expression) {
        {
            id,
            lower: fn(requested, measures) {
                'Some({source: requested, required_entity, expression})
            },
        }
    };

def dimension_capabilities: Array(DimensionCapability) = [
    dimension('PurchaseMonth, 'Order, "substr(orders.ordered_at, 1, 7)"),
    dimension('ConsumerRegion, 'Region, "regions.name"),
    dimension('AcquisitionCampaign, 'Campaign, "campaigns.name"),
    dimension('ProductCategory, 'Product, "categories.name"),
];

def safe_relations: Array(Relation) = [
    {from: 'Order, to: 'Consumer, cardinality: 'ManyToOne, mapping: {table: "consumers", on: "consumers.id = orders.consumer_id"}},
    {from: 'Consumer, to: 'Household, cardinality: 'ManyToOne, mapping: {table: "households", on: "households.id = consumers.household_id"}},
    {from: 'Household, to: 'Address, cardinality: 'ManyToOne, mapping: {table: "addresses", on: "addresses.id = households.address_id"}},
    {from: 'Address, to: 'Region, cardinality: 'ManyToOne, mapping: {table: "regions", on: "regions.id = addresses.region_id"}},
    {from: 'Order, to: 'Session, cardinality: 'ManyToOne, mapping: {table: "sessions", on: "sessions.id = orders.session_id"}},
    {from: 'Session, to: 'Campaign, cardinality: 'ManyToOne, mapping: {table: "campaigns", on: "campaigns.id = sessions.campaign_id"}},
    {from: 'CartItem, to: 'Cart, cardinality: 'ManyToOne, mapping: {table: "carts", on: "carts.id = cart_items.cart_id"}},
    {from: 'Cart, to: 'Consumer, cardinality: 'ManyToOne, mapping: {table: "consumers", on: "consumers.id = carts.consumer_id"}},
    {from: 'CartItem, to: 'Product, cardinality: 'ManyToOne, mapping: {table: "products", on: "products.id = cart_items.product_id"}},
    {from: 'OrderItem, to: 'Order, cardinality: 'ManyToOne, mapping: {table: "orders", on: "orders.id = order_items.order_id"}},
    {from: 'OrderItem, to: 'Product, cardinality: 'ManyToOne, mapping: {table: "products", on: "products.id = order_items.product_id"}},
    {from: 'Product, to: 'Category, cardinality: 'ManyToOne, mapping: {table: "categories", on: "categories.id = products.category_id"}},
];

def fanout_relations: Array(Relation) = [
    {from: 'Order, to: 'OrderItem, cardinality: 'OneToMany, mapping: {table: "order_items", on: "order_items.order_id = orders.id"}},
];

def relation_from: Fn(Relation) -> Entity = fn(relation) { relation.from };
def relation_to: Fn(Relation) -> Entity = fn(relation) { relation.to };

def plan_paths: Fn(Entity, Array(Entity)) -> PathPlan = fn(base, targets) {
    ontology.classify_paths(
        safe_relations,
        fanout_relations,
        base,
        targets,
        relation_from,
        relation_to,
        fn(joins, fanout, missing) { {joins, fanout, missing} },
    )
};

def verify_paths: Fn(PathPlan, Array(DimensionPlan)) -> Bool = fn(paths, dimensions) {
    ontology.verify_path_requirements(
        paths.fanout,
        paths.missing,
        dimensions,
        fn(item) { item.required_entity },
        fn(item) { item.source },
    )
};

export def compile:
    Fn(Array(Measure), Array(Dimension)) -> Option(ExecutionPlan) =
    fn(requested_measures, requested_dimensions) {
        let measure_compilation: MeasureCompilation = ontology.compile_requested(
            requested_measures,
            measure_capabilities,
            fn(capability) { capability.id },
            fn(capability, requested, alignment) { capability.lower(requested, alignment) },
            'Natural,
            fn(results, values, complete) { {results, values, complete} },
        );
        let measures = measure_compilation.values;
        let dimension_compilation: DimensionCompilation = ontology.compile_requested(
            requested_dimensions,
            dimension_capabilities,
            fn(capability) { capability.id },
            fn(capability, requested, selected) { capability.lower(requested, selected) },
            requested_measures,
            fn(results, values, complete) { {results, values, complete} },
        );
        let dimensions = dimension_compilation.values;
        match array.find(measures, fn(ignored) { 'True }) {
            'None => {
                let ignored = emit_error!("a B2C report requires a supported measure", requested_measures);
                'None
            },
            'Some(first) => {
                let same_grain = array.all(measures, fn(item) {
                    item.base_entity == first.base_entity
                });
                let required = array.concat([
                    ontology.collect_required_nodes(measures, fn(item) { item.required_entities }),
                    ontology.collect_required_nodes(dimensions, fn(item) { [item.required_entity] }),
                ]);
                let paths = plan_paths(first.base_entity, required);
                let paths_valid = verify_paths(paths, dimensions);
                if ontology.compilation_complete(measure_compilation.complete)
                    && ontology.compilation_complete(dimension_compilation.complete)
                    && same_grain
                    && paths_valid {
                    'Some({
                        revision: "b2c-model-v1",
                        base_entity: first.base_entity,
                        measures,
                        dimensions,
                        joins: paths.joins,
                        read_only: 'True,
                    })
                } else {
                    'None
                }
            },
        }
    };

export { Entity, Measure, Dimension, ExecutionPlan };
