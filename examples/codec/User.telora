import "std/codec" as codec;
import "std/value" {Value};
import "std/blame" {BlameError};

type Type = struct {v: Option(String)};

def decode: Fn(Value) -> Result(Type, BlameError) = fn(value) {
    codec.decode((Type).type, value)
};

def encode: Fn(Type) -> Value = fn(value) {
    codec.encode(Value.type, value)
};

export { Type, decode, encode };
