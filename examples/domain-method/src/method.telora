import "std/array" as array;

# Cross-industry orchestration only. Domain capability records, policies, and
# diagnostic messages remain owned by their industry libraries.
def lower_independent:
    for(A, B) Fn(Array(A), Fn(A) -> Option(B)) -> Array(Option(B)) =
    fn(inputs, lower) {
        array.map(inputs, lower)
    };

def completed:
    for(A) Fn(Array(Option(A))) -> Array(A) =
    fn(results) {
        array.flat_map(results, fn(result) {
            match result { Some(value) => [value], None => [] }
        })
    };

def collect_complete:
    for(A) Fn(Array(Option(A))) -> Option(Array(A)) =
    fn(results) {
        let values = completed(results);
        if array.length(values) == array.length(results) {
            Some(values)
        } else {
            None
        }
    };

def compose:
    for(A, B, C) Fn(Fn(A) -> Option(B), Fn(B) -> Option(C), A) -> Option(C) =
    fn(first, second, input) {
        match first(input) {
            Some(value) => second(value),
            None => None,
        }
    };

def or_else:
    for(A) Fn(Option(A), Fn() -> A) -> A =
    fn(value, fallback) {
        match value { Some(found) => found, None => fallback() }
    };

def finalize:
    for(A) Fn(Bool, A) -> Option(A) =
    fn(complete, value) {
        if complete { Some(value) } else { None }
    };

export { lower_independent, completed, collect_complete, compose, or_else, finalize };
