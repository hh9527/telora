import "std/array" as arrays;

type Package = struct {
    name: String,
    version: Int,
};

type Project = struct {
    name: String,
    packages: Array(Package),
};

type DiagnosticRecord = struct {message: String};
type Diagnostics = Array(DiagnosticRecord);
type Validation = Tuple([Project, Diagnostics]);

def require_text:
    Fn(String, String, Diagnostics) -> Diagnostics =
    fn(value, message, diagnostics) {
        if value == "" {
            arrays.push(diagnostics, {message})
        } else {
            diagnostics
        }
    };

def check_package:
    Fn(Diagnostics, Package) -> Diagnostics =
    fn(diagnostics, package) {
        let diagnostics = require_text(
            package.name,
            "package name must not be empty",
            diagnostics,
        );
        let diagnostics = if package.version < 1 {
            arrays.push(
                diagnostics,
                {message: "package version must be positive"},
            )
        } else {
            diagnostics
        };
        diagnostics
    };

def validate_project:
    Fn(Project, Diagnostics) -> Validation =
    fn(project, diagnostics) {
        let diagnostics = require_text(
            project.name,
            "project name must not be empty",
            diagnostics,
        );
        let diagnostics = arrays.fold(
            project.packages,
            diagnostics,
            check_package,
        );
        (project, diagnostics)
    };

export {
    DiagnosticRecord,
    Diagnostics,
    Package,
    Project,
    validate_project,
};
