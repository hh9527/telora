import "std/array" as array;
import "std/codec" as codec;
import "analytics-ontology/compiler.telora" as ontology_compiler;
import "ontology-method/ontology.telora" as ontology;
import "ontology-method/types.telora" as types;
import "analytics-method/analytics.telora" as analytics;
import "./sql.telora" {
    Function,
    BinaryOp,
    Expr,
    Projection,
    Source,
    JoinKind,
    Join,
    Order,
    CommonTable,
    SelectBody,
    Select,
    render_select,
};
import "./relations.telora" {
    Entity,
    Relation,
    PathPlan,
    catalog,
    fanout_catalog,
    relation_from,
    relation_to,
    plan,
};
import "./execution.telora" {
    OutputMode, QueryParameter, ResultType, ResultField, RenderPlan, ExecutionPlan,
};

@enum type Measure = {
    NetRevenue: 'None,
    UnitsSold: 'None,
};

@enum type SemanticValueType = {
    MoneyCents: 'None,
    Count: 'None,
};

@enum type Aggregation = {
    Additive: 'None,
};

@enum type Alignment = {
    Natural: 'None,
    PreAggregate: Entity,
};

@enum type Dimension = {
    OrderMonth: 'None,
    CustomerRegion: 'None,
    OrganizationKind: 'None,
    ProductCategory: 'None,
    EmployeeKind: 'None,
    ProductSku: 'None,
};

@struct type ReportIntent = {
    measures: Array(Measure),
    alignment: Alignment,
    dimensions: Array(Dimension),
    filters: Array(Filter),
    order_by: Array(Dimension),
    limit: Option(Int),
    render: RenderIntent,
};

@struct type RenderIntent = { mode: OutputMode, fields: Array(String) };

@struct type Restriction = {
    revision: String,
    allowed_entities: Array(Entity),
};

@enum type Filter = { CustomerRegion: String };

@struct type QueryPlan = {
    measures: Array(Measure),
    base_entity: Entity,
    required_entities: Array(Entity),
    common_tables: Array(CommonTable),
    from: Source,
    joins: Array(Join),
    filters: Array(Expr),
    measure_projections: Array(Projection),
    measure_fields: Array(ResultField),
};

@struct type GroupRequirement = {
    dimension: Dimension,
    projection: Projection,
    group_expression: Expr,
    required_entity: Entity,
    result_field: ResultField,
};

@struct type FilterRequirement = {
    source: Filter,
    expression: Expr,
    required_entity: Entity,
    parameter: QueryParameter,
};

@struct type SemanticPlan = {
    query_plan: QueryPlan,
    requirements: Array(GroupRequirement),
    filter_requirements: Array(FilterRequirement),
    order_by: Array(Dimension),
    limit: Option(Int),
    render: RenderIntent,
};

@struct type RelationalPlan = {
    semantic: SemanticPlan,
    paths: PathPlan,
};

@struct type SqlPlan = {
    query: Select,
    parameters: Array(QueryParameter),
    result_schema: Array(ResultField),
};

type MeasureCapability = types.MeasureDefinition(
    Measure,
    Entity,
    SemanticValueType,
    Aggregation,
    Alignment,
    QueryPlan,
);

type DimensionCapability = types.DimensionDefinition(
    Dimension,
    Array(Measure),
    GroupRequirement,
);

def complete_requirement: Fn(Dimension, Projection, Expr, Entity, ResultField) -> Option(GroupRequirement) = fn(dimension, projected, group_expression, required_entity, result_field) {
    'Some({dimension, projection: projected, group_expression, required_entity, result_field})
};

def rejected_requirement: Fn(Dimension, String) -> Option(GroupRequirement) = fn(value, message) {
    let reject: Fn(Dimension, String) -> Result(GroupRequirement, String) =
        fn(evidence, reason) { 'Err(reason) };
    reject.should_ok!(value, message)
};

# A higher-order compiler factory: construct a dimension capability whose
# lowering is valid for every current measure.
def universal_dimension: Fn(Dimension, Projection, Expr, Entity, ResultField) -> DimensionCapability = fn(id, projected, group_expression, required_entity, result_field) {
    {
        id,
        lower: fn(requested, measures) {
            complete_requirement(requested, projected, group_expression, required_entity, result_field)
        },
    }
};

# A second compiler factory: construct a capability restricted to one measure.
# The same function both verifies the semantic edge and lowers it.
def measure_dimension: Fn(Dimension, Measure, Projection, Expr, Entity, ResultField) -> DimensionCapability = fn(id, required_measure, projected, group_expression, required_entity, result_field) {
    {
        id,
        lower: fn(requested, actual_measures) {
            if array.all(actual_measures, fn(actual_measure) { actual_measure == required_measure }) {
                complete_requirement(id, projected, group_expression, required_entity, result_field)
            } else {
                rejected_requirement(
                    requested,
                    `dimension \{id} is not compatible with every selected measure \{actual_measures} at its current grain`,
                )
            }
        },
    }
};

def unsupported_dimension: Fn(Dimension, String) -> DimensionCapability = fn(id, reason) {
    {
        id,
        lower: fn(requested, measures) {
            rejected_requirement(requested, `dimension \{requested} is not available: \{reason}`)
        },
    }
};

def column: Fn(String, String) -> Expr = fn(relation, name) {
    'Column({relation, name})
};

def call: Fn(Function, Array(Expr)) -> Expr = fn(function, args) {
    'Call({function, args})
};

def binary: Fn(Expr, BinaryOp, Expr) -> Expr = fn(left, op, right) {
    'Binary({left, op, right})
};

def projection: Fn(Expr, String) -> Projection = fn(expr, alias) {
    {expr, alias: 'Some(alias)}
};

def aggregate_projection: Fn(Function, Expr, String) -> Projection = fn(function, value, alias) {
    {expr: 'Aggregate({function, value}), alias: 'Some(alias)}
};

def source: Fn(String, String) -> Source = fn(name, alias) { {name, alias} };

def join: Fn(JoinKind, Source, Expr) -> Join = fn(kind, joined_source, on) {
    {kind, source: joined_source, on}
};

def relation_join: Fn(Relation) -> Join = fn(relation) {
    let mapping = relation.mapping;
    join(
        'Inner,
        source(mapping.table, mapping.alias),
        equals(
            column(mapping.left_alias, mapping.left_column),
            column(mapping.right_alias, mapping.right_column),
        ),
    )
};

def equals: Fn(Expr, Expr) -> Expr = fn(left, right) {
    binary(left, 'Equal, right)
};

def payment_by_order: SelectBody = {
    projections: [
        projection(column("payments", "order_id"), "order_id"),
        aggregate_projection('Sum, column("payments", "amount_cents"), "captured_cents"),
    ],
    from: source("payments", "payments"),
    joins: [],
    filters: [equals(column("payments", "status"), 'Int(2))],
    limit: 'None,
    group_by: [column("payments", "order_id")],
    order_by: [],
};

def refund_by_order: SelectBody = {
    projections: [
        projection(column("payments", "order_id"), "order_id"),
        aggregate_projection('Sum, column("refunds", "amount_cents"), "refunded_cents"),
    ],
    from: source("refunds", "refunds"),
    joins: [join(
        'Inner,
        source("payments", "payments"),
        equals(column("payments", "id"), column("refunds", "payment_id")),
    )],
    filters: [equals(column("refunds", "status"), 'Int(2))],
    limit: 'None,
    group_by: [column("payments", "order_id")],
    order_by: [],
};

def net_revenue: MeasureCapability = {
    id: 'NetRevenue,
    value_type: 'MoneyCents,
    natural_grain: 'Order,
    aggregation: 'Additive,
    lower: fn(requested, alignment) {
        let aligned = match alignment {
            'Natural => 'Some('Order),
            'PreAggregate(target) => if target == 'Order {
                'Some('Order)
            } else {
                let reject: Fn(Alignment) -> Result(Entity, String) =
                    fn(evidence) { 'Err(`NetRevenue cannot align from Order to \{target}`) };
                reject.should_ok!(alignment)
            },
        };
        match aligned {
        'None => 'None,
        'Some(base_entity) => 'Some({
            measures: [requested],
            base_entity,
            required_entities: [],
            common_tables: [
                {name: "payment_by_order", query: payment_by_order},
                {name: "refund_by_order", query: refund_by_order},
            ],
            from: source("orders", "o"),
            joins: [
                join('Left, source("payment_by_order", "p"), equals(column("p", "order_id"), column("o", "id"))),
                join('Left, source("refund_by_order", "f"), equals(column("f", "order_id"), column("o", "id"))),
            ],
            filters: [equals(column("o", "status"), 'Int(2))],
            measure_projections: [aggregate_projection(
                'Sum,
                binary(
                    call('Coalesce, [column("p", "captured_cents"), 'Int(0)]),
                    'Subtract,
                    call('Coalesce, [column("f", "refunded_cents"), 'Int(0)]),
                ),
                "net_revenue_cents",
            )],
            measure_fields: [{name: "net_revenue_cents", ty: 'MoneyCents}],
        }),
        }
    },
};

def units_sold: MeasureCapability = {
    id: 'UnitsSold,
    value_type: 'Count,
    natural_grain: 'OrderItem,
    aggregation: 'Additive,
    lower: fn(requested, alignment) {
        match alignment {
        'Natural => 'Some({
            measures: [requested],
            base_entity: 'OrderItem,
            required_entities: ['Order],
            common_tables: [],
            from: source("order_items", "oi"),
            joins: [],
            filters: [binary(column("o", "status"), 'NotEqual, 'Int(3))],
            measure_projections: [aggregate_projection('Sum, column("oi", "quantity"), "units_sold")],
            measure_fields: [{name: "units_sold", ty: 'Count}],
        }),
        'PreAggregate(target) => if target == 'Order {
            'Some({
                measures: [requested],
                base_entity: 'Order,
                required_entities: [],
                common_tables: [{
                    name: "units_by_order",
                    query: {
                        projections: [
                            projection(column("oi", "order_id"), "order_id"),
                            aggregate_projection('Sum, column("oi", "quantity"), "units_sold"),
                        ],
                        from: source("order_items", "oi"),
                        joins: [],
                        filters: [],
                        limit: 'None,
                        group_by: [column("oi", "order_id")],
                        order_by: [],
                    },
                }],
                from: source("orders", "o"),
                joins: [join(
                    'Left,
                    source("units_by_order", "u"),
                    equals(column("u", "order_id"), column("o", "id")),
                )],
                filters: [binary(column("o", "status"), 'NotEqual, 'Int(3))],
                measure_projections: [aggregate_projection(
                    'Sum,
                    call('Coalesce, [column("u", "units_sold"), 'Int(0)]),
                    "units_sold",
                )],
                measure_fields: [{name: "units_sold", ty: 'Count}],
            })
        } else {
            let reject: Fn(Alignment) -> Result(QueryPlan, String) =
                fn(evidence) { 'Err(`UnitsSold supports pre-aggregation from OrderItem to Order, not \{target}`) };
            reject.should_ok!(alignment)
        },
        }
    },
};

def measure_capabilities: Array(MeasureCapability) = [net_revenue, units_sold];

def dimension_capability: Fn(Dimension) -> DimensionCapability = fn(dimension) {
    match dimension {
        'OrderMonth => universal_dimension(
            dimension,
            projection(call('Substr, [column("o", "ordered_at"), 'Int(1), 'Int(7)]), "order_month"),
            call('Substr, [column("o", "ordered_at"), 'Int(1), 'Int(7)]),
            'Order,
            {name: "order_month", ty: 'Text},
        ),
        'CustomerRegion => universal_dimension(
            dimension,
            projection(column("r", "name"), "customer_region"),
            column("r", "name"),
            'Region,
            {name: "customer_region", ty: 'Text},
        ),
        'OrganizationKind => measure_dimension(
            dimension,
            'NetRevenue,
            projection(column("org", "kind"), "organization_kind"),
            column("org", "kind"),
            'Organization,
            {name: "organization_kind", ty: 'Int},
        ),
        'ProductCategory => universal_dimension(
            dimension,
            projection(column("cat", "name"), "product_category"),
            column("cat", "name"),
            'Category,
            {name: "product_category", ty: 'Text},
        ),
        'EmployeeKind => unsupported_dimension(
            dimension,
            "the ontology has no verified Employee-to-measure relation",
        ),
        'ProductSku => universal_dimension(
            dimension,
            projection(column("product", "sku"), "product_sku"),
            column("product", "sku"),
            'Product,
            {name: "product_sku", ty: 'Text},
        ),
    }
};

def dimension_capabilities: Array(DimensionCapability) = array.map(
    [
        'OrderMonth,
        'CustomerRegion,
        'OrganizationKind,
        'ProductCategory,
        'EmployeeKind,
        'ProductSku,
    ],
    dimension_capability,
);

def selected_measures: Fn(ReportIntent) -> Option(Array(Measure)) = fn(intent) {
    if array.length(intent.measures) == 0 {
        let reject: Fn(Array(Measure)) -> Result(Array(Measure), String) =
            fn(evidence) { 'Err("a report requires at least one measure") };
        reject.should_ok!(intent.measures)
    } else {
        'Some(intent.measures)
    }
};

def combine_query_plans: Fn(Array(QueryPlan), Alignment) -> Option(QueryPlan) = fn(plans, alignment) {
    match array.find(plans, fn(ignored) { 'True }) {
    'None => 'None,
    'Some(first) => if array.all(plans, fn(plan) { plan.base_entity == first.base_entity && plan.from == first.from }) {
        let measures: Array(Measure) = array.flat_map(plans, fn(plan) { plan.measures });
        let required_entities: Array(Entity) = array.flat_map(plans, fn(plan) { plan.required_entities });
        let common_tables: Array(CommonTable) = array.flat_map(plans, fn(plan) { plan.common_tables });
        let joins: Array(Join) = array.flat_map(plans, fn(plan) { plan.joins });
        let filters: Array(Expr) = array.flat_map(plans, fn(plan) { plan.filters });
        let measure_projections: Array(Projection) = array.flat_map(plans, fn(plan) { plan.measure_projections });
        let measure_fields: Array(ResultField) = array.flat_map(plans, fn(plan) { plan.measure_fields });
        'Some({
            measures,
            base_entity: first.base_entity,
            required_entities,
            common_tables,
            from: first.from,
            joins,
            filters,
            measure_projections,
            measure_fields,
        })
    } else {
        let reject: Fn(Array(QueryPlan)) -> Result(QueryPlan, String) = fn(evidence) {
            'Err(`selected measures remain at incompatible grains; use 'PreAggregate('Order) instead of \{alignment}`)
        };
        reject.should_ok!(plans)
    },
    }
};

def compile_filters: Fn(Array(Filter)) -> Array(FilterRequirement) = fn(filters) {
    array.map(filters, fn(filter) {
        match filter {
            'CustomerRegion(value) => {
                source: filter,
                expression: equals(column("r", "name"), 'Parameter),
                required_entity: 'Region,
                parameter: {name: "customer_region", value: 'Text(value)},
            },
        }
    })
};

def verify_order: Fn(ReportIntent) -> Bool = fn(intent) {
    let checks: Array(Bool) = array.map(intent.order_by, fn(ordered) {
        if array.any(intent.dimensions, fn(dimension) { dimension == ordered }) {
            'True
        } else {
            let reject: Fn(Dimension) -> Result(Dimension, String) =
                fn(evidence) { 'Err("an ordered dimension must also be selected") };
            let ignored = reject.should_ok!(ordered);
            'False
        }
    });
    array.all(checks, fn(valid) { valid })
};

def ordered_expressions: Fn(Array(Dimension), Array(GroupRequirement)) -> Array(Expr) = fn(ordered, requirements) {
    array.flat_map(ordered, fn(dimension) {
        array.map(
            array.filter(requirements, fn(requirement) { requirement.dimension == dimension }),
            fn(requirement) { requirement.group_expression },
        )
    })
};

def required_targets: Fn(QueryPlan, Array(GroupRequirement), Array(FilterRequirement)) -> Array(Entity) = fn(query_plan, requirements, filters) {
    array.concat([
        ontology.collect_required_nodes([query_plan], fn(plan) { plan.required_entities }),
        ontology.collect_required_nodes(requirements, fn(requirement) { [requirement.required_entity] }),
        ontology.collect_required_nodes(filters, fn(filter) { [filter.required_entity] }),
    ])
};

def verify_relationships: Fn(PathPlan, Array(GroupRequirement)) -> Bool = fn(paths, requirements) {
    ontology.verify_path_requirements(
        paths.fanout,
        paths.missing,
        requirements,
        fn(requirement) { requirement.required_entity },
        fn(requirement) { requirement.dimension },
    )
};

def decode_restriction: Fn(Any) -> Restriction = fn(raw) {
    match codec.decode(Restriction, raw) {
        'Ok(restriction) => restriction,
        'Err(error) => fail!(error.message, error),
    }
};

def verify_restriction:
    Fn(Restriction, Array(GroupRequirement), Array(FilterRequirement)) -> Bool =
    fn(restriction, requirements, filters) {
        let dimension_errors = array.flat_map(requirements, fn(requirement) {
            if array.any(restriction.allowed_entities, fn(entity) {
                entity == requirement.required_entity
            }) {
                []
            } else {
                let reject: Fn(Dimension, Array(Entity)) -> Result(Dimension, String) = fn(evidence, allowed) {
                    'Err(`dimension \{requirement.dimension} requires unauthorized entity \{requirement.required_entity}`)
                };
                [reject.should_ok!(requirement.dimension, restriction.allowed_entities)]
            }
        });
        let filter_errors = array.flat_map(filters, fn(filter) {
            if array.any(restriction.allowed_entities, fn(entity) {
                entity == filter.required_entity
            }) {
                []
            } else {
                let reject: Fn(Filter, Array(Entity)) -> Result(Filter, String) = fn(evidence, allowed) {
                    'Err(`filter requires unauthorized entity \{filter.required_entity}`)
                };
                [reject.should_ok!(filter.source, restriction.allowed_entities)]
            }
        });
        array.length(dimension_errors) == 0 && array.length(filter_errors) == 0
    };

def lower_semantics: Fn(ReportIntent, QueryPlan, Array(GroupRequirement), Array(FilterRequirement)) -> SemanticPlan = fn(intent, query_plan, requirements, filter_requirements) {
    {
        query_plan,
        requirements,
        filter_requirements,
        order_by: intent.order_by,
        limit: intent.limit,
        render: intent.render,
    }
};

def lower_relationships: Fn(SemanticPlan) -> RelationalPlan = fn(semantic) {
    {
        semantic,
        paths: plan(
            semantic.query_plan.base_entity,
            required_targets(semantic.query_plan, semantic.requirements, semantic.filter_requirements),
        ),
    }
};

def lower_sql: Fn(RelationalPlan) -> SqlPlan = fn(relational) {
    let semantic = relational.semantic;
    let query_plan = semantic.query_plan;
    let requirements = semantic.requirements;
    let groups = array.map(requirements, fn(requirement) { requirement.group_expression });
    {
        query: {
            common_tables: query_plan.common_tables,
            body: {
                projections: array.concat([
                    array.map(requirements, fn(requirement) { requirement.projection }),
                    query_plan.measure_projections,
                ]),
                from: query_plan.from,
                joins: array.concat([query_plan.joins, array.map(relational.paths.relations, relation_join)]),
                filters: array.concat([
                    query_plan.filters,
                    array.map(semantic.filter_requirements, fn(filter) { filter.expression }),
                ]),
                group_by: groups,
                order_by: array.map(
                    ordered_expressions(semantic.order_by, requirements),
                    fn(expr) { {expr} },
                ),
                limit: semantic.limit,
            },
        },
        parameters: array.map(semantic.filter_requirements, fn(filter) { filter.parameter }),
        result_schema: array.concat([
            array.map(requirements, fn(requirement) { requirement.result_field }),
            query_plan.measure_fields,
        ]),
    }
};

def compile_render: Fn(RenderIntent, Array(ResultField)) -> Option(RenderPlan) = fn(intent, schema) {
    let missing = analytics.missing_names(intent.fields, schema, fn(field) { field.name });
    let errors = array.map(missing, fn(name) {
        let reject: Fn(String) -> Result(String, String) =
            fn(evidence) { 'Err(`render field \{name} is absent from the result schema`) };
        reject.should_ok!(name)
    });
    if array.length(errors) == 0 {
        'Some({mode: intent.mode, fields: intent.fields})
    } else {
        'None
    }
};

export def compile: Fn(Any, ReportIntent) -> Option(ExecutionPlan) = fn(raw_restriction, intent) {
    let restriction = decode_restriction(raw_restriction);
    let order_valid = verify_order(intent);
    let filter_requirements = compile_filters(intent.filters);
    match selected_measures(intent) {
        'None => 'None,
        'Some(measures) => {
            ontology_compiler.compile_with(
                measures,
                measure_capabilities,
                fn(capability) { capability.id },
                fn(capability, measure, alignment) { capability.lower(measure, alignment) },
                intent.alignment,
                intent.dimensions,
                dimension_capabilities,
                fn(capability) { capability.id },
                fn(capability, dimension, selected) { capability.lower(dimension, selected) },
                measures,
                fn(fragments) { combine_query_plans(fragments, intent.alignment) },
                fn(query_plan) { query_plan.base_entity },
                fn(query_plan) { query_plan.required_entities },
                fn(requirement) { requirement.required_entity },
                fn(requirement) { requirement.dimension },
                array.map(filter_requirements, fn(filter) { filter.required_entity }),
                catalog,
                fanout_catalog,
                relation_from,
                relation_to,
                fn(query_plan, requirements, relations) {
                    let semantic = lower_semantics(
                        intent,
                        query_plan,
                        requirements,
                        filter_requirements,
                    );
                    let relational: RelationalPlan = {
                        semantic,
                        paths: {relations, fanout: [], missing: []},
                    };
                    let restriction_valid = verify_restriction(
                        restriction,
                        requirements,
                        filter_requirements,
                    );
                    let sql_plan = lower_sql(relational);
                    match compile_render(intent.render, sql_plan.result_schema) {
                        'None => 'None,
                        'Some(render) => if restriction_valid && order_valid {
                            'Some({
                                version: 1,
                                restriction_revision: restriction.revision,
                                dialect: 'Sqlite,
                                statement: render_select(sql_plan.query),
                                parameters: sql_plan.parameters,
                                result_schema: sql_plan.result_schema,
                                render,
                                read_only: 'True,
                            })
                        } else {
                            'None
                        },
                    }
                },
            )
        }
    }
};

export {
    Measure,
    SemanticValueType,
    Aggregation,
    Alignment,
    Restriction,
    Dimension,
    ReportIntent,
    MeasureCapability,
    DimensionCapability,
    SemanticPlan,
    RelationalPlan,
    SqlPlan,
    lower_semantics,
    lower_relationships,
    lower_sql,
};
