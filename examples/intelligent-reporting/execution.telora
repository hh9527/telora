import "std/json" as json;
import "std/array" as array;
import "std/codec" as codec;
import "std/result" as result;

type SqlDialect = enum { 'Sqlite };
type OutputMode = enum { 'Table, 'Json };

type ParameterValue = enum { 'Text(String), 'Int(Int) };
type QueryParameter = struct { name: String, value: ParameterValue };

type ResultType = enum { 'Text, 'Int, 'MoneyCents, 'Count };
type ResultField = struct { name: String, ty: ResultType };

type RenderPlan = struct { mode: OutputMode, fields: Array(String) };
type EncodedParameter = struct { name: String, ty: String, value: String };
type EncodedResultField = struct { name: String, ty: String };

type ExecutionPlan = struct {
    version: Int,
    restriction_revision: String,
    dialect: SqlDialect,
    statement: String,
    parameters: Array(QueryParameter),
    result_schema: Array(ResultField),
    render: RenderPlan,
    read_only: Bool,
};

def encode_parameter: Fn(QueryParameter) -> EncodedParameter = fn(parameter) {
    match parameter.value {
        'Text(value) => {name: parameter.name, ty: "text", value},
        'Int(value) => {name: parameter.name, ty: "int", value: `\{value}`},
    }
};

def encode_result_field: Fn(ResultField) -> EncodedResultField = fn(field) {
    let ty = match field.ty {
        'Text => "text",
        'Int => "int",
        'MoneyCents => "money_cents",
        'Count => "count",
    };
    {name: field.name, ty}
};

def encode_plan: Fn(ExecutionPlan) -> String = fn(plan) {
    let dialect = match plan.dialect { 'Sqlite => "sqlite" };
    let output = match plan.render.mode { 'Table => "table", 'Json => "json" };
    let value = codec.encode(codec.Value, {
        version: plan.version,
        restriction_revision: plan.restriction_revision,
        dialect,
        statement: plan.statement,
        parameters: array.map(plan.parameters, encode_parameter),
        result_schema: array.map(plan.result_schema, encode_result_field),
        render: {mode: output, fields: plan.render.fields},
        read_only: plan.read_only,
    }) |> result.unwrap;
    json.stringify(value)
};

export {
    SqlDialect, OutputMode, ParameterValue, QueryParameter,
    ResultType, ResultField, RenderPlan, ExecutionPlan, encode_plan,
};
