import "./b2b-model.telora" { compile };
import "./execution.telora" { ExecutionPlan, encode_plan };
import "./restriction.json" { data as restriction };

let compilation = compile(restriction, {
    measures: ['NetRevenue],
    alignment: 'Natural,
    dimensions: ['OrderMonth, 'CustomerRegion],
    filters: ['CustomerRegion("East")],
    order_by: ['OrderMonth],
    limit: 'Some(10),
    render: {mode: 'Json, fields: ["order_month", "customer_region", "net_revenue_cents"]},
});

let checked: Option(ExecutionPlan) = compilation;

export let output = match checked {
    'Some(plan) => encode_plan(plan),
    'None => "",
};
