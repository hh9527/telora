import "./b2b-model.telora" { compile };
import "./restriction.json" { data as restriction };

export let output = compile(restriction, {
    measures: ['NetRevenue, 'UnitsSold],
    alignment: 'Natural,
    dimensions: ['OrderMonth],
    filters: [],
    order_by: ['CustomerRegion],
    limit: 'Some(20),
    render: {mode: 'Table, fields: ["order_month", "net_revenue_cents", "units_sold"]},
});
