import "ontology-method/ontology.telora" as ontology;
import "ontology-method/types.telora" as types;

@enum type Entity = {
    Region: 'None,
    Organization: 'None,
    Customer: 'None,
    Order: 'None,
    OrderItem: 'None,
    Product: 'None,
    Category: 'None,
};

@struct type RelationMapping = {
    table: String,
    alias: String,
    left_alias: String,
    left_column: String,
    right_alias: String,
    right_column: String,
};

@enum type Cardinality = {
    ManyToOne: 'None,
    OneToMany: 'None,
};

type Relation = types.RelationDefinition(Entity, Cardinality, RelationMapping);

@struct type PathPlan = {
    relations: Array(Relation),
    fanout: Array(Entity),
    missing: Array(Entity),
};

def catalog: Array(Relation) = [
    {from: 'OrderItem, to: 'Order, cardinality: 'ManyToOne, mapping: {table: "orders", alias: "o", left_alias: "o", left_column: "id", right_alias: "oi", right_column: "order_id"}},
    {from: 'Order, to: 'Customer, cardinality: 'ManyToOne, mapping: {table: "customers", alias: "c", left_alias: "c", left_column: "id", right_alias: "o", right_column: "customer_id"}},
    {from: 'Customer, to: 'Organization, cardinality: 'ManyToOne, mapping: {table: "organizations", alias: "org", left_alias: "org", left_column: "id", right_alias: "c", right_column: "org_id"}},
    {from: 'Organization, to: 'Region, cardinality: 'ManyToOne, mapping: {table: "regions", alias: "r", left_alias: "r", left_column: "id", right_alias: "org", right_column: "region_id"}},
    {from: 'OrderItem, to: 'Product, cardinality: 'ManyToOne, mapping: {table: "products", alias: "product", left_alias: "product", left_column: "id", right_alias: "oi", right_column: "product_id"}},
    {from: 'Product, to: 'Category, cardinality: 'ManyToOne, mapping: {table: "categories", alias: "cat", left_alias: "cat", left_column: "id", right_alias: "product", right_column: "category_id"}},
];

def fanout_catalog: Array(Relation) = [
    {from: 'Order, to: 'OrderItem, cardinality: 'OneToMany, mapping: {table: "order_items", alias: "oi", left_alias: "oi", left_column: "order_id", right_alias: "o", right_column: "id"}},
];

def relation_from: Fn(Relation) -> Entity = fn(relation) { relation.from };
def relation_to: Fn(Relation) -> Entity = fn(relation) { relation.to };

def plan: Fn(Entity, Array(Entity)) -> PathPlan = fn(base, targets) {
    ontology.classify_paths(
        catalog,
        fanout_catalog,
        base,
        targets,
        relation_from,
        relation_to,
        fn(relations, fanout, missing) { {relations, fanout, missing} },
    )
};

export { Entity, Cardinality, Relation, PathPlan, plan };
