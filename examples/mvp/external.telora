import "std/codec" as codec;
import "std/entry" as entry;
import "std/value" { Value };

type Request = struct {
    action: String,
    count: Int,
};

export def main = entry.main({sources: ["input"], envs: [], args: False}, fn(ctx) {
    let request = codec.decode(Request.type, ctx.sources.input).unwrap!();
    codec.encode(Value.type, request)
});
