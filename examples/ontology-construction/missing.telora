import "ontology-method/types.telora" as ontology;
import "ontology-method/ontology.telora" as method;

type Entity = enum { 'Order };
type Measure = enum { 'Revenue, 'Units };

type MeasureCapability = ontology.Capability(Measure, Entity, String);

def revenue: MeasureCapability = {
    id: 'Revenue,
    lower: fn(measure, entity) { 'Some(`revenue from \{entity}`) },
};

def requested: Array(Measure) = ['Revenue, 'Units];
def input: Entity = 'Order;
export def output = method.lower_requested(
    requested,
    [revenue],
    fn(item) { item.id },
    fn(item, id, input) { item.lower(id, input) },
    input,
);
