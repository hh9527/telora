import "std/array" as array;

def contains: for(A) Fn(Array(A), A) -> Bool = fn(values, expected) {
    array.any(values, fn(value) { value == expected })
};

def reject_same: for(A)
    Fn(A, String) -> Result(A, String) =
    fn(evidence, message) { 'Err(message) };

def find_capability:
    for(Id, Capability)
    Fn(Array(Capability), Id, Fn(Capability) -> Id) -> Option(Capability) =
    fn(capabilities, requested, id_of) {
        array.find(capabilities, fn(capability) {
            id_of(capability) == requested
        })
    };

# Resolve and run every requested capability independently. Missing
# capabilities are domain errors, while lowerers retain the model's own
# Option-based completion policy.
def lower_requested:
    for(Id, Capability, Input, Output)
    Fn(
        Array(Id),
        Array(Capability),
        Fn(Capability) -> Id,
        Fn(Capability, Id, Input) -> Option(Output),
        Input,
    ) -> Array(Option(Output)) =
    fn(requested, capabilities, id_of, lower_of, input) {
        array.map(requested, fn(id) {
            match find_capability(capabilities, id, id_of) {
                'Some(capability) => lower_of(capability, id, input),
                'None => {
                    let ignored = reject_same.should_ok!(
                        id,
                        `no ontology capability is defined for \{id}`,
                    );
                    'None
                },
            }
        })
    };

def completed:
    for(A) Fn(Array(Option(A))) -> Array(A) =
    fn(results) {
        array.flat_map(results, fn(result) {
            match result {
                'Some(value) => [value],
                'None => [],
            }
        })
    };

def all_complete:
    for(A) Fn(Array(Option(A))) -> Bool =
    fn(results) {
        array.length(completed(results)) == array.length(results)
    };

def compile_requested:
    for(Id, Capability, Input, Output, Result)
    Fn(
        Array(Id),
        Array(Capability),
        Fn(Capability) -> Id,
        Fn(Capability, Id, Input) -> Option(Output),
        Input,
        Fn(Array(Option(Output)), Array(Output), Option(Array(Output))) -> Result,
    ) -> Result =
    fn(requested, capabilities, id_of, lower, input, build) {
        let results = lower_requested(
            requested,
            capabilities,
            id_of,
            lower,
            input,
        );
        let values = completed(results);
        let complete = if array.length(values) == array.length(requested) {
            'Some(values)
        } else {
            'None
        };
        build(results, values, complete)
    };

def compilation_complete:
    for(A) Fn(Option(Array(A))) -> Bool =
    fn(complete) {
        match complete {
            'Some(values) => 'True,
            'None => 'False,
        }
    };

def collect_required_nodes:
    for(Output, Node)
    Fn(Array(Output), Fn(Output) -> Array(Node)) -> Array(Node) =
    fn(outputs, required_nodes) {
        array.flat_map(outputs, required_nodes)
    };

def expand_once:
    for(Node, Edge)
    Fn(Array(Edge), Array(Node), Fn(Edge) -> Node, Fn(Edge) -> Node)
        -> Array(Node) =
    fn(edges, reachable, from, to) {
        array.fold(edges, reachable, fn(next, edge) {
            if contains(next, from(edge)) {
                array.push(next, to(edge))
            } else {
                next
            }
        })
    };

# The reusable method makes bounded closure explicit. Models with a larger
# graph must select or provide another policy instead of assuming completeness.
def close_six:
    for(Node, Edge)
    Fn(Array(Edge), Array(Node), Fn(Edge) -> Node, Fn(Edge) -> Node)
        -> Array(Node) =
    fn(edges, seeds, from, to) {
        let once = expand_once(edges, seeds, from, to);
        let twice = expand_once(edges, once, from, to);
        let three = expand_once(edges, twice, from, to);
        let four = expand_once(edges, three, from, to);
        let five = expand_once(edges, four, from, to);
        expand_once(edges, five, from, to)
    };

def select_connecting_edges:
    for(Node, Edge)
    Fn(
        Array(Edge),
        Array(Node),
        Array(Node),
        Fn(Edge) -> Node,
        Fn(Edge) -> Node,
    ) -> Array(Edge) =
    fn(edges, reachable, needed, from, to) {
        array.filter(edges, fn(edge) {
            contains(reachable, from(edge)) && contains(needed, to(edge))
        })
    };

def classify_paths:
    for(Node, Edge, Result)
    Fn(
        Array(Edge),
        Array(Edge),
        Node,
        Array(Node),
        Fn(Edge) -> Node,
        Fn(Edge) -> Node,
        Fn(Array(Edge), Array(Node), Array(Node)) -> Result,
    ) -> Result =
    fn(safe_edges, fanout_edges, base, targets, from, to, build) {
        let needed = close_six(safe_edges, targets, to, from);
        let safe_reachable = close_six(safe_edges, [base], from, to);
        let all_reachable = close_six(
            array.concat([safe_edges, fanout_edges]),
            [base],
            from,
            to,
        );
        build(
            select_connecting_edges(
                safe_edges,
                safe_reachable,
                needed,
                from,
                to,
            ),
            array.filter(targets, fn(target) {
                contains(safe_reachable, target) == 'False
                    && contains(all_reachable, target)
            }),
            array.filter(targets, fn(target) {
                contains(all_reachable, target) == 'False
            }),
        )
    };

def verify_path_requirements:
    for(Node, Requirement, Subject)
    Fn(
        Array(Node),
        Array(Node),
        Array(Requirement),
        Fn(Requirement) -> Node,
        Fn(Requirement) -> Subject,
    ) -> Bool =
    fn(fanout, missing, requirements, required_node, subject_of) {
        let fanout_errors = array.flat_map(fanout, fn(target) {
            array.map(
                array.filter(requirements, fn(requirement) {
                    required_node(requirement) == target
                }),
                fn(requirement) {
                    reject_same.should_ok!(
                        subject_of(requirement),
                        `reaching \{target} expands the measure grain; define pre-aggregation or an allocation policy`,
                    )
                },
            )
        });
        let missing_errors = array.flat_map(missing, fn(target) {
            array.map(
                array.filter(requirements, fn(requirement) {
                    required_node(requirement) == target
                }),
                fn(requirement) {
                    reject_same.should_ok!(
                        subject_of(requirement),
                        `no verified relationship path reaches \{target}`,
                    )
                },
            )
        });
        array.length(fanout_errors) == 0 && array.length(missing_errors) == 0
    };

def verify_allowed:
    for(Node, Requirement)
    Fn(Array(Requirement), Array(Node), Fn(Requirement) -> Node) -> Bool =
    fn(requirements, allowed, required_node) {
        let failures = array.flat_map(requirements, fn(requirement) {
            let required = required_node(requirement);
            if contains(allowed, required) {
                []
            } else {
                [reject_same.should_ok!(
                    requirement,
                    `ontology requirement needs unauthorized entity \{required}`,
                )]
            }
        });
        array.length(failures) == 0
    };

export {
    contains,
    find_capability,
    lower_requested,
    completed,
    all_complete,
    compile_requested,
    compilation_complete,
    collect_required_nodes,
    expand_once,
    close_six,
    select_connecting_edges,
    classify_paths,
    verify_path_requirements,
    verify_allowed,
};
