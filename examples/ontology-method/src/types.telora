# Model families are declared directly. Applying one preserves the provider's
# declaration identity together with the canonical argument identities.
type Maybe(T) = Option(T);
type Many(T) = Array(T);

type Requirement(Key, Output) = struct {
        key: Key,
        output: Output,
};

type Capability(Id, Input, Output) = struct {
        id: Id,
        lower: Fn(Id, Input) -> Option(Output),
};

type MeasureDefinition(Id, Entity, SemanticType, Aggregation, Input, Output) = struct {
    id: Id,
    value_type: SemanticType,
    natural_grain: Entity,
    aggregation: Aggregation,
    lower: Fn(Id, Input) -> Option(Output),
};

type DimensionDefinition(Id, Input, Output) = struct {
    id: Id,
    lower: Fn(Id, Input) -> Option(Output),
};

type RelationDefinition(Entity, Cardinality, Mapping) = struct {
    from: Entity,
    to: Entity,
    cardinality: Cardinality,
    mapping: Mapping,
};

type Compilation(Output) = struct {
    results: Array(Option(Output)),
    values: Array(Output),
    complete: Option(Array(Output)),
};

export {
    Maybe,
    Many,
    Requirement,
    Capability,
    MeasureDefinition,
    DimensionDefinition,
    RelationDefinition,
    Compilation,
};
