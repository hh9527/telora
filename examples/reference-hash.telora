import "std/array" as arrays;
import "std/type-desc" as desc;
import "std/dyn" as dyn;
import "std/hash" as hash;

@enum type TypeDescKind = {
    Any: 'None, Never: 'None, Type: 'None, TypeOf: 'None,
    Int: 'None, Float: 'None, String: 'None, Bytes: 'None,
    Atom: 'None, Array: 'None, Dict: 'None, Tagged: 'None,
    Tuple: 'None, Struct: 'None, Enum: 'None, Union: 'None,
    Func: 'None, Opaque: 'None, WithAttributes: 'None,
    Bound: 'None, Dyn: 'None, Ref: 'None,
};
type HashState = hash.HashState;
type HashResult = Result(HashState, BlameError);
type HashControl = FoldControl(HashResult, HashResult);
type Field = Tuple([String, Dyn]);

def blame: Fn(Dyn, String) -> HashResult = fn(value, message) {
    'Err(blame!(message, value))
};

def logical_kind: Fn(Type) -> TypeDescKind = fn(ty) {
    match desc.kind(ty) {
        'WithAttributes => arrays.fold(desc.children(ty), 'Any, fn(ignored, child) {
            logical_kind(child)
        }),
        'Ref => match desc.resolve(ty) {
            'Ok(target) => logical_kind(target),
            'Err(_) => 'Ref,
        },
        kind => kind,
    }
};

def finish_control: Fn(HashControl) -> HashResult = fn(control) {
    match control {
        'Continue(result) => result,
        'Break(result) => result,
    }
};

def hash_items: Fn(Array(Dyn), HashState, String) -> HashResult = fn(values, state, kind) {
    let state = hash.update_string(state, kind);
    let state = hash.update_int(state, arrays.length(values));
    finish_control(arrays.fold_control@[Dyn, HashResult, HashResult](values, 'Ok(state), fn(result, value) {
        match result {
            'Err(error) => 'Break('Err(error)),
            'Ok(state) => match hash_dyn(value, state) {
                'Err(error) => 'Break('Err(error)),
                'Ok(state) => 'Continue('Ok(state)),
            },
        }
    }))
};

def hash_fields: Fn(Array(Field), HashState, String) -> HashResult = fn(fields, state, kind) {
    let state = hash.update_string(state, kind);
    let state = hash.update_int(state, arrays.length(fields));
    finish_control(arrays.fold_control@[Field, HashResult, HashResult](fields, 'Ok(state), fn(result, field) {
        match result {
            'Err(error) => 'Break('Err(error)),
            'Ok(state) => match field {
                (name, value) => {
                    let state = hash.update_string(state, name);
                    match hash_dyn(value, state) {
                        'Err(error) => 'Break('Err(error)),
                        'Ok(state) => 'Continue('Ok(state)),
                    }
                },
            },
        }
    }))
};

def hash_tagged: Fn(Dyn, HashState, String) -> HashResult = fn(value, state, kind) {
    match dyn.tag(value) {
        'Err(error) => 'Err(error),
        'Ok(tag) => {
            let state = hash.update_string(state, kind);
            let state = hash.update_string(state, tag);
            match dyn.payload(value) {
                'Err(error) => 'Err(error),
                'Ok('None) => 'Ok(hash.update_int(state, 0)),
                'Ok('Some(payload)) => {
                    let state = hash.update_int(state, 1);
                    hash_dyn(payload, state)
                },
                _ => panic!("invalid tagged payload result"),
            }
        },
    }
};

def hash_dyn: Fn(Dyn, HashState) -> HashResult = fn(value, state) {
    match logical_kind(dyn.desc(value)) {
        'Int => match dyn.check_int(value) {
            'None => blame(value, "invalid Int package"),
            'Some(number) => 'Ok(hash.update_int(hash.update_string(state, "Int"), number)),
        },
        'String => match dyn.check_string(value) {
            'None => blame(value, "invalid String package"),
            'Some(text) => 'Ok(hash.update_string(hash.update_string(state, "String"), text)),
        },
        'Bytes => match dyn.check_bytes(value) {
            'None => blame(value, "invalid Bytes package"),
            'Some(bytes) => 'Ok(hash.update_bytes(hash.update_string(state, "Bytes"), bytes)),
        },
        'Array => match dyn.array_items(value) {
            'Err(error) => 'Err(error),
            'Ok(items) => hash_items(items, state, "Array"),
        },
        'Tuple => match dyn.tuple_items(value) {
            'Err(error) => 'Err(error),
            'Ok(items) => hash_items(items, state, "Tuple"),
        },
        'Struct => match dyn.fields(value) {
            'Err(error) => 'Err(error),
            'Ok(fields) => hash_fields(fields, state, "Struct"),
        },
        'Dict => match dyn.fields(value) {
            'Err(error) => 'Err(error),
            'Ok(fields) => hash_fields(fields, state, "Dict"),
        },
        'Atom => hash_tagged(value, state, "Atom"),
        'Tagged => hash_tagged(value, state, "Tagged"),
        'Enum => hash_tagged(value, state, "Enum"),
        kind => blame(value, `unsupported my_hash descriptor: \{kind}`),
    }
};

def my_hash:
    for(A) Fn(TypeOf(A)) -> Fn(A, HashState) -> HashResult =
    interpreter!(hash_dyn);

export { my_hash, hash_dyn };
