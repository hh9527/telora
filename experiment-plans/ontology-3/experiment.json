{
  "schema": "labflow.experiment-plan/v1",
  "workspace": [
    "README.md",
    "EVAL-METHOD.md",
    "justfile",
    "control",
    "query-builder",
    "ontology",
    "ent-1",
    "intent-1",
    "query-1"
  ],
  "roles": {
    "a1": {
      "description": "通过 artifact DAG 完成 QueryBuilder。",
      "instructions": "roles/a1.md",
      "commands": [
        "labflow agent pull a1",
        "labflow agent submit a1 *",
        "./bin/telora run * -C query-builder",
        "./bin/telora run * -C query-builder *",
        "./bin/telora check * -C query-builder",
        "./bin/telora query * -C query-builder",
        "./bin/telora query * -C query-builder *",
        "rm query-builder/src/*",
        "rm query-builder/src/bin/*",
        "rm query-builder/tests/*"
      ],
      "preflight": [
        "labflow agent pull a1",
        "labflow agent submit a1 *",
        "./bin/telora run main -C query-builder",
        "./bin/telora run verify -C query-builder",
        "./bin/telora run invalid -C query-builder --best-effort",
        "./bin/telora check @test/query-builder -C query-builder",
        "./bin/telora query exports @bin/main -C query-builder"
      ]
    },
    "a2": {
      "description": "通过 artifact DAG 学习、检视并完成 EnterpriseKnowledge eDSL。",
      "instructions": "roles/a2.md",
      "commands": [
        "labflow agent pull a2",
        "labflow agent submit a2 *",
        "./bin/telora run * -C ontology",
        "./bin/telora run * -C ontology *",
        "./bin/telora check * -C ontology",
        "./bin/telora query * -C ontology",
        "./bin/telora query * -C ontology *",
        "rm ontology/src/*",
        "rm ontology/src/bin/*",
        "rm ontology/tests/*"
      ],
      "preflight": [
        "labflow agent pull a2",
        "labflow agent submit a2 *",
        "./bin/telora run main -C ontology",
        "./bin/telora run verify -C ontology",
        "./bin/telora run invalid -C ontology --best-effort",
        "./bin/telora check @test/ontology -C ontology",
        "./bin/telora query exports @bin/main -C ontology"
      ]
    },
    "a3": {
      "description": "通过 artifact DAG 学习、检视并完成 Ent-1 建模。",
      "instructions": "roles/a3.md",
      "commands": [
        "labflow agent pull a3",
        "labflow agent submit a3 *",
        "./bin/telora run * -C ent-1",
        "./bin/telora run * -C ent-1 *",
        "./bin/telora check * -C ent-1",
        "./bin/telora query * -C ent-1",
        "./bin/telora query * -C ent-1 *",
        "rm ent-1/src/*",
        "rm ent-1/src/bin/*",
        "rm ent-1/tests/*"
      ],
      "preflight": [
        "labflow agent pull a3",
        "labflow agent submit a3 *",
        "./bin/telora run main -C ent-1",
        "./bin/telora run verify -C ent-1",
        "./bin/telora run query-surface -C ent-1",
        "./bin/telora run invalid -C ent-1 --best-effort",
        "./bin/telora check @test/logistics -C ent-1",
        "./bin/telora check @test/query-surface -C ent-1",
        "./bin/telora query exports @bin/main -C ent-1"
      ]
    },
    "a4": {
      "description": "通过角色专属 just 入口验收公共 JSON 查询接口。",
      "instructions": "roles/a4.md",
      "commands": [
        "labflow agent pull a4",
        "labflow agent submit a4 *",
        "just a4",
        "just a4 *"
      ],
      "preflight": [
        "labflow agent pull a4",
        "labflow agent submit a4 *",
        "just a4",
        "just a4 make-query",
        "just a4 expect-invalid *",
        "just a4 verify"
      ]
    }
  },
  "execution": {
    "kind": "dag-mode"
  },
  "metrics": {
    "roles": {
      "a1": {
        "learning_phases": [
          "language_learning"
        ],
        "work_phase": "implementation",
        "work_files": [
          "query-builder/src/*.telora"
        ],
        "commands": {
          "telora": [
            "./bin/telora *"
          ]
        },
        "artifacts": {
          "code": {
            "core": [
              "query-builder/src/*.telora"
            ],
            "entries": [
              "query-builder/src/bin/*.telora"
            ],
            "tests": [
              "query-builder/tests/query-builder.telora"
            ]
          },
          "documents": {
            "docs": [
              "query-builder/QUERY-BUILDER-TUTORIAL.md",
              "query-builder/PUBLIC-CONTRACT.md",
              "query-builder/NOTES.md"
            ]
          }
        }
      },
      "a2": {
        "learning_phases": [
          "language_learning",
          "query_builder_draft_review"
        ],
        "work_phase": "implementation",
        "work_files": [
          "ontology/src/*.telora"
        ],
        "commands": {
          "telora": [
            "./bin/telora *"
          ]
        },
        "artifacts": {
          "code": {
            "core": [
              "ontology/src/*.telora"
            ],
            "entries": [
              "ontology/src/bin/*.telora"
            ],
            "tests": [
              "ontology/tests/ontology.telora"
            ]
          },
          "documents": {
            "docs": [
              "ontology/DSL-TUTORIAL.md",
              "ontology/PUBLIC-CONTRACT.md",
              "ontology/NOTES.md"
            ]
          }
        }
      },
      "a3": {
        "learning_phases": [
          "language_learning",
          "query_builder_draft_review",
          "query_builder_final_learning",
          "edsl_learning"
        ],
        "work_phases": [
          {
            "name": "modeling",
            "files": [
              "ent-1/src/model.telora",
              "ent-1/src/bin/main.telora"
            ]
          },
          {
            "name": "query_surface_design",
            "files": [
              "ent-1/src/query.telora",
              "ent-1/QUERY-DESIGNER-TUTORIAL.md",
              "ent-1/PUBLIC-QUERY-CONTRACT.md"
            ]
          }
        ],
        "commands": {
          "telora": [
            "./bin/telora *"
          ]
        },
        "artifacts": {
          "code": {
            "private_model": [
              "ent-1/src/model.telora"
            ],
            "public_facade": [
              "ent-1/src/query.telora"
            ],
            "entries": [
              "ent-1/src/bin/*.telora"
            ],
            "tests": [
              "ent-1/tests/*.telora"
            ]
          },
          "documents": {
            "private_docs": [
              "ent-1/UPSTREAM-FEEDBACK.md",
              "ent-1/NOTES.md"
            ],
            "public_docs": [
              "ent-1/QUERY-DESIGNER-TUTORIAL.md",
              "ent-1/PUBLIC-QUERY-CONTRACT.md"
            ]
          }
        }
      },
      "a4": {
        "learning_phases": [
          "public_query_surface_learning"
        ],
        "work_phase": "json_interface_acceptance",
        "work_files": [
          "intent-1/intent.json",
          "intent-1/invalid/*.json"
        ],
        "commands": {
          "query": [
            "just a4 *"
          ]
        },
        "artifacts": {
          "documents": {
            "requests": [
              "intent-1/intent.json",
              "intent-1/invalid/*.json"
            ],
            "docs": [
              "intent-1/FEEDBACK.md",
              "intent-1/NOTES.md"
            ]
          }
        }
      }
    }
  },
  "workflow": {
