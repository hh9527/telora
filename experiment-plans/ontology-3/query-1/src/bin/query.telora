import "ent-1/query" as enterprise;
import "std/dict" as dict;
import "std/value" { Value };

option "run-ctx.sources" ["request"];

export def main: Fn(Dict(Value)) -> Value = fn(sources) {
    let raw_intent = match dict.get(sources, "request") {
        'Some(value) => value,
        'None => fail!("missing request source"),
    };
    let response = enterprise.lower_value(raw_intent);
    'Object({
        "status": 'String("ok"),
        "intent": response.intent,
        "query": response.query,
    })
};
