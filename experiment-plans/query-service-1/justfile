set positional-arguments

a5 action="" problem_id="":
    #!/bin/sh
    set -eu
    case "$1" in
      "") echo "A5 actions: clear-ok | clear-err | make-query <ok-name>" ;;
      clear-ok) rm -f ch/out/ok-* ;;
      clear-err) rm -f ch/out/err-* ;;
      make-query)
        case "$2" in ok-[a-z0-9-]*) ;; *) echo "usage: just a5 make-query <ok-name>" >&2; exit 64 ;; esac
        test -f "ch/out/$2.json" || { echo "missing ch/out/$2.json" >&2; exit 66; }
        ./bin/telora run query -C query-1 \
          --source "request=file+json://$(pwd)/ch/out/$2.json"
        ;;
      *) echo "usage: just a5 clear-ok | clear-err | make-query <ok-name>" >&2; exit 64 ;;
    esac
