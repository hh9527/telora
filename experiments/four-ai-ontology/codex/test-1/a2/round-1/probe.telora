import "./lib.telora" { compile_capabilities, classify_paths };

@enum type ItemId = { One: 'None, Two: 'None };
@struct type Capability = { id: ItemId, value: Int };
@struct type Evidence = {
    results: Array(Option(Int)),
    values: Array(Int),
    complete: Option(Array(Int)),
};

def capability_id: Fn(Capability) -> ItemId = fn(capability) { capability.id };
def lower: Fn(Capability, ItemId, Int) -> Option(Int) = fn(capability, id, input) {
    'Some(capability.value + input)
};
def build_evidence:
    Fn(Array(Option(Int)), Array(Int), Option(Array(Int))) -> Evidence =
    fn(results, values, complete) { {results, values, complete} };

@enum type Node = { Base: 'None, Region: 'None, Detail: 'None, Lost: 'None };
@struct type Edge = { from: Node, to: Node };
@struct type Paths = {
    selected: Array(Edge),
    fanout_only: Array(Node),
    missing: Array(Node),
};
def edge_from: Fn(Edge) -> Node = fn(edge) { edge.from };
def edge_to: Fn(Edge) -> Node = fn(edge) { edge.to };
def build_paths: Fn(Array(Edge), Array(Node), Array(Node)) -> Paths =
    fn(selected, fanout_only, missing) { {selected, fanout_only, missing} };
def base: Node = 'Base;
def required: Array(Node) = ['Region, 'Detail, 'Lost];
def safe_edges: Array(Edge) = [{from: 'Base, to: 'Region}];
def fanout_edges: Array(Edge) = [{from: 'Region, to: 'Detail}];

export let evidence = compile_capabilities(
    ['One, 'Two],
    [{id: 'One, value: 10}, {id: 'Two, value: 20}],
    capability_id,
    lower,
    1,
    build_evidence,
);

export let paths = classify_paths(
    base,
    required,
    safe_edges,
    fanout_edges,
    edge_from,
    edge_to,
    build_paths,
);

export let output = evidence;
