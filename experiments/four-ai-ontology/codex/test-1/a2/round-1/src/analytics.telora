import "./capabilities.telora" { compile_capabilities };
import "./relationships.telora" { classify_paths, report_relationship_errors };
import "std/array" as array;

def compile_analytics:
    for(
        MeasureId, MeasureCapability, MeasureInput, MeasureOutput, MeasureEvidence,
        DimensionId, DimensionCapability, DimensionInput, DimensionOutput, DimensionEvidence,
        CombinedMeasure, Node, Edge, Requirement, Subject, PathEvidence, Plan,
    )
    Fn(
        Array(MeasureId), Array(MeasureCapability), Fn(MeasureCapability) -> MeasureId,
        Fn(MeasureCapability, MeasureId, MeasureInput) -> Option(MeasureOutput), MeasureInput,
        Fn(Array(Option(MeasureOutput)), Array(MeasureOutput), Option(Array(MeasureOutput))) -> MeasureEvidence,
        Fn(MeasureEvidence) -> Array(MeasureOutput),
        Fn(MeasureEvidence) -> Option(Array(MeasureOutput)),

        Array(DimensionId), Array(DimensionCapability), Fn(DimensionCapability) -> DimensionId,
        Fn(DimensionCapability, DimensionId, DimensionInput) -> Option(DimensionOutput), DimensionInput,
        Fn(Array(Option(DimensionOutput)), Array(DimensionOutput), Option(Array(DimensionOutput))) -> DimensionEvidence,
        Fn(DimensionEvidence) -> Array(DimensionOutput),
        Fn(DimensionEvidence) -> Option(Array(DimensionOutput)),

        Fn(Array(MeasureOutput)) -> Option(CombinedMeasure),
        Fn(CombinedMeasure) -> Node,
        Fn(CombinedMeasure) -> Array(Node),
        Fn(DimensionOutput) -> Node,
        Array(Node),

        Array(Edge), Array(Edge), Fn(Edge) -> Node, Fn(Edge) -> Node,
        Array(Requirement), Fn(Requirement) -> Node, Fn(Requirement) -> Subject,
        Fn(Array(Edge), Array(Node), Array(Node)) -> PathEvidence,
        Fn(PathEvidence) -> Array(Edge), Fn(PathEvidence) -> Array(Node), Fn(PathEvidence) -> Array(Node),

        Fn(CombinedMeasure, Array(DimensionOutput), Array(Edge)) -> Option(Plan),
    ) -> Option(Plan) =
    fn(
        measure_ids, measure_catalog, measure_id, lower_measure, measure_input,
        build_measure_evidence, measure_values_of, measure_complete_of,
        dimension_ids, dimension_catalog, dimension_id, lower_dimension, dimension_input,
        build_dimension_evidence, dimension_values_of, dimension_complete_of,
        combine_measures, base_node_of, measure_nodes_of, dimension_node_of, extra_nodes,
        safe_edges, fanout_edges, edge_from, edge_to,
        requirements, requirement_node, requirement_subject,
        build_path_evidence, selected_edges_of, fanout_nodes_of, missing_nodes_of,
        build_plan,
    ) {
        let measure_evidence = compile_capabilities(
            measure_ids, measure_catalog, measure_id, lower_measure, measure_input,
            build_measure_evidence,
        );
        let dimension_evidence = compile_capabilities(
            dimension_ids, dimension_catalog, dimension_id, lower_dimension, dimension_input,
            build_dimension_evidence,
        );
        let measure_values = measure_values_of(measure_evidence);
        let dimension_values = dimension_values_of(dimension_evidence);
        let combined = combine_measures(measure_values);

        match combined {
            'None => 'None,
            'Some(combined_measure) => {
                let dimension_nodes = array.map(dimension_values, dimension_node_of);
                let required_nodes = array.concat([
                    measure_nodes_of(combined_measure), dimension_nodes, extra_nodes,
                ]);
                let paths = classify_paths(
                    base_node_of(combined_measure), required_nodes,
                    safe_edges, fanout_edges, edge_from, edge_to, build_path_evidence,
                );
                let relationships_valid = report_relationship_errors(
                    fanout_nodes_of(paths), missing_nodes_of(paths),
                    requirements, requirement_node, requirement_subject,
                );
                let candidate = build_plan(
                    combined_measure, dimension_values, selected_edges_of(paths),
                );
                match measure_complete_of(measure_evidence) {
                    'None => 'None,
                    'Some(complete_measures) => match dimension_complete_of(dimension_evidence) {
                        'None => 'None,
                        'Some(complete_dimensions) => {
                            if relationships_valid {
                                candidate
                            } else {
                                'None
                            }
                        },
                    },
                }
            },
        }
    };

export { compile_analytics };
