export def MeasureDefinition:
    for(Id, Value, Granularity, Aggregation, Input, Output)
    Fn(
        TypeOf(Id),
        TypeOf(Value),
        TypeOf(Granularity),
        TypeOf(Aggregation),
        TypeOf(Input),
        TypeOf(Output)
    ) -> Type =
    fn(Id, Value, Granularity, Aggregation, Input, Output) {
        struct('None, {
            id: Id,
            valueType: Value,
            granularity: Granularity,
            aggregation: Aggregation,
            lower: Fn(Id, Input) -> Option(Output),
        })
    };

export def DimensionDefinition:
    for(Id, Input, Payload)
    Fn(TypeOf(Id), TypeOf(Input), TypeOf(Payload)) -> Type =
    fn(Id, Input, Payload) {
        struct('None, {
            id: Id,
            lower: Fn(Id, Input) -> Option(Payload),
        })
    };

export def RelationDefinition:
    for(From, To, Cardinality, Mapping)
    Fn(TypeOf(From), TypeOf(To), TypeOf(Cardinality), TypeOf(Mapping)) -> Type =
    fn(From, To, Cardinality, Mapping) {
        struct('None, {
            from: From,
            to: To,
            cardinality: Cardinality,
            mapping: Mapping,
        })
    };
