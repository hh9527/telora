# Attack probes — 边界试探（攻击者视角）
# 目的：探测编译门是否可被绕过 / 是否有意外放行。全部通过 model.compile 发起。
import "flight-model/model.telora" as model;

export let output = [
    # 1) 空请求数组 —— 库门逻辑：complete(0==0)=Some([])，targets 为空，
    #    无 fan-out / 未授权 / 不可达 → buildPlan 直接返回 'Some(空粒度计划)。
    #    预期：lowered，返回带空 granularities 的计划。攻击者判断：这是"空请求也发布计划"的
    #    边界气味——不授予任何数据，但说明门不要求"至少一个能力意图"。
    model.compile([]),

    # 2) 重复请求：FlightCount 出现两次
    #    两个 cap 都 lowering 成功，requirements 会 flat_map 出两份 At(Flight)，
    #    granularities 会出现重复的 Flight。预期：lowered（计划带重复粒度）。
    #    攻击者判断：不做去重，属鲁棒性小缺口，非安全绕过。
    model.compile(['FlightCount, 'FlightCount]),

    # 3) 重复 + 未授权叠加：AirlineName 出现两次
    #    仍映射到两份 At(Airline)，Airline 不在 allowed → 整次 refused。
    #    预期：refused（未授权）。攻击者判断：原子发布正确地把重复未授权一并拒绝。
    model.compile(['AirlineName, 'AirlineName]),

    # 4) Boardings + FlightCount（Boardings 合法降级后其粒度 Seat 仍触发 fan-out 门）
    #    预期：refused（粒度扩张）。攻击者判断：fan-out 门由企业 buildPlan 兜底，
    #    库门只诊断 fan-out-only、不阻断；若企业不在 buildPlan 拦截，Seat 粒度会漏出。
    #    此探针验证企业兜底确实生效。
    model.compile(['Boardings, 'FlightCount]),
];
