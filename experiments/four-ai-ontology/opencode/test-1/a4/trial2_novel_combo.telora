# Trial 2 — 合法新奇组合
# 目的：PUBLIC_INTENT 未直接列出、但由已公开概念（度量+维度+维度）组合出来的合法查询。
# 预期：全部 lowered。
import "flight-model/model.telora" as model;

export let output = [
    # 双维度 + 度量：航班量按 起点 x 机型 分组
    # 需求粒度：Flight, Route, Airport, Aircraft —— 全部安全可达、已授权。预期：lowered
    model.compile(['FlightCount, 'RouteOrigin, 'AircraftType]),

    # 只请求两个维度，不带度量：RouteOrigin + AircraftType
    # 需求粒度：Route, Airport, Aircraft —— 全部安全可达、已授权。预期：lowered
    model.compile(['RouteOrigin, 'AircraftType]),

    # 单维度：只按机型（无 FlightCount 度量）
    # 需求粒度：Aircraft —— 安全可达、已授权。预期：lowered
    model.compile(['AircraftType]),

    # 请求顺序交换（AircraftType + FlightCount）—— 组合规则与顺序无关。预期：lowered
    model.compile(['AircraftType, 'FlightCount]),
];
