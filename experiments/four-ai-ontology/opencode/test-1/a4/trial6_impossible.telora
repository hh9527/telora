# Trial 6 — 不可能请求
# 目的：组合了多个概念、在语义上根本无法成立的请求。拒绝是正确的。
# 每种组合都叠加多重越界（缺失能力 + 粒度扩张 + 未授权），原子发布应整体拒绝。
# 预期：全部 refused。
import "flight-model/model.telora" as model;

export let output = [
    # Revenue(未知能力) + Boardings(粒度扩张) + AirlineName(未授权)
    # 三重重罪同场，整次编译必然失败。预期：refused
    model.compile(['Revenue, 'Boardings, 'AirlineName]),

    # Boardings(粒度扩张) + AirlineName(未授权)
    # 登机数按航空公司统计——既扩张又未授权，无法成立。预期：refused
    model.compile(['Boardings, 'AirlineName]),

    # 空请求数组：不请求任何能力。语义上"什么问题都没问"。
    # 注意：完整数组（0==0），无 fan-out/未授权/不可达目标，
    # 且所有 targets 均可达 → buildPlan 会返回 'Some(空粒度计划)。
    # 攻击者判断：这可能是边界可绕过的信号 —— 空请求也会拿到一个（空的）计划。
    # 预期（按库实现）：lowered，返回带空 granularities 的 'Some(plan)
    model.compile([]),
];
