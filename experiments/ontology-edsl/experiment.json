{
  "schema": "telora.opencode-experiment/v1",
  "prompts": {
    "start": "请完整阅读 `a1/TASK-A2.md`，然后完成其中定义的任务。",
    "continue": "请继续。",
    "feedback": "请阅读 `a2/feedback.md` 中的反馈，根据反馈继续改进并验证结果。"
  },
  "workspace": {
    "template": "opencode-workspace",
    "copies": [
      {"from": "TASK-A2.md", "to": "a1/TASK-A2.md", "mode": "0444"},
      {"from": "TELORA-TUTORIAL.md", "to": "a1/TELORA-TUTORIAL.md", "mode": "0444"},
      {"from": "TELORA-CLI.md", "to": "a1/TELORA-CLI.md", "mode": "0444"},
      {"from": "EDSL-DESIGN.md", "to": "a1/EDSL-DESIGN.md", "mode": "0444"},
      {"from": "opencode-workspace/a2/telora-deps.json", "to": "a2/telora-deps.json", "mode": "0444"},
      {"from": "opencode-workspace/bin/run", "to": "bin/run", "mode": "0555"},
      {"from": "opencode-workspace/bin/run-test", "to": "bin/run-test", "mode": "0555"},
      {"from": "opencode-workspace/bin/types", "to": "bin/types", "mode": "0555"},
      {"from": "opencode-workspace/bin/show", "to": "bin/show", "mode": "0555"}
    ]
  },
  "permissions": {
    "read": ["a1/**", "a2/**"],
    "write": ["a2/src/**", "a2/bin-src/**", "a2/EDSL_TUTORIAL.md", "a2/AI3_CONTRACT.md", "a2/STAGE2_NOTES.md"],
    "commands": ["./bin/run", "./bin/run-test", "./bin/types", "./bin/show"]
  },
  "feedback": {"path": "a2/feedback.md", "role_writable": false},
  "artifacts": [
    {
      "name": "telora",
      "source": "target/debug/telora",
      "to": "bin/telora",
      "build": ["cargo", "build", "-p", "telora"],
      "mode": "0555"
    }
  ],
  "validation": [
    {"name": "run", "command": ["./bin/run"], "required": true},
    {"name": "run-test", "command": ["./bin/run-test"], "required": true},
    {"name": "types", "command": ["./bin/types"], "required": true},
    {"name": "show", "command": ["./bin/show"], "required": true}
  ],
  "observe": ["a2"],
  "archive": ["a1", "a2", "opencode.json"]
}
