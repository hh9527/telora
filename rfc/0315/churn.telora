use std::array as array;
use std::string as string;
type Item = struct { name: String, children: Array(String) };
def iterate: Fn(Int, Item) -> Item = fn(count, item) {
    if count == 0 { item } else {
        let next: Item = {
            name: string::join([item.name, ""], ""),
            children: array::map(item.children, fn(child) { string::join([child, ""], "") }),
        };
        iterate(count - 1, next)
    }
};
def answer: Fn(Int) -> Item = fn(count) {
    iterate(count, { name: "a repeated live name that needs non-inline content", children: ["first child needing a content slice", "second child needing a content slice"] })
};

use std::transform_service as service;
use std::codec as codec;
use std::value::{Value};
type Model = struct { value: Item };
impl service::TransformService for Model {
    init: fn(ctx) { {value: answer(10000)}.ty!(Self) },
    transform: fn(self, input) { codec::encode(self.value) },
};
@service::collection
pub type MainService = struct { @service::slot("bench") model: Model };
