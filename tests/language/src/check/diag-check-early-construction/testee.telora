import "std/array" as array;
@check(fn(value) {
    if value.x > 0 { Ok(()) } else { Err(blame!("early candidate rejected", value.x)) }
})
type Point = struct {x: Int};
type Chosen = Tuple(array.map([Int], fn(item) {
    let candidate: Point = {x: 0};
    if candidate.x == 0 { item } else { item }
}));
export def value = 2;
