def same: for(T) Fn(T, T) -> T = fn(a, b) { a };
pub def good: Int = same(1, 2);
pub def input: String = "bad";
pub def wrong: Int = same(1, input);
pub def broken_body: Fn(Int) -> Int = fn(value) { "wrong result" };
def identity: for(T) Fn(T) -> T = fn(value) { value };
def inferred: String = identity("healthy");
