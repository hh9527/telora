type Box(T) = struct { item: T };
trait Show { show: Fn(Self) -> String };
impl(T) Show for Box(T) {
    show: fn(value) {
        let next: Box(Array(T)) = { item: [value.item] };
        Show.show(next)
    },
};
export def entry: Fn(Box(Int)) -> String = fn(value: Box(Int)) { Show.show(value) };
