use crate::support as support;
use std::value::{Value};
use crate::unknown_support::{unknown_at};

pub def check: Fn(Value) -> Value = fn(actual) {
    support::bool_value(unknown_at(actual, "language-tests/check/diag-module-cycle/testee/a", 2)
        && unknown_at(actual, "language-tests/check/diag-module-cycle/testee/b", 2))
};
