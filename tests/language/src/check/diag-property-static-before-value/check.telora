use std::array as array;
use std::value::{Value};
use crate::support as support;

pub def check: Fn(Value) -> Value = fn(actual) {
    let skipped_execution = match support::record_field(actual, "stdout") {
        Some(Value::Array(items)) => array::fold(items, False, fn(found, item) {
            found || (support::string_field_equals(item, "record", "summary")
                && match support::record_field(item, "execution_seconds") {
                    Some(Value::Float(seconds)) => seconds == 0.0,
                    Some(Value::Int(seconds)) => seconds == 0,
                    _ => False,
                })
        }),
        _ => False,
    };
    support::bool_value(skipped_execution
        && support::failed_with(actual, "type mismatch between String and Int")
        && !support::failed_with(actual, "property provider must not run before static checking"))
};
