use std::blame::{BlameError};

pub def warning: for(T) Fn(String) -> Option(T) = fn(error) { warn!(error) };
pub def warning_blame: for(T) Fn(BlameError) -> Option(T) = fn(error) { warn!(error) };
pub def failure: for(T) Fn(String) -> T = fn(error) { raise!(error) };
pub def failure_blame: Fn(BlameError) -> Never = fn(error) { raise!(error) };
pub def unwrap_string: for(T) Fn(Result(T, String)) -> T = fn(result) { result.unwrap!() };
pub def optional_blame: for(T) Fn(Result(T, BlameError)) -> Option(T) = fn(result) { result.ok_or_warn!() };
