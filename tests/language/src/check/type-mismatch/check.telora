import "@src/support" as support;
import "std/value" { Value };

export def check: Fn(Value) -> Value = fn(actual) {
    let diagnostic: Value = match support.stream_item(actual, "stdout", 0) {
        'Some(value) => value,
        'None => 'None,
    };
    if support.exit_code(actual) == 'Some(1)
        && support.string_field_equals(diagnostic, "record", "diagnostic")
        && support.string_field_equals(diagnostic, "severity", "error")
        && support.string_field_contains(diagnostic, "message", "String")
        && support.string_field_contains(diagnostic, "message", "Int")
        && support.stream_length(actual, "stderr") == 'Some(0) {
        'True
    } else {
        'False
    }
};
