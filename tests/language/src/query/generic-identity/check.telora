import "@src/support" as support;
import "std/value" { Value };

export def check: Fn(Value) -> Value = fn(actual) {
    let exported: Value = match support.stream_item(actual, "stdout", 0) {
        'Some(value) => value,
        'None => 'None,
    };
    if support.exit_code(actual) == 'Some(0)
        && support.string_field_equals(exported, "name", "identity")
        && support.string_field_equals(exported, "type", "for(A) Fn(A) -> A")
        && support.stream_length(actual, "stderr") == 'Some(0) {
        'True
    } else {
        'False
    }
};
