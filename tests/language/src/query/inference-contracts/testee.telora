import "std/value" {Value};
import "std/dyn" as dyn;
def apply: for(A, B) Fn(Fn(A) -> B, A) -> B = fn(callback, value) { callback(value) };

def select: for(A) Fn(Bool, A) -> A = fn(condition, value) {
    if condition { value } else { value }
};

def add_left: Fn(Int) -> Int = fn(value) { value + 1 };
def add_right: Fn(Int) -> Int = fn(value) { 1 + value };
def scale: Fn(Float) -> Float = fn(value) { value * 1.5 };
def before_int: Fn(Int) -> Bool = fn(value) { value < 1 };
def before_string: Fn(String) -> Bool = fn(value) { value < "z" };
def invert_bool: Fn(Bool) -> Bool = fn(value) { !value };
def invert_int: Fn(Int) -> Int = fn(value) { !value };

type Scalar = enum {Integer(Int), Text(String)};
def branch_left: Scalar = if True { Scalar.Integer(1) } else { Scalar.Text("x") };
def branch_right: Scalar = if True { Scalar.Text("x") } else { Scalar.Integer(1) };
def branch_nested: Scalar = (if True { if False { Scalar.Integer(1) } else { Scalar.Text("x") } } else { Scalar.Integer(1) }).ty!(Scalar);
def branch_three: Scalar = (if True { if False { Scalar.Integer(1) } else { Scalar.Text("x") } } else { Scalar.Integer(2) }).ty!(Scalar);
def metadata_branch: Type = if True { (Int).type } else { (String).type };

type RecordKind = enum {Full, Empty, First, Second, Third, Ints, Strings};
type Record = struct {kind: RecordKind, path: Array(Int)};
def choose_record: Fn(Bool) -> Record = fn(flag) {
    if flag {
        {kind: RecordKind.Full, path: [1]}
    } else {
        {kind: RecordKind.Empty, path: []}
    }
};

def choose_match: Fn(Int) -> Record = fn(value) {
    match value {
        0 => {kind: RecordKind.First, path: []},
        1 => {kind: RecordKind.Second, path: [1]},
        2 => {kind: RecordKind.Third, path: []},
    }
};

type Path = struct {path: Array(Int)};
def choose_nested: Fn(Bool) -> Option(Tuple([Path])) = fn(flag) {
    if flag { Some(({path: []},)) } else { Some(({path: [1]},)) }
};

def choose_conflict: Fn(Int) -> Record = fn(value) {
    match value {
        0 => {kind: RecordKind.Empty, path: []},
        1 => {kind: RecordKind.Ints, path: [1]},
        2 => {kind: RecordKind.Strings, path: [2]},
    }
};

def add_partial: Fn(Int, Int) -> Int = fn(value: Int, other) { value + other };
def add_result: Fn(Int) -> Int = fn(value) -> Int { value + 1 };
def decorate: for(A) Fn(A, Int) -> Int = fn(ctx, value) -> Int { value + 1 };
def nested_partial: Fn(Int) -> Fn(Int) -> Int = fn(value: Int) {
    fn(other: Int) -> Int { value + other }
};

def explicit_pair: for(A, B) Fn(A, B) -> Tuple([A, B]) = fn(left, right) {
    (left, right)
};
def explicit_pair_value: (Int, String) = explicit_pair@[Int, String](1, "x");
def partial_pair_value: (Int, String) = explicit_pair@[Int, _](1, "x");

def countdown: Fn(Int) -> Int = fn(value) {
    if value < 1 { 0 } else { countdown(value - 1) }
};
def even: Fn(Int) -> Bool = fn(value) -> Bool {
    if value < 1 { True } else { odd(value - 1) }
};
def odd: Fn(Int) -> Bool = fn(value) -> Bool {
    if value < 1 { False } else { even(value - 1) }
};

def polymorphic_identity: for(A) Fn(A) -> A = fn(value) { value };
def polymorphic_keep: for(A) Fn(Int, A) -> (Int, A) = fn(left: Int, right) { (left, right) };
def nested_constraints: Fn(Int) -> Fn(Int) -> Int = fn(left) { fn(right) { left + right + 1 } };

def array_union: Array(Scalar) = [Scalar.Integer(1), Scalar.Text("x")];
def array_dynamic: Array(Value) = [Value.Int(1), Value.String("x")];
def dict_union: Dict(Scalar) = {
    let ints: Dict(Scalar) = {a: Scalar.Integer(1)};
    let strings: Dict(Scalar) = {b: Scalar.Text("x")};
    {...ints, ...strings}
};
def field_projection: (Int, String, Int, Dyn) = {
    let record: Dict(Int) = {value: 1};
    let dictionary: Dict(String) = {value: "x"};
    let alternative: Dict(Int) = if True { {value: 1} } else { {value: 2} };
    let dynamic = dyn.pack((Int).type, record.value);
    (record.value, dictionary.value, alternative.value, dynamic)
};

def stop: Fn() -> Never = fn() { fail!("stop") };
def never_branch: Int = if True { 1 } else { stop() };
def all_never: Never = if True { stop() } else { stop() };
def never_array: Array(Int) = [stop(), 1];

def compose: for(A, B, C) Fn(Fn(A) -> B, Fn(C) -> A, C) -> B = fn(outer, inner, value) { outer(inner(value)) };
def invoke_factory: for(A) Fn(Fn() -> Fn() -> A) -> A = fn(factory) { factory()() };
def recover: for(A) Fn(Fn() -> A) -> A = fn(callback) { callback() };
def repeated_callback: for(A) Fn(Fn(Int) -> A) -> (A, A) = fn(callback) { (callback(1), callback(2)) };

def metadata_values: (TypeOf(Type), TypeOf(Int), TypeOf(Array(Int))) = ((Type).type, (Int).type, (Array(Int)).type);
type Function = Int;
def domain_function: Function = 1;

export {
    apply,
    select,
    add_left,
    add_right,
    scale,
    before_int,
    before_string,
    invert_bool,
    invert_int,
    branch_left,
    branch_right,
    branch_nested,
    branch_three,
    metadata_branch,
    choose_record,
    choose_match,
    choose_nested,
    choose_conflict,
    add_partial,
    add_result,
    decorate,
    nested_partial,
    explicit_pair,
    explicit_pair_value,
    partial_pair_value,
    countdown,
    even,
    odd,
    polymorphic_identity,
    polymorphic_keep,
    nested_constraints,
    array_union,
    array_dynamic,
    dict_union,
    field_projection,
    stop,
    never_branch,
    all_never,
    never_array,
    compose,
    invoke_factory,
    recover,
    repeated_callback,
    metadata_values,
    Function,
    domain_function,
};
