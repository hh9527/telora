use crate::support as support;
use std::value::{Value};

pub def check: Fn(Value) -> Value = fn(actual) {
    match support::stream_item(actual, "stdout", 0) {
        Some(value) => support::bool_value(
            support::exit_code(actual) == Some(0)
                && support::string_field_equals(value, "name", "updated")
                && support::string_field_equals(value, "type", "Base")
                && support::stream_length(actual, "stderr") == Some(0)),
        _ => Value::False,
    }
};
