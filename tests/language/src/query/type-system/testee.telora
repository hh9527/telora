def identity: for(A) Fn(A) -> A = fn(value) { value };
def keep: for(A) Fn(Int, A) -> (Int, A) = fn(left: Int, right) { (left, right) };
def nested: Fn(Int) -> Fn(Int) -> Int = fn(left) { fn(right) { left + right + 1 } };
def recursive: Fn(Int) -> Int = fn(value) {
    if value < 1 { 0 } else { recursive(value - 1) }
};
def recursive_result: Int = recursive(3);

type Box(A) = struct {value: A};
type Tree(A) = enum {Leaf(A), Branch(Array(Tree(A)))};
type IntTree = Tree(Int);

def collect: for(N, M)
    Fn(Array(Box(Tuple([N, M])))) -> Array(Box(Tuple([N, M]))) = fn(items) {
        items
    };

pub use self::{identity, keep, nested, recursive, recursive_result, Box, Tree, IntTree, collect};
