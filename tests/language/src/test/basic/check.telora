import "@src/support" as support;
import "std/value" { Value };

export def check: Fn(Value) -> Value = fn(actual) {
    match support.stream_item(actual, "stdout", 5) {
        Some(Value.Object(summary)) => if support.succeeded(actual)
            && support.stream_length(actual, "stdout") == Some(6)
            && summary.schema == Value.String("telora.test/v2")
            && summary.total == Value.Int(5) && summary.passed == Value.Int(5)
            && summary.failed == Value.Int(0) && summary.aborted == Value.False { Value.True } else { Value.False },
        _ => Value.False,
    }
};
