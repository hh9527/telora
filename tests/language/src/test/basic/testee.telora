use std::test as test;
use std::dyn as dyn;

pub def a_false: test::Test = test::should_ok(fn() { False.ty!(Bool) });
pub def b_error_value: test::Test = test::should_ok(fn() { Err("ordinary return").ty!(Result(Int, String)) });
pub def c_failure: test::Test = test::should_fail(fn() { fail!("expected failure") });
pub def d_message: test::Test = test::should_fail_with(fn() { fail!("specific message") }, "specific");
pub def e_opaque: test::Test = test::should_ok(fn() { test::should_fail(fn() { 1 }) });
pub def helper: Fn() -> Int = fn() { fail!("must remain uncalled") };
pub def ignored: Array(test::Test) = [test::should_fail(fn() { 1 })];
pub def erased: Dyn = dyn::pack(test::Test.type, test::should_fail(fn() { 1 }));
type Lookalike = struct {kind: String, thunk: Fn() -> Never};
pub def lookalike: Lookalike = { kind: "should_ok", thunk: fn() { fail!("not a Test") } };
