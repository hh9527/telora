import "@src/support" as support;
import "std/array" as array;
import "std/value" {Value};

export def check: Fn(Value) -> Value = fn(actual) {
    match support.record_field(actual, "stdout") {
        Some(Value.Array(records)) => {
            let located = fn(message, line, column) {
                array.any(records, fn(record) {
                    support.string_field_equals(record, "record", "diagnostic")
                        && support.string_field_equals(record, "test", "source")
                        && match support.record_field(record, "labels") {
                            Some(Value.Array(labels)) => array.any(labels, fn(label) {
                                support.string_field_contains(label, "source", "blame-error/provider")
                                    && support.string_field_equals(label, "message", message)
                                    && match support.record_field(label, "location") {
                                        Some(location) => support.record_field(location, "line") == Some(Value.Int(line))
                                            && support.record_field(location, "column") == Some(Value.Int(column)),
                                        _ => False,
                                    }
                            }),
                            _ => False,
                        }
                })
            };
            support.bool_value(support.exit_code(actual) == Some(1)
                && array.length(array.filter(records, fn(record) {
                    support.string_field_equals(record, "record", "diagnostic")
                })) == 3
                && array.length(array.filter(records, fn(record) {
                    support.string_field_equals(record, "severity", "warning")
                })) == 2
                && located("subject 1 originated here", 3, 19)
                && located("subject 2 originated here", 4, 20)
                && array.any(records, fn(record) {
                    support.string_field_equals(record, "record", "summary")
                        && support.record_field(record, "passed") == Some(Value.Int(3))
                        && support.record_field(record, "failed") == Some(Value.Int(1))
                }))
        },
        _ => Value.False,
    }
};
