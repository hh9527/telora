import "std/test" as test;
import "@src/test-support" {expect};

@check(fn(value) {
    if value.x > 0 { None } else { Some(blame!("positive x required", value.x)) }
})
type Point = struct {x: Int};
type Container = struct {point: Point};

export def accepted = test.should_ok(fn() {
    expect(match {x: 2}.cast!(Point) { Ok(point) => point.x == 2, Err(_) => False })
});
export def rejected = test.should_fail_with(fn() {
    {x: 0}.cast!(Point)
}, "positive x required");
export def nested_rejected = test.should_fail_with(fn() {
    {point: {x: 0}}.cast!(Container)
}, "positive x required");
export def array_rejected = test.should_fail_with(fn() {
    [{x: 2}, {x: 0}].cast!(Array(Point))
}, "positive x required");
export def shape_mismatch = test.should_ok(fn() {
    expect(match {x: "wrong"}.cast!(Point) { Ok(_) => False, Err(_) => True })
});
export def unchecked_accepted = test.should_ok(fn() {
    let candidate: Unchecked(Point) = {x: 2};
    expect(match candidate.cast!(Point) { Ok(point) => point.x == 2, Err(_) => False })
});
export def unchecked_rejected = test.should_fail_with(fn() {
    let candidate: Unchecked(Point) = {x: 0};
    candidate.cast!(Point)
}, "positive x required");
