use std::test as test;
use std::json as json;
use crate::test_support::{expect};
use self::provider::{Range, Nonnegative, Bounded, Stopped, Aborting, invalid_min};

pub def successful_candidate: test::Test = test::should_ok(fn() {
    let value: Range = {min: 2, max: 9};
    expect(value.min == 2 && value.max == 9
        && Nonnegative(3).0 == 3 && Bounded(10).0 == 10)
});
pub def first_helper: test::Test = test::should_fail_with(fn() {
    let value: Range = {min: invalid_min, max: 11};
    value
}, "nonnegative required");
pub def second_helper: test::Test = test::should_fail_with(fn() {
    let value: Range = {min: 1, max: 11};
    value
}, "maximum exceeded");
pub def final_rule: test::Test = test::should_fail_with(fn() {
    let value: Range = {min: 4, max: 3};
    value
}, "invalid range");
pub def short_circuit: test::Test = test::should_fail_with(fn() { Stopped(1) }, "first rejection");
pub def never_tail: test::Test = test::should_fail_with(fn() {
    Aborting(1)
}, "checker aborted after successful helper");
pub def codec_success: test::Test = test::should_ok(fn() {
    expect(match json::decode@[Range]("{\"min\":2,\"max\":9}") {
        Ok(value) => value.min == 2 && value.max == 9,
        Err(_) => False,
    })
});
pub def codec_rejection: test::Test = test::should_ok(fn() {
    expect(match json::decode@[Range]("{\"min\":-7,\"max\":11}") {
        Ok(_) => False, Err(_) => True,
    })
});
pub def codec_short_circuit: test::Test = test::should_ok(fn() {
    expect(match json::decode@[Stopped]("1") { Ok(_) => False, Err(_) => True })
});
