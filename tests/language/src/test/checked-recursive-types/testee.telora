use std::test as test;
use std::json as json;
use std::codec as codec;
use std::dyn as dyn;
use self::reexport::{Tree, rebuild};
use crate::test_support::{expect};

pub def rebuilt: test::Test = test::should_ok(fn() {
    let tree: Tree(String) = {value: "root", rank: 2, children: [
        {value: "leaf", rank: 1, children: []},
    ]};
    let copy = rebuild(tree);
    expect(copy == tree && dyn::project_with((Tree(String)).type, dyn::pack((Tree(String)).type, copy)) == Some(tree))
});
pub def parent_rejected: test::Test = test::should_fail_with(fn() {
    let tree: Tree(String) = {value: "root", rank: 1, children: [
        {value: "leaf", rank: 1, children: []},
    ]};
    tree
}, "child rank must decrease");
pub def decoded: test::Test = test::should_ok(fn() {
    let text = "{\"value\":\"root\",\"rank\":2,\"children\":[{\"value\":\"leaf\",\"rank\":1,\"children\":[]}]}";
    let tree = match json::decode@[(Tree(String))](text) { Ok(value) => value, Err(error) => raise!(error) };
    expect(rebuild(tree) == tree && codec::encode(tree) == match json::parse(text) {
        Ok(value) => value, Err(error) => raise!(error),
    })
});
pub def decode_rejected: test::Test = test::should_ok(fn() {
    expect(match json::decode@[(Tree(String))]("{\"value\":\"root\",\"rank\":0,\"children\":[{\"value\":\"leaf\",\"rank\":1,\"children\":[]}]}") {
        Ok(_) => False, Err(_) => True,
    })
});
pub def candidate: test::Test = test::should_ok(fn() {
    let candidate: Unchecked(Tree(String)) = {value: "root", rank: 1, children: []};
    let tree = rebuild(candidate);
    expect(tree.rank == 1)
});
