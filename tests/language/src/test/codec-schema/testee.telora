import "std/codec" as codec;
import "std/dict" as dict;
import "std/json" as json;
import "std/result" as results;
import "std/string" as string;
import "std/toml" as toml;
import "std/yaml" as yaml;
import "std/test" as test;
import "@src/test-support" {expect};

type User = struct {name: String, age: Int};
type Model = struct {
    users: Array(User),
    labels: Dict(String),
    selected: Option(User),
};
type Node = struct {value: Int, children: Array(Node)};

export def verified_case = test.should_ok(fn() {
    let user: User = {name: "Ada", age: 36};
    let model: Model = {
        users: [user],
        labels: {role: "admin"},
        selected: Some(user),
    };
    let node: Node = {value: 1, children: [{value: 2, children: []}]};
    let encoded_user = codec.encode((codec.Value).type, user);
    let encoded_model = codec.encode((codec.Value).type, model);
    let encoded_node = codec.encode((codec.Value).type, node);
    let decoded_user = codec.decode((User).type, encoded_user).unwrap!();
    let decoded_model = codec.decode((Model).type, encoded_model).unwrap!();
    let decoded_node = codec.decode((Node).type, encoded_node).unwrap!();
    let model_schema = json.schema((Model).type);
    let node_schema = json.schema((Node).type);
    let model_schema_text = json.stringify(model_schema);
    let node_schema_text = json.stringify(node_schema);
    let parsed_json = json.parse("{\"name\":\"Ada\",\"age\":36}").unwrap!();
    let parsed_toml = toml.parse("name = \"Ada\"\nage = 36\n").unwrap!();
    let parsed_yaml = yaml.parse("name: Ada\nage: 36\n").unwrap!();
    let verified = decoded_user == user
        && decoded_model == model
        && decoded_node == node
        && codec.decode((User).type, parsed_json) == Ok(user)
        && codec.decode((User).type, parsed_toml) == Ok(user)
        && codec.decode((User).type, parsed_yaml) == Ok(user)
        && !results.is_ok(codec.decode((User).type, codec.Value.Object({name: codec.Value.String("Ada")})))
        && !results.is_ok(codec.decode((User).type, codec.Value.Object({
            name: codec.Value.String("Ada"),
            age: codec.Value.String("old"),
        })))
        && dict.keys(model.labels) == ["role"]
        && string.contains(model_schema_text, "properties")
        && string.contains(model_schema_text, "users")
        && string.contains(node_schema_text, "$defs")
        && string.contains(node_schema_text, "$ref")
        && json.stringify(encoded_user) == "{\"age\":36,\"name\":\"Ada\"}"
        && (json.stringify_pretty(2))(encoded_user)
            == "{\n  \"age\": 36,\n  \"name\": \"Ada\"\n}";
    expect(verified)
});
