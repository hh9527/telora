use std::codec as codec;
use std::dict as dict;
use std::json as json;
use std::result as results;
use std::toml as toml;
use std::yaml as yaml;
use std::test as test;
use crate::test_support::{expect};

type User = struct {name: String, age: Int};
type Model = struct {
    users: Array(User),
    labels: Dict(String),
    selected: Option(User),
};
type Node = struct {value: Int, children: Array(Node)};

pub def verified_case: test::Test = test::should_ok(fn() {
    let user: User = {name: "Ada", age: 36};
    let model: Model = {
        users: [user],
        labels: {role: "admin"},
        selected: Some(user),
    };
    let node: Node = {value: 1, children: [{value: 2, children: []}]};
    let encoded_user = codec::encode(user);
    let encoded_model = codec::encode(model);
    let encoded_node = codec::encode(node);
    let decoded_user = codec::decode@[(User)](encoded_user).unwrap!();
    let decoded_model = codec::decode@[(Model)](encoded_model).unwrap!();
    let decoded_node = codec::decode@[(Node)](encoded_node).unwrap!();
    let parsed_json = json::parse("{\"name\":\"Ada\",\"age\":36}").unwrap!();
    let parsed_toml = toml::parse("name = \"Ada\"\nage = 36\n").unwrap!();
    let parsed_yaml = yaml::parse("name: Ada\nage: 36\n").unwrap!();
    let verified = decoded_user == user
        && decoded_model == model
        && decoded_node == node
        && codec::decode@[(User)](parsed_json) == Ok(user)
        && codec::decode@[(User)](parsed_toml) == Ok(user)
        && codec::decode@[(User)](parsed_yaml) == Ok(user)
        && !results::is_ok(codec::decode@[(User)](codec::Value::Object({name: codec::Value::String("Ada")})))
        && !results::is_ok(codec::decode@[(User)](codec::Value::Object({
            name: codec::Value::String("Ada"),
            age: codec::Value::String("old"),
        })))
        && dict::keys(model.labels) == ["role"]
        && json::stringify(encoded_user) == "{\"age\":36,\"name\":\"Ada\"}"
        && (json::stringify_pretty(2))(encoded_user)
            == "{\n  \"age\": 36,\n  \"name\": \"Ada\"\n}";
    expect(verified)
});
