import "std/test" as test;
import "@src/test-support" {expect};
import "std/dict" as dict;
import "std/string" as string;
import "std/type-desc" as type_desc;

type CastUser = struct {id: Int, name: String};
type CastA = struct {value: Int};
type CastB = struct {value: Int};
type CastAddress = struct {zip: Int};
type CastNestedUser = struct {address: CastAddress};

decl explicit_identity: for(A) Fn(A) -> A;
def explicit_identity = fn(value) { value };

export def record_precedence = test.should_ok(fn() {
    expect({b: 2 + 3 * 4, a: 1}.b == 14)
});

export def atom_tuples = test.should_ok(fn() {
    expect(('Ok, 42) == ('Ok, 42) && ('Ok, 42) != ('Err, 42))
});

export def function_identity = test.should_ok(fn() {
    expect({
        let f: Fn(Any) -> Any = fn(x) { x };
        f == f && f != fn(x) { x }
    })
});

export def single_assignment_recursion = test.should_ok(fn() {
    expect({
        decl countdown: Fn(Int) -> Int;
        def countdown = fn(n) { if n < 1 { 0 } else { countdown(n - 1) } };
        decl even: Fn(Int) -> Int;
        decl odd: Fn(Int) -> Int;
        def even = fn(n) { if n < 1 { 0 } else { odd(n - 1) } };
        def odd = fn(n) { if n < 1 { 1 } else { even(n - 1) } };
        decl loop: Fn(Int) -> Int;
        let build = fn(body) { body };
        def loop = build(fn(n) { if n < 1 { 0 } else { loop(n - 1) } });
        let invoke = fn(f, n) { f(n) };
        def named: Fn(Int) -> Int = fn(n) { if n < 1 { 0 } else { named(n - 1) } };
        def increment: Fn(Int) -> Int = fn(value) { value + 1 };
        countdown(4) == 0
            && even(4) == 0
            && loop(3) == 0
            && invoke(countdown, 4) == 0
            && named(3) == 0
            && increment(41) == 42
    })
});

export def integer_comparison = test.should_ok(fn() {
    expect(1 == 1 && 1 != 2 && 1 < 2 && 2 > 1 && 1 <= 1 && 2 >= 2)
});

export def float_comparison = test.should_ok(fn() {
    expect(1.0 == 1.0 && 1.0 != 2.0 && 1.0 < 2.0 && 2.0 > 1.0 && 1.0 <= 1.0 && 2.0 >= 2.0 && -0.0 == 0.0)
});

export def string_ordering = test.should_ok(fn() {
    expect("app" < "apple" && "10" < "2" && "Z" < "a" && "é" < "中" && "same" <= "same" && "z" > "a" && "z" >= "z" && "a deliberately heap-backed string" > "a")
});

export def nested_tuple_equality = test.should_ok(fn() {
    expect(('Ok, [1, 2]) == ('Ok, [1, 2]) && ('Ok, [1]) != ('Err, [1]))
});

export def recursive_definitions = test.should_ok(fn() {
    expect({
        let base = 10;
        decl fib: Fn(Int) -> Int;
        def fib = fn(v) {
            if v < 2 { base } else { fib(v - 1) + fib(v - 2) }
        };
        let outer = 40;
        let nested = {
            let local = 2;
            decl answer: Fn(Int) -> Int;
            def answer = fn(n) {
                if n < 1 { outer + local } else { answer(n - 1) }
            };
            answer(3)
        };
        fib(4) == 50 && nested == 42
    })
});

export def inferred_recursion = test.should_ok(fn() {
    expect({
        def countdown = fn(value) {
            if value < 1 { 0 } else { countdown(value - 1) }
        };
        def even = fn(value) {
            if value < 1 { 'True } else { odd(value - 1) }
        };
        def odd = fn(value) {
            if value < 1 { 'False } else { even(value - 1) }
        };
        countdown(4) == 0 && even(4)
    })
});

export def closure_capture = test.should_ok(fn() {
    expect({ let base = 40; let add = fn(value) { base + value }; add(2) } == 42)
});

export def annotated_lambda = test.should_ok(fn() {
    expect((fn(value: Int) -> Int { value + 1 })(41) == 42)
});

export def explicit_generic_identity = test.should_ok(fn() {
    expect(explicit_identity@[Int](42) == 42)
});

export def local_generalization = test.should_ok(fn() {
    expect({
        let identity = fn(value) { value };
        identity(42) == 42 && identity("value") == "value" && identity@[Int](7) == 7
    })
});

export def indexing = test.should_ok(fn() {
    expect({ let values = [10, 20, 30]; values[1] == 20 && ("left", 42).1 == 42 })
});

export def pipelines = test.should_ok(fn() {
    expect({
            let add = fn(a) { fn(b) { a + b } };
            let ops = {increment: fn(value) { value + 1 }};
            (40 |> add(2)) == 42 && (40 |> ops.increment |> fn(value) { value + 1 }) == 42
    })
});

export def call_sections = test.should_ok(fn() {
    expect({
        let combine = fn(a, middle, b) { a + middle + b };
        let section = combine\(_, 10, _);
        let subtract = fn(a, b) { a - b };
        let flipped = subtract\(_1, _0);
        let add = fn(a, b) { a + b };
        let twice = add\(_0, _0);
        let increment = fn(value) { value + 1 };
        let apply = fn(callback, value) { callback(value) };
        let array_type = Array\(_);
        let second = fn(first, second) { second };
        let make: Fn() -> Fn(Any) -> Any = fn() { fn(value) { value } };
        let reevaluated = second\(_, make());
        section(1, 2) == 13
            && flipped(2, 10) == 8
            && twice(21) == 42
            && (40 |> add\(_, 2)) == 42
            && apply(increment\(_), 41) == 42
            && type_desc.kind(array_type(Int)) == 'Array
            && reevaluated(1) != reevaluated(2)
    })
});

export def control_flow = test.should_ok(fn() {
    expect({
        let chained = if 'False { 1 } else if 'False { 2 } else if 'True { 3 } else { 4 };
        let selected = if 'False { 1 } else if let 'Some(value) = 'Some(3) { value } else { 4 };
        let absent_value: Option(Int) = 'None;
        let absent = if let 'Some(value) = absent_value { value + 1 } else { 0 };
        let choose = fn(condition: Bool) {
            if 'False { 1 } else match condition { 'True => 3, 'False => 4 }
        };
        let returning = fn(condition: Bool) {
            if condition { 3 } else return 4;
        };
        (if 'True { 42 } else { 1 / 0 }) == 42
            && chained == 3
            && selected == 3
            && absent == 0
            && choose('True) == 3
            && returning('True) == 3
            && returning('False) == 4
    })
});

export def tuple_patterns = test.should_ok(fn() {
    expect(match ('Ok, 42) { ('Ok, value) => value } == 42)
});

export def variant_patterns = test.should_ok(fn() {
    expect({
            let Some = 'Some;
            let option: Option(Int) = Some(42);
            match option { 'None => 0, 'Some(value) => value }
    } == 42)
});

export def structural_patterns = test.should_ok(fn() {
    expect({
        let user = {name: "Ada", address: {city: "London"}};
        let selected = match user { {name, address: {city}} => (name, city) };
        let select: Fn(Any) -> String = fn(value) {
            match value { {name} => name, _ => "fallback" }
        };
        let is_struct: Fn(Any) -> Bool = fn(value) {
            match value { {} => 'True, _ => 'False }
        };
        selected == ("Ada", "London")
            && select(1) == "fallback"
            && is_struct({})
            && !is_struct(1)
    })
});

export def destructuring_let = test.should_ok(fn() {
    expect({
        let (left, user) = (1, {name: "Ada", address: {city: "London"}});
        let {name, address: {city}} = user;
        (left, name, city) == (1, "Ada", "London")
    })
});

export def option_and_result_propagation = test.should_ok(fn() {
    expect({
        let option_step: Fn(Option(Int)) -> Option(Int) = fn(value) {
            let item = value?;
            'Some(item + 1)
        };
        let result_step: Fn(Result(Int, String)) -> Result(Int, String) = fn(value) {
            let item = value?;
            'Ok(item + 1)
        };
        option_step('Some(2)) == 'Some(3)
            && option_step('None) == 'None
            && result_step('Ok(2)) == 'Ok(3)
            && result_step('Err("bad")) == 'Err("bad")
    })
});

export def inferred_propagation = test.should_ok(fn() {
    expect({
        let step = fn(value: Option(Int)) {
            let item = { value? };
            'Some(item + 1)
        };
        step('Some(1)) == 'Some(2) && step('None) == 'None
    })
});

export def nested_propagation = test.should_ok(fn() {
    expect({
        let outer = fn(value: Option(Int)) {
            let inner: Fn(Option(Int)) -> Option(Int) = fn(inner_value) {
                let item = inner_value?;
                'Some(item + 1)
            };
            'Some(inner(value))
        };
        outer('None) == 'Some('None)
    })
});

export def nearest_return = test.should_ok(fn() {
    expect({
        let choose = fn(condition: Bool, value: Int, fallback: Int) {
            if condition { return value; } else { fallback }
        };
        let outer = fn() {
            let inner = fn() { return 1; };
            inner() + 1
        };
        choose('True, 1, 2) == 1 && choose('False, 1, 2) == 2 && outer() == 2
    })
});

export def match_guards = test.should_ok(fn() {
    expect({
        let value: Option(Int) = 'Some(3);
        match value {
            'Some(item) if 4 < item => 40,
            'Some(item) if 2 < item && item < 4 => item,
            'Some(_) => 0,
            'None => -1,
        } == 3
    })
});

export def array_spread = test.should_ok(fn() {
    expect({
        let middle = [1, 2];
        let empty: Array(Int) = [];
        [0, ...middle, 3, ...empty, 4] == [0, 1, 2, 3, 4]
            && [...[[1], [2, 3]]] == [[1], [2, 3]]
    })
});

export def dict_spread = test.should_ok(fn() {
    expect({
        let base: Dict(Int) = {a: 1, b: 2};
        let extra: Dict(Int) = {b: 3, c: 4};
        let contextual: Dict(Int) = {...{a: 1}, b: 2};
        let merged: Dict(Int) = {...base, x: 0, ...extra, c: 5};
        dict.get(merged, "a") == 'Some(1)
            && dict.get(merged, "b") == 'Some(3)
            && dict.get(merged, "c") == 'Some(5)
            && dict.get(merged, "x") == 'Some(0)
            && dict.keys(merged) == ["a", "b", "c", "x"]
            && dict.get(contextual, "a") == 'Some(1)
            && dict.get(contextual, "b") == 'Some(2)
            && dict.keys(contextual) == ["a", "b"]
    })
});

export def string_literals = test.should_ok(fn() {
    expect({
            let escaped = "A=\x41, shape=\u{5f62}, first \
                second";
            let raw = r##"raw \n "quote" and #"##;
            escaped == "A=A, shape=形, first second" && raw == "raw \\n \"quote\" and #"
    })
});

export def checked_casts = test.should_ok(fn() {
    expect({
        let a: CastA = {value: 1};
        let nested = {address: {zip: "bad"}}.cast!(CastNestedUser);
        cast!(1, Int) == 'Ok(1)
            && 1.cast!(Int) == 'Ok(1)
            && "1".cast!(Int) == 'Err("value must be Int, got String")
            && 1.cast!(Float) == 'Err("value must be Float, got Int")
            && match {id: 1, name: "Ada"}.cast!(CastUser) {
                'Ok(user) => user.id == 1 && user.name == "Ada",
                'Err(_) => 'False,
            }
            && a.cast!(CastB) == 'Err("value has a different declared type identity")
            && match nested {
                'Err(message) => string.contains(message, "value.address.zip"),
                'Ok(_) => 'False,
            }
    })
});

export def remainders = test.should_ok(fn() {
    expect(
        7 % 3 == 1
            && -7 % 3 == -1
            && 7 % -3 == 1
            && -7 % -3 == -1
            && 5.5 % 2.0 == 1.5
            && -5.5 % 2.0 == -1.5
            && 2 + 7 % 4 * 3 == 11
            && 20 / 3 % 2 == 0
    )
});

export def short_circuit_boolean = test.should_ok(fn() {
    expect(
        !('False && (1 / 0 == 0))
            && ('True || (1 / 0 == 0))
            && ('False || 'True && 'True)
    )
});

export def boolean_and_bitwise_not = test.should_ok(fn() {
    expect(
        !'True == 'False
            && !'False
            && !!'True
            && !('True && 'False)
            && !0 == -1
            && !-1 == 0
            && { let invert: Fn(Any) -> Bool = fn(value) { !value }; invert('True) == 'False && invert('False) }
            && { let invert: Fn(Any) -> Any = fn(value) { !value }; invert('True) == 'False && invert(0) == -1 }
    )
});

export def bitwise_operators = test.should_ok(fn() {
    expect(
        6 & 3 == 2
            && 4 | 1 == 5
            && 6 ^ 3 == 5
            && 1 | 2 ^ 3 & 1 == 3
    )
});

export def record_shorthand = test.should_ok(fn() {
    expect({
        let name = "telora";
        let version = 1;
        {name, version} == {name: "telora", version: 1}
    })
});

export def tail_calls = test.should_ok(fn() {
    expect({
        def direct: Fn(Int) -> Int = fn(n) {
            if n < 1 { 0 } else { direct(n - 1) }
        };
        decl even: Fn(Int) -> Int;
        decl odd: Fn(Int) -> Int;
        def even = fn(n) { if n < 1 { 0 } else { odd(n - 1) } };
        def odd = fn(n) { if n < 1 { 1 } else { even(n - 1) } };
        def matched: Fn(Int) -> Int = fn(n) {
            match n { 0 => 0, value => matched(value - 1) }
        };
        let iterate: Fn(Any, Int) -> Int = fn(step, n) {
            if n < 1 { 0 } else { step(step, n - 1) }
        };
        direct(1500) == 0
            && even(1500) == 0
            && matched(1500) == 0
            && iterate(iterate, 1500) == 0
    })
});

export def let_else = test.should_ok(fn() {
    expect({
        let step: Fn(Option(Int)) -> Option(Int) = fn(option) {
            let 'Some(item) = option else { return 'None; };
            'Some(item + 1)
        };
        let require = fn(option: Option(Int)) {
            let 'Some(item) = option else { panic!("none") };
            item
        };
        step('Some(2)) == 'Some(3) && step('None) == 'None && require('Some(4)) == 4
    })
});
