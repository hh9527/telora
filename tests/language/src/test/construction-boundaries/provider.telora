def minimum: Int = 1;

@check(fn(value) {
    if value.count >= minimum { Ok(()) } else { Err(blame!("count below minimum", value.count)) }
})
type Box(T) = struct {value: T, count: Int};

@check(fn(value) {
    if value.count < 5 { Ok(()) } else { Err(blame!("count too large", value.count)) }
})
type Counted(T) = struct(Box(T));

type Choice(T) = enum {
    @check(fn(value) {
        if value.count < 5 { Ok(()) } else { Err(blame!("variant count too large", value.count)) }
    })
    Item(Box(T)),
    Empty,
};

@check(fn(value) {
    if value > 0 {
        let child = Countdown(value - 1);
        if child.0 >= 0 { Ok(()) } else { Err(blame!("invalid child", child)) }
    } else if value == 0 { Ok(()) } else { Err(blame!("negative countdown", value)) }
})
type Countdown = struct(Int);

def consume: for(T) Fn(T) -> Int = fn(value) {
    let candidate: Box(T) = {value, count: 0};
    candidate.count
};

export {Box, Counted, Choice, Countdown, consume};
