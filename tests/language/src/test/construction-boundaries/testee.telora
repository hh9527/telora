import "std/test" as test;
import "std/json" as json;
import "std/codec" as codec;
import "std/dyn" as dyn;
import "std/array" as array;
import "./reexport" {Box, Counted, Choice, Countdown, consume};
import "@src/test-support" {expect};

type Plain = struct {value: String, count: Int};
export def generic_body_rejection = test.should_fail_with(fn() { consume("hi") }, "count below minimum");
def inferred_consume = fn(value) { consume(value) };
export def inferred_body_rejection = test.should_fail_with(fn() {
    inferred_consume("hi")
}, "count below minimum");
export def local_body_rejection = test.should_fail_with(fn() {
    let run = fn(value) { consume(value) };
    run("hi")
}, "count below minimum");
export def local_construction_rejection = test.should_fail_with(fn() {
    let run = fn(value) { Counted({value, count: 0}).0.count };
    run("hi")
}, "count below minimum");
def read: for(T) Fn(Box(T)) -> T = fn(value) { value.value };
def identity: for(T) Fn(T) -> T = fn(value) { value };

export def inferred_candidate = test.should_ok(fn() {
    let candidate: Unchecked(Box(String)) = {value: "hi", count: 2};
    let value = read(candidate);
    expect(value == "hi")
});
export def inferred_candidate_rejected = test.should_fail_with(fn() {
    let candidate: Unchecked(Box(String)) = {value: "hi", count: 0};
    read(candidate)
}, "count below minimum");
export def unconstrained_identity = test.should_ok(fn() {
    let candidate: Unchecked(Box(String)) = {value: "hi", count: 0};
    let copy = identity(candidate);
    expect(dyn.project_with((Box(String)).type, dyn.pack((Unchecked(Box(String))).type, copy)) == None)
});

export def wire_contract = test.should_ok(fn() {
    let checked: Box(String) = {value: "hi", count: 2};
    let plain: Plain = {value: "hi", count: 2};
    expect(json.schema((Box(String)).type) == json.schema((Plain).type)
        && codec.encode((codec.Value).type, checked) == codec.encode((codec.Value).type, plain))
});

export def imported_generic = test.should_ok(fn() {
    let value: Box(String) = {value: "hi", count: 2};
    let wrapped = Counted(value);
    let selected = Choice.Item(value);
    expect(wrapped.0.value == "hi" && match selected {
        Choice.Item(boxed) => boxed.count == 2, Choice.Empty => False,
    })
});
export def first_class_generic = test.should_fail_with(fn() {
    let make = Counted@[String];
    let value: Box(String) = {value: "hi", count: 5};
    make(value)
}, "count too large");
export def generic_variant = test.should_fail_with(fn() {
    let value: Box(Int) = {value: 3, count: 5};
    Choice.Item(value)
}, "variant count too large");
export def callback = test.should_fail_with(fn() {
    let make: Fn(Int) -> Box(String) = fn(count) { {value: "hi", count} };
    array.map([2, 0], make)
}, "count below minimum");
export def codec_generic = test.should_fail_with(fn() {
    match json.decode((Box(String)).type, "{\"value\":\"hi\",\"count\":0}") {
        Ok(value) => value, Err(error) => raise!(error),
    }
}, "count below minimum");
export def dyn_candidate = test.should_ok(fn() {
    let value: Unchecked(Box(String)) = {value: "hi", count: 0};
    let packed = dyn.pack((Unchecked(Box(String))).type, value);
    expect(dyn.project_with((Box(String)).type, packed) == None)
});
export def dyn_pack_checks = test.should_fail_with(fn() {
    let value: Unchecked(Box(String)) = {value: "hi", count: 0};
    dyn.pack((Box(String)).type, value)
}, "count below minimum");
export def recursive_check = test.should_ok(fn() {
    expect(Countdown(100).0 == 100)
});
