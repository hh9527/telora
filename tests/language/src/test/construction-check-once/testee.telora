import "std/test" as test;
import "std/codec" as codec;
import "std/json" as json;
import "std/dyn" as dyn;
import "./provider" {Point};
import "@src/test-support" {expect};

export def copies = test.should_ok(fn() {
    let point: Point = {x: 1};
    let copy: Point = point;
    let refined: Point = copy;
    let pass: Fn(Point) -> Point = fn(value) { value };
    let values: Array(Point) = [point, refined, pass(copy)];
    let encoded = codec.encode((codec.Value).type, point);
    let schema = json.schema((Point).type);
    expect(values[0].x + values[1].x + values[2].x == 3
        && encoded == codec.Value.Object({x: codec.Value.Int(1)})
        && match schema { codec.Value.Object(_) => True, _ => False }
        && dyn.project_with((Point).type, dyn.pack((Point).type, point)) == Some(point))
});

export def merge_chain = test.should_ok(fn() {
    let point: Point = {x: 1};
    let updated = point <~ {x: 2} <~ {x: 3};
    expect(updated.x == 3)
});
