data user_data = import(json) "@src/eval/data-modules/user.json";
data toml_data = import(toml) "@src/eval/data-modules/config.toml";
data yaml_data = import(yaml) "@src/eval/data-modules/config.yaml";
use std::codec as codec;
use std::test as test;
use crate::test_support::{expect};

type User = struct {name: String, age: Int};
type Date = enum {
    OffsetDateTime(String),
    LocalDateTime(String),
    LocalDate(String),
    LocalTime(String),
};
type Tool = struct {name: String};
type Config = struct {
    title: String,
    released: Date,
    environment: Dict(String),
    tools: Array(Tool),
};
type YamlConfig = struct {
    name: String,
    features: Array(String),
    legacy: String,
};

pub def json_data: test::Test = test::should_ok(fn() {
    let user = codec::decode@[(User)](user_data).unwrap!();
    expect(user == {name: "Ada", age: 36})
});

pub def toml_data_case: test::Test = test::should_ok(fn() {
    let config = codec::decode@[(Config)](toml_data).unwrap!();
    let expected_tools: Array(Tool) = [{name: "telora"}, {name: "rustc"}];
    expect(
        config.released == Date::LocalDate("2026-08-04")
            && config.environment.PATH == "/bin"
            && config.tools == expected_tools
    )
});

pub def yaml_data_case: test::Test = test::should_ok(fn() {
    let yaml = codec::decode@[(YamlConfig)](yaml_data).unwrap!();
    expect(
        yaml.name == "Telora"
            && yaml.features == ["static data", "provenance"]
            && yaml.legacy == "yes"
    )
});
