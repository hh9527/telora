import "std/codec" as codec;
import "std/json" as json;
import "std/yaml" as yaml;
import "std/toml" as toml;
import "std/test" as test;
import "@src/test-support" {expect};

export def yaml_error_keeps_input = test.should_fail_with(fn() {
    let input = "a: [";
    let checked: Result(codec.Value, codec.BlameError) = yaml.parse(input);
    match checked { Err(error) => raise!(error), Ok(_) => 0 }
}, "<yaml string>");

export def toml_error_keeps_input = test.should_fail_with(fn() {
    let input = "a = [";
    let checked: Result(codec.Value, codec.BlameError) = toml.parse(input);
    match checked { Err(error) => raise!(error), Ok(_) => 0 }
}, "<toml string>");

type Item = struct {count: Int};
type Items = struct {items: Array(Item)};
@json.untagged
type NumberOrText = enum {Number(Int), Text(String)};

export def nested_subject = test.should_fail_with(fn() {
    let bad: codec.Value = codec.Value.String("wrong");
    let input: codec.Value = codec.Value.Object({items: codec.Value.Array([
        codec.Value.Object({count: codec.Value.Int(1)}),
        codec.Value.Object({count: bad}),
    ])});
    match codec.decode((Items).type, input) { Err(error) => raise!(error), Ok(_) => 0 }
}, "items[1].count");

export def missing_subject = test.should_fail_with(fn() {
    let parent: codec.Value = codec.Value.Object({});
    match codec.decode((Item).type, parent) { Err(error) => raise!(error), Ok(_) => 0 }
}, "missing required field");

export def recover_and_compose = test.should_ok(fn() {
    let input: codec.Value = codec.Value.String("hello");
    let decoded: Result(String, codec.BlameError) = match codec.decode((Int).type, input) {
        Ok(_) => Ok("number"),
        Err(_) => codec.decode((String).type, input),
    };
    expect(match decoded {
        Ok(value) => value == "hello",
        Err(_) => False,
    })
});

export def untagged_failure = test.should_fail_with(fn() {
    let input: codec.Value = codec.Value.Array([]);
    match codec.decode((NumberOrText).type, input) { Err(error) => raise!(error), Ok(_) => 0 }
}, "matches no untagged");

export def syntax_subject = test.should_fail_with(fn() {
    let text = "{invalid";
    match json.decode((Item).type, text) { Err(error) => raise!(error), Ok(_) => 0 }
}, "<json string>");

export def authored_error = test.should_fail_with(fn() {
    let error: codec.BlameError = blame!("custom decoder", codec.Value.Int(42));
    let result: Result(Int, codec.BlameError) = Err(error);
    match result { Err(error) => raise!(error), Ok(_) => 0 }
}, "custom decoder");
