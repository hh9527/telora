use std::codec as codec;
use std::json as json;
use std::yaml as yaml;
use std::toml as toml;
use std::test as test;
use crate::test_support::{expect};

pub def yaml_error_keeps_input: test::Test = test::should_fail_with(fn() {
    let input = "a: [";
    let checked: Result(codec::Value, codec::BlameError) = yaml::parse(input);
    match checked { Err(error) => raise!(error), Ok(_) => 0 }
}, "<yaml string>");

pub def toml_error_keeps_input: test::Test = test::should_fail_with(fn() {
    let input = "a = [";
    let checked: Result(codec::Value, codec::BlameError) = toml::parse(input);
    match checked { Err(error) => raise!(error), Ok(_) => 0 }
}, "<toml string>");

type Item = struct {count: Int};
type Items = struct {items: Array(Item)};
@json::untagged
type NumberOrText = enum {Number(Int), Text(String)};

pub def nested_subject: test::Test = test::should_fail_with(fn() {
    let bad: codec::Value = codec::Value::String("wrong");
    let input: codec::Value = codec::Value::Object({items: codec::Value::Array([
        codec::Value::Object({count: codec::Value::Int(1)}),
        codec::Value::Object({count: bad}),
    ])});
    match codec::decode@[(Items)](input) { Err(error) => raise!(error), Ok(_) => 0 }
}, "items[1].count");

pub def missing_subject: test::Test = test::should_fail_with(fn() {
    let parent: codec::Value = codec::Value::Object({});
    match codec::decode@[(Item)](parent) { Err(error) => raise!(error), Ok(_) => 0 }
}, "missing required field");

pub def recover_and_compose: test::Test = test::should_ok(fn() {
    let input: codec::Value = codec::Value::String("hello");
    let decoded: Result(String, codec::BlameError) = match codec::decode@[(Int)](input) {
        Ok(_) => Ok("number"),
        Err(_) => codec::decode@[(String)](input),
    };
    expect(match decoded {
        Ok(value) => value == "hello",
        Err(_) => False,
    })
});

pub def untagged_failure: test::Test = test::should_fail_with(fn() {
    let input: codec::Value = codec::Value::Array([]);
    match codec::decode@[(NumberOrText)](input) { Err(error) => raise!(error), Ok(_) => 0 }
}, "matches no untagged");

pub def syntax_subject: test::Test = test::should_fail_with(fn() {
    let text = "{invalid";
    match json::decode@[(Item)](text) { Err(error) => raise!(error), Ok(_) => 0 }
}, "<json string>");

pub def authored_error: test::Test = test::should_fail_with(fn() {
    let error: codec::BlameError = blame!("custom decoder", codec::Value::Int(42));
    let result: Result(Int, codec::BlameError) = Err(error);
    match result { Err(error) => raise!(error), Ok(_) => 0 }
}, "custom decoder");
