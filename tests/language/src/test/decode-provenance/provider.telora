import "std/json" as json;
import "std/value" {Value};

export def text: String = "[\"wrong\",\"wrong\"]";
export def parse_value: Fn() -> Value = fn() {
    match json.parse(text) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
};
export def parsed: Value = parse_value();
export def empty: String = "";
export def escaped: String = "{\"value\":\"\\u4e2d\"";
