use std::json as json;
use std::value::{Value};

pub def text: String = "[\"wrong\",\"wrong\"]";
pub def parse_value: Fn() -> Value = fn() {
    match json::parse(text) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
};
pub def parsed: Value = parse_value();
pub def empty: String = "";
pub def escaped: String = "{\"value\":\"\\u4e2d\"";
