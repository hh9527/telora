import "std/json" as json;

export def text = "[\"wrong\",\"wrong\"]";
export def parse_value = fn() {
    match json.parse(text) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
};
export def parsed = parse_value();
export def empty = "";
export def escaped = "{\"value\":\"\\u4e2d\"";
