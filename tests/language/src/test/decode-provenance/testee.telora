use std::codec as codec;
use std::json as json;
use std::test as test;
use std::dict as dict;
data data = import(json) "./input.json";
use self::provider as provider;

type Item = struct {count: Int};
type FloatItem = struct {count: Float};
@json::untagged
type Choice = enum {First(Item), Second(FloatItem)};
@json::rename_all(json::RenameCase::CamelCase)
type Renamed = struct {user_count: Int};
def fail_decode: for(A: codec::Decode) Fn(codec::Value) -> A = fn(value) {
    match codec::decode@[A](value) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
};
def second: Fn(codec::Value) -> codec::Value = fn(value) {
    match value {
        codec::Value::Array(items) => items[1],
        _ => fail!("expected Array"),
    }
};
pub def repeated_static: test::Test = test::should_ok(fn() { fail_decode@[Int](second(data)) });
pub def parsed_function: test::Test = test::should_ok(fn() { fail_decode@[Int](second(provider::parse_value())) });
pub def parsed_module: test::Test = test::should_ok(fn() { fail_decode@[Int](second(provider::parsed)) });
pub def missing: test::Test = test::should_ok(fn() {
    match data {
        codec::Value::Array(items) => fail_decode@[Item](items[2]),
        _ => fail!("expected Array"),
    }
});
pub def empty: test::Test = test::should_ok(fn() {
    match json::decode@[(Item)](provider::empty) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
});
pub def escaped: test::Test = test::should_ok(fn() {
    match json::decode@[(Item)](provider::escaped) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
});
pub def unicode: test::Test = test::should_ok(fn() {
    match data {
        codec::Value::Array(items) => fail_decode@[Int](items[3]),
        _ => fail!("expected Array"),
    }
});
pub def untagged: test::Test = test::should_ok(fn() {
    match data {
        codec::Value::Array(items) => fail_decode@[Choice](items[4]),
        _ => fail!("expected Array"),
    }
});
pub def renamed: test::Test = test::should_ok(fn() {
    match data {
        codec::Value::Array(items) => fail_decode@[Renamed](items[5]),
        _ => fail!("expected Array"),
    }
});

pub def flattened: test::Test = test::should_ok(fn() {
    let wrapped: codec::Value = match data {
        codec::Value::Array(items) => codec::Value::Object({inner: items[4]}),
        _ => fail!("expected Array"),
    };
    match wrapped {
        codec::Value::Object(fields) => fail_decode@[Item](fields.inner),
        _ => fail!("expected Object"),
    }
});

pub def defaulted: test::Test = test::should_ok(fn() {
    let input = match data {
        codec::Value::Array(items) => items[4],
        _ => fail!("expected Array"),
    };
    let count: codec::Value = match input {
        codec::Value::Object(fields) => match dict::get(fields, "count") {
            Some(value) => value,
            None => codec::Value::Int(0),
        },
        _ => fail!("expected Object"),
    };
    fail_decode@[Int](count)
});
