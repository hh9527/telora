use std::fmt as fmt;
use std::result as results;
use std::type_property as type_property;
use std::test as test;
use crate::test_support::{expect};

@fmt::display_by("{host}:{port}")
type Endpoint = struct {host: String, port: Int};
@fmt::display_by("{name}@{endpoint} {{ready}} {ratio} {name}")
type Service = struct {name: String, endpoint: Endpoint, ratio: Float};

@fmt::display_by("{host}:{port}")
type ExplicitEndpoint = struct {host: String, port: Int};
impl fmt::Display for ExplicitEndpoint {
    fmt: fn(self, f) {
        let f = fmt::write_str(f, "explicit(");
        let f = fmt::write_str(f, self.host);
        let f = fmt::write_str(f, ":");
        let f = fmt::write_int(f, self.port);
        fmt::write_str(f, ")")
    },
};

type Plain = struct {value: Int};

pub def verified_case: test::Test = test::should_ok(fn() {
    let endpoint: Endpoint = {host: "localhost", port: 8080};
    let explicit: ExplicitEndpoint = {host: "localhost", port: 8080};
    let service: Service = {name: "api", endpoint, ratio: -0.0};
    let verified = {
        let endpoint_property = type_property::get_type_prop((Endpoint).type, fmt::DisplayBy.type);
        let property_valid = match endpoint_property {
            Some(_) => True,
            None => False,
        };
        fmt::render(fmt::display((Endpoint).type, endpoint)) == "localhost:8080"
            && fmt::render(fmt::Display::fmt(endpoint, fmt::empty())) == "localhost:8080"
            && fmt::render(fmt::display((Service).type, service))
                == "api@localhost:8080 {ready} -0 api"
            && `endpoint=\{explicit}` == "endpoint=explicit(localhost:8080)"
            && property_valid
            && match type_property::get_type_prop((Plain).type, fmt::DisplayBy.type) {
                Some(_) => False,
                None => True,
            }
    };
    expect(verified)
});


pub def accumulator_versions: test::Test = test::should_ok(fn() {
    let a = fmt::write_str(fmt::empty(), "item=");
    let b = fmt::write_int(a, 12);
    let c = fmt::write_str(a, "other");
    expect(fmt::render(a) == "item=" && fmt::render(b) == "item=12"
        && fmt::render(c) == "item=other" && fmt::to_string(12) == "12")
});
pub def json_string_literal: test::Test = test::should_ok(fn() {
    expect(fmt::render(fmt::encode_json_string(fmt::empty(), "a\n\"\\é")) == "\"a\\n\\\"\\\\é\"")
});
pub def float_writes: test::Test = test::should_ok(fn() {
    expect(fmt::render(fmt::write_float(fmt::empty(), -0.0)) == "-0"
        && fmt::render(fmt::encode_json_float(fmt::empty(), 0.125)) == "0.125")
});
