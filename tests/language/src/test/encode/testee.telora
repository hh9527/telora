use std::codec as codec;
use std::json as json;
use std::test as test;
use crate::test_support::{expect};

type Item = struct {count: Int};
type Action = struct {run: Fn(Int) -> Int};
@json::rename_all(json::RenameCase::CamelCase)
type Collision = struct {foo_bar: Int, fooBar: Int};

pub def direct_value: test::Test = test::should_ok(fn() {
    let item: Item = {count: 3};
    let value: codec::Value = codec::encode(item);
    expect(value == codec::Value::Object({count: codec::Value::Int(3)}))
});

pub def value_identity: test::Test = test::should_ok(fn() {
    let input: codec::Value = codec::Value::Array([codec::Value::Int(1), codec::Value::String("two")]);
    let encoded: codec::Value = codec::encode(input);
    expect(encoded == input && match codec::decode@[(codec::Value)](encoded) {
        Ok(value) => value == input,
        Err(_) => False,
    })
});

pub def unsupported_field: test::Test = test::should_fail_with(fn() {
    let action: Action = {run: fn(value) { value }};
    codec::encode(action)
}, "Function has no JSON codec");

pub def invalid_configuration: test::Test = test::should_fail_with(fn() {
    let value: Collision = {foo_bar: 1, fooBar: 2};
    codec::encode(value)
}, "duplicate external field name");

pub def unsupported_type_value: test::Test = test::should_fail_with(fn() {
    codec::encode((Item).type)
}, "cannot encode Type");
