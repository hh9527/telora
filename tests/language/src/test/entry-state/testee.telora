use std::transform_service as service;
use std::test as test;
use std::value::{Value};
use crate::test_support::{expect};

type Model(T) = struct {value: T};
impl service::TransformService for Model(Value) {
    init: fn(ctx) { {value: ctx.sources["value"]}.ty!(Self) },
    transform: fn(self, input) { Value::Array([self.value, input]) },
};

pub def concrete_self: test::Test = test::should_ok(fn() {
    let model: Model(Value) = service::TransformService(Model(Value)).init({sources: {value: Value::Int(42)}});
    expect(service::TransformService(Model(Value)).transform(model, Value::Int(1)) == Value::Array([Value::Int(42), Value::Int(1)]));
    expect(service::TransformService(Model(Value)).transform(model, Value::Int(2)) == Value::Array([Value::Int(42), Value::Int(2)]))
});
