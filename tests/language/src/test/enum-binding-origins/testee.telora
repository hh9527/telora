import "std/test" as test;
import "std/codec" as codec;
import "std/value" as Value;
import "@src/test-support" { expect };
import "@src/test/enum-binding-origins/model" as Model;
import "@src/test/enum-binding-origins/model" { Model as Direct };
import "@src/test/enum-binding-origins/bridge" as bridge;

export def verified = test.should_ok(fn() {
    let a = Model.Model.Model@[Int](1);
    let b = Direct.Model(2);
    let c = bridge.Namespace.Model.Model(3);
    let d = bridge.Alias.Model@[Int](4);
    expect(codec.encode(Value.Value, a) == Value.Value.Object({Model: Value.Value.Int(1)})
        && codec.encode(Value.Value, b) == Value.Value.Object({Model: Value.Value.Int(2)})
        && codec.encode(Value.Value, c) == Value.Value.Object({Model: Value.Value.Int(3)})
        && codec.encode(Value.Value, d) == Value.Value.Object({Model: Value.Value.Int(4)}))
});
