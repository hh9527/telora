use std::test as test;
use std::codec as codec;
use std::value::{ Value };
use crate::test_support::{ expect };
use self::model as Model;
use self::model::{ Model as Direct };

pub def verified: test::Test = test::should_ok(fn() {
    let a = Model::Model::Model@[Int](1);
    let b = Direct::Model(2);
    let c = bridge::Namespace::Model::Model(3);
    let d = bridge::Alias::Model@[Int](4);
    expect(codec::encode(a) == Value::Object({Model: Value::Int(1)})
        && codec::encode(b) == Value::Object({Model: Value::Int(2)})
        && codec::encode(c) == Value::Object({Model: Value::Int(3)})
        && codec::encode(d) == Value::Object({Model: Value::Int(4)}))
});
