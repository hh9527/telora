import "@src/support" as support;
import "std/array" as array;
import "std/value" { Value };

export def check: Fn(Value) -> Value = fn(actual) {
    match support.record_field(actual, "stdout") {
        'Some('Array(records)) => {
            let warnings = array.filter(records, fn(record) { support.string_field_equals(record, "severity", "warning") });
            let expected_path: Value = 'Array(['Int(0)]);
            match array.get(warnings, 0) {
                'Some(record) => if support.succeeded(actual) && array.length(warnings) == 1
                    && support.string_field_equals(record, "phase", "factory")
                    && support.record_field(record, "fixtures") == 'Some(expected_path) { 'True } else { 'False },
                _ => 'False,
            }
        },
        _ => 'False,
    }
};
