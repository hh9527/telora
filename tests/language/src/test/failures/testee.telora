use std::test as test;

def warn: Fn() -> Result(Int, String) = fn() { Err("notice") };
pub def a: test::Test = test::should_fail(fn() { let warning = warn().ok_or_warn!(); fail!("caught") });
pub def b: test::Test = test::should_fail_with(fn() { fail!("ACTUAL") }, "actual");
pub def c: test::Test = test::should_fail(fn() { let warning = warn().ok_or_warn!(); 1 });
pub def d: test::Test = test::should_ok(fn() { fail!("uncaught") });
pub def e: test::Test = test::with_fixtures(["value.json"], fn(value) { fail!("factory failure", value) });
pub def f: test::Test = test::with_fixtures([], fn(value) { test::should_ok(fn() { value }) });
pub def z: test::Test = test::should_ok(fn() { Err("ordinary return").ty!(Result(Int, String)) });
