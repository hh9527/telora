import "std/test" as test;

def warn: Fn() -> Result(Int, String) = fn() { Err("notice") };
export def a: test.Test = test.should_fail(fn() { let warning = warn().ok_or_warn!(); fail!("caught") });
export def b: test.Test = test.should_fail_with(fn() { fail!("ACTUAL") }, "actual");
export def c: test.Test = test.should_fail(fn() { let warning = warn().ok_or_warn!(); 1 });
export def d: test.Test = test.should_ok(fn() { fail!("uncaught") });
export def e: test.Test = test.with_fixtures(["value.json"], fn(value) { fail!("factory failure", value) });
export def f: test.Test = test.with_fixtures([], fn(value) { test.should_ok(fn() { value }) });
export def z: test.Test = test.should_ok(fn() { Err("ordinary return").ty!(Result(Int, String)) });
