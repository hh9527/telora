use std::test as test;
use crate::test_support::{expect};
use self::provider::{ Env, Run };

def read: Fn(Env) -> Int = fn(env) {
    if env.mode == Run { env.data.value } else { 0 }
};

pub def imported_forward_types: test::Test = test::should_ok(fn() {
    expect(read({mode: Run, data: {value: 42}}) == 42)
});
