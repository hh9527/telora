import "std/test" as test;
def bad: Never = fail!("initialization failure");
def unread: Never = fail!("unread initializer must remain lazy");
export def a_demand_failure: test.Test = test.should_fail_with(fn() { bad }, "initialization failure");
export def b_cached_failure: test.Test = test.should_fail(fn() { bad });
export def initializer_failure: test.Test = fail!("test export initialization failure");
