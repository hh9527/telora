use std::test as test;
def bad: Never = fail!("initialization failure");
def unread: Never = fail!("unread initializer must remain lazy");
pub def a_demand_failure: test::Test = test::should_fail_with(fn() { bad }, "initialization failure");
pub def b_cached_failure: test::Test = test::should_fail(fn() { bad });
pub def initializer_failure: test::Test = fail!("test export initialization failure");
