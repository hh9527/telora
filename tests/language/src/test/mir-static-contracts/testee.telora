import "std/test" as test;
import "std/dyn" as dyn;
import "std/eq" as eq;
import "std/type-property" {get_type_prop};
import "@src/test-support" {expect};

def project: for(A) Fn(Dyn) -> Option(A) = fn(value) { dyn.project@[A](value) };
type Item = struct {x: Int};
type Swap(A, B) = struct {next: Swap(B, A)};
@property(PropertyTarget.Type)
type Prop(T) = struct {value: T};
def mark: Fn(Type, Option(Prop(Int))) -> Prop(Int) = fn(owner, previous) { {value: 42} };
@mark type Marked = struct(Int);
trait Printable { print: Fn(Self) -> String };
impl Printable for Int { print: fn(value) { "int" } };
def bounded_identity: for(T: Printable) Fn(T) -> T = fn(value) { value };
def property_identity: for(T: Property(Prop(Int))) Fn(T) -> T = fn(value) { value };
def choose_left: for(A, B) Fn(A, B) -> A = fn(left, right) { left };
def choose_int_global = choose_left@[Int, _];
def choose_bounded: for(A: Printable, B: Property(Prop(Int))) Fn(A, B) -> A = fn(left, right) { left };
def make_identity = fn() { fn(value) { value } };
def phantom_identity: for(Tag) Fn(Int) -> Int = fn(value) { value };
type Message(T) = enum {Data(T), Empty};

export def contextual_nullary_value = test.should_ok(fn() {
    let empty = Message.Empty;
    let concrete: Message(String) = empty;
    expect(concrete == Message.Empty@[String])
});

export def phantom_specialization = test.should_ok(fn() {
    let first = phantom_identity@[String];
    let second = phantom_identity@[Bool];
    expect(first(42) == 42 && second(43) == 43
        && eq.equal(first, phantom_identity@[String]))
});

export def bounded_function_value = test.should_ok(fn() {
    expect(eq.equal(bounded_identity, bounded_identity)
        && eq.equal(property_identity, property_identity))
});

export def partially_applied_function = test.should_ok(fn() {
    let choose_int = choose_left@[Int, _];
    expect(choose_int(42, "text") == 42 && choose_int(43, True) == 43
        && eq.equal(choose_int, choose_int)
        && eq.equal(choose_int, choose_left@[Int, _])
        && eq.equal(choose_int_global, choose_left@[Int, _])
        && choose_int_global(42, "global") == 42
        && choose_int_global(43, True) == 43
        && eq.equal(choose_left@[Int, _], choose_left@[Int, _])
        && eq.equal(choose_bounded@[Int, _], choose_bounded@[Int, _])
        && choose_bounded(42, Marked(1)) == 42)
});

export def returned_function = test.should_ok(fn() {
    expect(make_identity()(42) == 42 && make_identity()("text") == "text")
});

export def static_projection = test.should_ok(fn() {
    expect(project@[Int](dyn.pack(Int.type, 42)) == Some(42)
        && project@[String](dyn.pack(Int.type, 42)) == None)
});

export def local_alias_instances = test.should_ok(fn() {
    let identity = fn(value) { value };
    let alias = identity;
    expect(alias(42) == 42 && alias("text") == "text")
});

export def generic_value_identity_and_calls = test.should_ok(fn() {
    let identity = fn(value) { value };
    let alias = identity;
    expect(eq.equal(identity, alias)
        && !eq.equal(identity, fn(value) { value })
        && identity(42) == 42
        && alias("text") == "text")
});

export def captured_generic_value = test.should_ok(fn() {
    let identity = fn(value) { value };
    let alias = identity;
    let inspect = fn() { eq.equal(identity, alias) };
    let use = fn() { identity(42) == 42 && alias("text") == "text" };
    expect(inspect() && use())
});

export def generic_property_value = test.should_ok(fn() {
    expect(match get_type_prop(Marked.type, Prop(Int).type) {
        Some(property) => property.value == 42,
        None => False,
    })
});

export def struct_spread_context = test.should_ok(fn() {
    let original: Item = {x: 42};
    let copied: Item = {...original};
    expect(copied.x == 42)
});

export def finite_recursive_layout = test.should_ok(fn() {
    expect(Swap(Int, String).type == Swap(Int, String).type
        && Swap(Int, String).type != Swap(String, Int).type)
});
