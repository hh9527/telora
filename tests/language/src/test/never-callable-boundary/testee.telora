use std::test as test;
use crate::test_support::{ expect };
use self::provider::{ stop, accept, indirect };

type Message = enum { Call(Fn(Int) -> Int) };

pub def values: test::Test = test::should_ok(fn() {
    let local: Fn(Int) -> Int = stop;
    let callbacks: Array(Fn(Int) -> Int) = [stop];
    let message = Message::Call(stop);
    expect(accept@[Int](stop) == 1
        && accept@[Int](local) == 1
        && accept@[Int](callbacks[0]) == 1
        && match message { Message::Call(f) => accept@[Int](f) == 1 }
        && indirect(42) == 1 && indirect("text") == 1
        && accept@[Never](stop) == 1)
});

pub def called: test::Test = test::should_fail_with(fn() {
    let callback: Fn(Int) -> Int = stop;
    callback(7)
}, "never callable invoked");
