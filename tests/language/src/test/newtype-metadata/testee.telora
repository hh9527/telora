import "std/test" as test;
import "std/type-desc" as type_desc;
import "std/json" as json;
import "std/codec" as codec;
import "std/dyn" as dyn;
import "std/value" { Value };
import "@src/test-support" { expect };

type UserId = struct(Int);
type OtherId = struct(Int);
type Box(T) = struct(T);
type Nested = struct(UserId);
type Tree = struct(Option(Tree));

export def reflection = test.should_ok(fn() {
    let body = match type_desc.resolve(UserId.type) {
        Ok(body) => body,
        Err(error) => fail!(error.message),
    };
    expect(type_desc.kind(UserId.type) == type_desc.TypeDescKind.Ref
        && type_desc.kind(body) == type_desc.TypeDescKind.Newtype
        && type_desc.children(body) == [(Int).type])
});

export def codec_roundtrip = test.should_ok(fn() {
    let id = match json.decode(UserId.type, "7") {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    expect(id.0 == 7 && codec.encode((Value).type, id) == Value.Int(7)
        && dyn.project_with(OtherId.type, dyn.pack(UserId.type, id)) == None)
});

export def nested_payload_identity = test.should_ok(fn() {
    let nested = match json.decode(Nested.type, "8") {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    let generic = match json.decode(Box(UserId).type, "9") {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    let nested_id: UserId = nested.0;
    let generic_id: UserId = generic.0;
    expect(nested_id.0 == 8 && generic_id.0 == 9
        && codec.encode((Value).type, nested) == Value.Int(8)
        && codec.encode((Value).type, generic) == Value.Int(9))
});

export def recursive_metadata = test.should_ok(fn() {
    let tree = match json.decode(Tree.type, "null") {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    expect(codec.encode((Value).type, tree) == Value.None)
});

export def decode_failure_input = test.should_fail_with(fn() {
    match json.decode(UserId.type, "\"invalid\"") {
        Ok(_) => 0,
        Err(error) => raise!(error),
    }
}, "expected Int");

export def dynamic_payload = test.should_ok(fn() {
    let nested = match json.decode(Nested.type, "10") {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    let items = match dyn.tuple_items(dyn.pack(Nested.type, nested)) {
        Ok(items) => items,
        Err(error) => fail!(error.message),
    };
    expect(dyn.project_with(UserId.type, items[0]) == Some(nested.0)
        && dyn.project_with((Int).type, items[0]) == None)
});

export def schema = test.should_ok(fn() {
    let recursive = json.schema(Tree.type);
    let expected = match json.parse(r##"{"$defs":{"Type0":{"type":"integer"}},"$ref":"#/$defs/Type0","$schema":"https://json-schema.org/draft/2020-12/schema"}"##) {
        Ok(value) => value,
        Err(error) => raise!(error),
    };
    expect(json.schema(UserId.type) == expected)
});
