use std::test as test;
use std::string as string;
use std::json as json;
use self::model::{ Endpoint };
use self::provider as provider;

pub def parsed: test::Test = test::should_ok(fn() { string::parse@[Endpoint](provider::text) });
pub def decoded: test::Test = test::should_ok(fn() {
    match json::decode@[(Endpoint)](provider::json_text) {
        Ok(value) => value, Err(error) => raise!(error),
    }
});
