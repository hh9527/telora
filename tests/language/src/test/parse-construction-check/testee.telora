use std::test as test;
use std::regex as regex;
use std::string as string;
use std::json as json;
use std::codec as codec;
use std::fmt as fmt;
use crate::test_support::{expect};

@string::decode_by_parse
@string::encode_by_display
@fmt::display_by("{host}:{port}")
@regex::parse_by(regex::compile(r"^(?P<host>[^:]+):(?P<port>\d+)$"))
@check(fn(value) {
    if value.port > 0 { Ok(()) } else { Err(blame!("positive port required", value.port)) }
})
type Endpoint = struct {host: String, port: Int};

@string::decode_by_parse
@string::encode_by_display
@fmt::display_by("{name}@{endpoint}")
@regex::parse_by(regex::compile(r"^(?P<name>\w+)@(?P<endpoint>.+)$"))
type Service = struct {name: String, endpoint: Endpoint};
pub use self::{Endpoint};

@json::untagged
type EndpointOrText = enum {Parsed(Endpoint), Text(String)};

pub def untagged_fallback: test::Test = test::should_ok(fn() {
    expect(match json::decode@[(EndpointOrText)]("\"local:0\"") {
        Ok(EndpointOrText::Text(value)) => value == "local:0", _ => False,
    })
});
pub def untagged_ambiguity: test::Test = test::should_fail_with(fn() {
    match json::decode@[(EndpointOrText)]("\"local:80\"") {
        Ok(value) => value, Err(error) => raise!(error),
    }
}, "ambiguously matches multiple");

pub def parse_accepted: test::Test = test::should_ok(fn() {
    expect(match string::parse@[Endpoint]("local:80") {
        Ok(value) => value.host == "local" && value.port == 80,
        Err(_) => False,
    })
});
pub def parse_rejected: test::Test = test::should_fail_with(fn() {
    string::parse@[Endpoint]("local:0")
}, "positive port required");
pub def nested_parse_rejected: test::Test = test::should_fail_with(fn() {
    string::parse@[Service]("api@local:0")
}, "positive port required");
pub def syntax_error: test::Test = test::should_ok(fn() {
    expect(match string::parse@[Endpoint]("invalid") {
        Ok(_) => False, Err(error) => error.value == "invalid",
    })
});
pub def codec_rejection_is_a_value: test::Test = test::should_ok(fn() {
    expect(match json::decode@[(Endpoint)]("\"local:0\"") { Ok(_) => False, Err(_) => True })
});
pub def nested_codec_rejection: test::Test = test::should_fail_with(fn() {
    match json::decode@[(Service)]("\"api@local:0\"") { Ok(value) => value, Err(error) => raise!(error) }
}, "positive port required");
pub def codec_roundtrip: test::Test = test::should_ok(fn() {
    let value = match json::decode@[(Service)]("\"api@local:80\"") {
        Ok(value) => value, Err(error) => raise!(error),
    };
    expect(value.endpoint.port == 80 && codec::encode(value) == codec::Value::String("api@local:80"))
});
