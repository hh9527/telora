use std::test as test;
use crate::test_support::{expect};

def even: Fn(Int) -> Bool = fn(value) { if value == 0 { True } else { odd(value - 1) } };
type Predicate = struct {call: Fn(Int) -> Bool};
def holder: Predicate = {call: even};
def odd: Fn(Int) -> Bool = fn(value) { if value == 0 { False } else { holder.call(value - 1) } };

pub def recursive_record: test::Test = test::should_ok(fn() {
    expect(even(10) && odd(9) && !holder.call(3))
});

def identity: for(T) Fn(T) -> T = fn(value) { value };
type IntFunction = struct {call: Fn(Int) -> Int};
def functions: IntFunction = {call: identity};
def forwarded: Fn(Int) -> Int = fn(value) { functions.call(value) };

pub def nonrecursive_record: test::Test = test::should_ok(fn() {
    expect(forwarded(7) == 7 && functions.call(8) == 8 && identity("text") == "text")
});
