use std::blame::{BlameError};

pub def message: String = "rejected";
pub def subject: Int = 42;
pub def error: BlameError = blame!(message, subject, subject);
pub def string_error: Fn() -> Result(Int, String) = fn() { Err(message) };
pub def blame_error: Fn() -> Result(Int, BlameError) = fn() { Err(error) };
pub def success: Fn() -> Result(Int, BlameError) = fn() { Ok(7) };
pub def nested_raise: Fn() -> Never = fn() { raise!(message) };
pub def nested_unwrap: Fn() -> Int = fn() { string_error().unwrap!() };
pub def nested_warn: Fn() -> Option(Int) = fn() { warn!(error) };
pub def nested_optional: Fn() -> Option(Int) = fn() { blame_error().ok_or_warn!() };
