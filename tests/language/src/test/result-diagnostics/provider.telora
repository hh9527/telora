import "std/blame" {BlameError};

export def message = "rejected";
export def subject = 42;
export def error = blame!(message, subject, subject);
export def string_error: Fn() -> Result(Int, String) = fn() { Err(message) };
export def blame_error: Fn() -> Result(Int, BlameError) = fn() { Err(error) };
export def success: Fn() -> Result(Int, BlameError) = fn() { Ok(7) };
export def nested_raise: Fn() -> Never = fn() { raise!(message) };
export def nested_unwrap: Fn() -> Int = fn() { string_error().unwrap!() };
export def nested_warn: Fn() -> Option(Int) = fn() { warn!(error) };
export def nested_optional: Fn() -> Option(Int) = fn() { blame_error().ok_or_warn!() };
