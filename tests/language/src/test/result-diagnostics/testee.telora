use std::test as test;
use crate::test_support::{expect};
use self::provider as provider;

pub def raise_string: test::Test = test::should_ok(fn() { raise!(provider::message) });
pub def unwrap_string: test::Test = test::should_ok(fn() { provider::string_error().unwrap!() });
pub def raise_blame: test::Test = test::should_ok(fn() { raise!(provider::error) });
pub def unwrap_blame: test::Test = test::should_ok(fn() { unwrap!(provider::blame_error()) });
pub def fail_sugar: test::Test = test::should_ok(fn() { fail!(provider::message, provider::subject, provider::subject) });
pub def fail_composed: test::Test = test::should_ok(fn() { raise!(blame!(provider::message, provider::subject, provider::subject)) });
pub def nested_raise: test::Test = test::should_ok(fn() { provider::nested_raise() });
pub def nested_unwrap: test::Test = test::should_ok(fn() { provider::nested_unwrap() });
pub def warn_string: test::Test = test::should_ok(fn() { expect(warn!(provider::message).ty!(Option(Int)) == None) });
pub def optional_string: test::Test = test::should_ok(fn() { expect(provider::string_error().ok_or_warn!() == None) });
pub def warn_blame: test::Test = test::should_ok(fn() { expect(warn!(provider::error).ty!(Option(String)) == None) });
pub def optional_blame: test::Test = test::should_ok(fn() { expect(ok_or_warn!(provider::blame_error()) == None) });
pub def nested_warn: test::Test = test::should_ok(fn() { expect(provider::nested_warn() == None) });
pub def nested_optional: test::Test = test::should_ok(fn() { expect(provider::nested_optional() == None) });

pub def success: test::Test = test::should_ok(fn() {
    let value: Result(Int, String) = Ok(3);
    expect(value.unwrap!() == 3 && unwrap!(provider::success()) == 7
        && ok_or_warn!(value) == Some(3) && provider::success().ok_or_warn!() == Some(7))
});

def argument: Fn(String, Int) -> Int = fn(label, value) {
    let reported: Option(()) = warn!(label);
    value
};
def factory: Fn() -> Fn(Int, Int) -> Result(Int, String) = fn() {
    let reported: Option(()) = warn!("callee");
    fn(a, b) { let reported: Option(()) = warn!("body"); Ok(a + b) }
};
pub def once: test::Test = test::should_ok(fn() {
    expect(factory()(argument("first", 2), argument("second", 3)).unwrap!() == 5)
});
pub def once_optional: test::Test = test::should_ok(fn() {
    expect(factory()(argument("first", 2), argument("second", 3)).ok_or_warn!() == Some(5))
});
