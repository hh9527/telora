use std::codec as codec;
use std::value::{ Value };
type Choice = enum { Empty, Number(Int), Child(Choice) };
type Sparse = enum { Empty, Impossible(Never) };
pub def inspect: Fn() -> (Value, Value, Value, Value, Value) = fn() {
    let success: Result(Int, String) = Ok(7);
    let failure: Result(Int, String) = Err("bad");
    (codec::encode(Choice::Empty), codec::encode(Choice::Child(Choice::Number(42))),
     codec::encode(Sparse::Empty), codec::encode(success), codec::encode(failure))
};
pub def answer: Value = Value::Array([codec::encode(Choice::Empty), codec::encode(Choice::Child(Choice::Number(42))), codec::encode(Sparse::Empty)]);
