use std::codec as codec;
use std::value::{ Value };
use std::json as json;
@json::rename_all(json::RenameCase::CamelCase)
type Count = struct(Int);
type Counts = struct(Array(Count));
pub def inspect: Fn() -> Value = fn() { codec::encode(Counts([Count(1), Count(2)])) };
pub def answer: Value = inspect();
