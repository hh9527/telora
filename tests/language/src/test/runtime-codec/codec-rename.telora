use std::codec as codec;
use std::json as json;
use std::value::{ Value };
@json::rename_all(json::RenameCase::CamelCase)
type Record = struct { z_value: Int, a_value: String };
pub def inspect: Fn() -> Value = fn() {
    let record: Record = {z_value: 7, a_value: "text"};
    codec::encode(record)
};
pub def answer: Value = inspect();
