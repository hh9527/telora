use std::codec as codec;
use std::json as json;
use std::value::{ Value };
@json::untagged
type Choice = enum { Empty, Number(Int), Text(String) };
pub def inspect: Fn() -> (Value, Value, Value) = fn() {
    (codec::encode(Choice::Empty),codec::encode(Choice::Number(7)),codec::encode(Choice::Text("x")))
};
pub def answer: Value = codec::encode(inspect());
