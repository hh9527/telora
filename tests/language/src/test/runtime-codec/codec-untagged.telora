import "std/codec" as codec;
import "std/json" as json;
import "std/value" { Value };
@json.untagged
type Choice = enum { Empty, Number(Int), Text(String) };
export def inspect: Fn() -> (Value, Value, Value) = fn() {
    (codec.encode(Value.type,Choice.Empty),codec.encode(Value.type,Choice.Number(7)),codec.encode(Value.type,Choice.Text("x")))
};
export def answer: Value = codec.encode(Value.type, inspect());
