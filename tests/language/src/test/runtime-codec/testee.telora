export def codec_display: test.Test = test.should_ok(fn() {
    equal(p_codec_display.answer, expected_codec_display)
});

export def codec_untagged: test.Test = test.should_ok(fn() {
    equal(p_codec_untagged.answer, expected_codec_untagged)
