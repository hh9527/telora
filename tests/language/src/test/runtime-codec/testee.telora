import "./codec-untagged" as p_codec_untagged;
import "./codec-untagged.expected.json" {data as expected_codec_untagged};

export def codec_decode_enum: test.Test = test.should_ok(fn() {
    equal(p_codec_decode_enum.answer, expected_codec_decode_enum)
});

export def codec_decode_nominal: test.Test = test.should_ok(fn() {
    equal(p_codec_decode_nominal.answer, expected_codec_decode_nominal)
});

