use std::json as json;
use std::value::{ Value };
use std::dict as dict;
def value: Value = Value::Object(dict::from_pairs([
    ("z", Value::Object(dict::from_pairs([]))),
    ("a", Value::Array([Value::None, Value::True, Value::False, Value::Int(-7), Value::Float(1.0), Value::String("中\n\"")]))
]));
def pretty: Fn(Value) -> String = json::stringify_pretty(2);
pub def inspect: Fn() -> Array(String) = fn() {
    [json::stringify(value), pretty(value), json::stringify_pretty(0)(value), json::stringify(Value::Array([]))]
};
pub def answer: Value = Value::String(json::stringify(value));
