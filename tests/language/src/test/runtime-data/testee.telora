use std::test as test;
use std::codec as codec;
use std::value::{Value};
use crate::runtime_support::{equal, all};
use crate::test_support::{expect};
use self::json_parse as p_json_parse;
data expected_json_parse = import(json) "./json-parse.expected.json";
use self::json_stringify as p_json_stringify;
data expected_json_stringify = import(json) "./json-stringify.expected.json";
use self::toml_parse as p_toml_parse;
data expected_toml_parse = import(json) "./toml-parse.expected.json";
use self::yaml_parse as p_yaml_parse;
data expected_yaml_parse = import(json) "./yaml-parse.expected.json";

pub def verifies_yaml_parse: test::Test = test::should_ok(fn() {
    equal(p_yaml_parse.answer, expected_yaml_parse)
});

pub def verifies_toml_parse: test::Test = test::should_ok(fn() {
    equal(p_toml_parse.answer, expected_toml_parse)
});

pub def verifies_json_parse: test::Test = test::should_ok(fn() {
    equal(p_json_parse.answer, expected_json_parse)
});

pub def verifies_json_stringify: test::Test = test::should_ok(fn() {
    equal(p_json_stringify.answer, expected_json_stringify)
});
