import "std/test" as test;
import "@src/test-support" {expect};

type A = struct {value: Int};
type B = struct {value: Int};

export def verified_case = test.should_ok(fn() {

    {
        let dynamic_array: Array(Int) = [1, 2];
        let dynamic_tuple: Tuple([Int, String]) = (1, "x");
        let ok: Result(Int, String) = Ok(7);
        let recoverable: Result(Int, String) = Err("recoverable");
        let a: A = {value: 1};
        expect(
            dynamic_array[1] == 2
                && dynamic_tuple.1 == "x"
                && 1.cast!(Int) == Ok(1)
                && "1".cast!(Int) == Err("value must be Int, got String")
                && a.cast!(B) == Err("value has a different declared type identity")
                && ok.ok_or_warn!() == Some(7)
                && ok.unwrap!() == 7
                && recoverable.ok_or_warn!() == None
        )
    }
});
