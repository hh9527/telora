use std::test as test;
use std::codec as codec;
use std::value::{Value};
use crate::runtime_support::{equal, all};
use crate::test_support::{expect};
use self::local_generic_declaration as p_local_generic_declaration;
data expected_local_generic_declaration = import(json) "./local-generic-declaration.expected.json";
use self::local_generics as p_local_generics;
data expected_local_generics = import(json) "./local-generics.expected.json";
use self::test_descriptions as p_test_descriptions;
data expected_test_descriptions = import(json) "./test-descriptions.expected.json";

pub def verifies_local_generics: test::Test = test::should_ok(fn() {
    equal(p_local_generics.answer, expected_local_generics)
});

pub def verifies_test_descriptions: test::Test = test::should_ok(fn() {
    equal(p_test_descriptions.answer, expected_test_descriptions)
});

pub def verifies_local_generic_declaration: test::Test = test::should_ok(fn() {
    equal(p_local_generic_declaration.answer, expected_local_generic_declaration)
});
