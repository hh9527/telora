import "std/dyn" as dyn;
import "std/array" as array;
import "std/value" { Value };
type Item = struct { z: Int, a: String };
type Empty = struct {};
export def checks: Fn() -> Array(Bool) = fn() {
    let item: Item = { z: 42, a: "shared long string" };
    let item = dyn.pack(Item.type, item);
    let dictionary: Dict(Int) = { z: 3, a: 1, m: 2 };
    let dictionary = dyn.pack(Dict(Int).type, dictionary);
    let integer = dyn.pack(Int.type, 42);
    let empty: Empty = {};
    let empty_dict: Dict(Never) = {};
    [match dyn.fields(item) {
        Ok(fields) => array.map(fields, fn(pair) { pair.0 }) == ["a", "z"]
            && dyn.project_with(Int.type, fields[1].1) == Some(42)
            && dyn.project_with(String.type, fields[0].1) == Some("shared long string"),
        Err(_) => False,
     },
     match dyn.fields(dictionary) {
        Ok(fields) => array.map(fields, fn(pair) { pair.0 }) == ["a", "m", "z"]
            && array.map(fields, fn(pair) { dyn.project_with(Int.type, pair.1) }) == [Some(1), Some(2), Some(3)],
        Err(_) => False,
     },
     dyn.fields(dyn.pack(Empty.type, empty)) == Ok([]),
     dyn.fields(dyn.pack(Dict(Never).type, empty_dict)) == Ok([]),
     match dyn.field(item, "a") { Ok(value) => dyn.project_with(String.type, value) == Some("shared long string"), Err(_) => False },
     array.all(["a", "m", "z"], fn(key) { match dyn.field(dictionary, key) { Ok(value) => dyn.desc(value) == Int.type, Err(_) => False } }),
     match dyn.field(item, "missing") { Err(error) => error.value == item && error.message == "Dyn record has no field \"missing\"", Ok(_) => False },
     match dyn.field(dictionary, "missing") { Err(error) => error.value == dictionary && error.message == "Dyn record has no field \"missing\"", Ok(_) => False },
     match dyn.fields(integer) { Err(error) => error.value == integer && error.message == "Dyn field access expects Struct", Ok(_) => False },
     match dyn.field(integer, "x") { Err(error) => error.value == integer && error.message == "Dyn field access expects Struct", Ok(_) => False }]
};
export def answer: Value = Value.Array(array.map(checks(), fn(value) { if value { Value.True } else { Value.False } }));
