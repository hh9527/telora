use std::dyn as dyn;
use std::array as array;
use std::value::{ Value };
type Wrapped = struct((Int, String));
pub def inspect: Fn(Array(Int)) -> Array(Int) = fn(values: Array(Int)) {
    match dyn::array_items(dyn::pack(Array(Int).type, values)) {
        Ok(values) => array::map(values, fn(value) { match dyn::project_with(Int.type, value) { Some(value) => value, None => fail!("wrong element type") } }),
        Err(_) => fail!("wrong sequence type"),
    }
};
pub def checks: Fn() -> Array(Bool) = fn() {
    let integer = dyn::pack(Int.type, 1);
    let nested = ["a long shared string", "é🦀"];
    [match dyn::array_items(dyn::pack(Array(Int).type, [1, 2, 3])) {
         Ok(values) => array::map(values, fn(value) { dyn::project_with(Int.type, value) }) == [Some(1), Some(2), Some(3)],
         Err(_) => False,
     },
     dyn::array_items(dyn::pack(Array(Never).type, [])) == Ok([]),
     match dyn::array_items(dyn::pack(Array(Array(String)).type, [nested])) {
         Ok(values) => dyn::project_with(Array(String).type, values[0]) == Some(nested), Err(_) => False,
     },
     dyn::tuple_items(dyn::pack(().type, ())) == Ok([]),
     match dyn::tuple_items(dyn::pack((Int, String, ()).type, (42, "text", ()))) {
         Ok(values) => array::length(values) == 3 && dyn::project_with(Int.type, values[0]) == Some(42)
             && dyn::project_with(String.type, values[1]) == Some("text") && dyn::project_with(().type, values[2]) == Some(()),
         Err(_) => False,
     },
     match dyn::tuple_items(dyn::pack(Wrapped.type, Wrapped((42, "text")))) {
         Ok(values) => array::length(values) == 1 && dyn::project_with((Int, String).type, values[0]) == Some((42, "text")),
         Err(_) => False,
     },
     match dyn::array_items(integer) { Err(error) => error.value == integer && error.message == "Dyn sequence access has the wrong type", Ok(_) => False },
     match dyn::tuple_items(integer) { Err(error) => error.value == integer && error.message == "Dyn sequence access has the wrong type", Ok(_) => False }]
};
pub def answer: Value = Value::Array(array::map(checks(), fn(value) { if value { Value::True } else { Value::False } }));
