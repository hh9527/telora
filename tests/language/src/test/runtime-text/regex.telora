use std::regex as regex;
use std::array as array;
use std::value::{ Value };
pub def checks: Fn() -> Array(Bool) = fn() {
    let pattern = regex::compile("^(?P<word>[a-z]+)-(?P<number>[0-9]+)$");
    let empty = regex::compile("");
    let unicode = regex::compile("^🦀é+$");
    [regex::is_match(pattern, "item-42"), !regex::is_match(pattern, "item-x"),
     !regex::is_match(pattern, "prefix item-42"),
     regex::is_match(empty, "anything"), regex::is_match(empty, ""),
     regex::is_match(unicode, "🦀éé"), !regex::is_match(unicode, "🦀e"),
     pattern == regex::compile("^(?P<word>[a-z]+)-(?P<number>[0-9]+)$"),
     pattern != empty,
     regex::is_match(pattern, "next-123")]
};
pub def answer: Value = Value::Array(array::map(checks(), fn(value) { if value { Value::True } else { Value::False } }));
