use std::test as test;
use self::path as p_path;

pub def path_lexical: test::Test = test::should_ok(fn() {
    expect(p_path::inspect("") == (".", None, None)
        && p_path::inspect("/../../a") == ("/a", Some("/"), Some("a"))
        && p_path::inspect("a/../../..") == ("../..", Some(".."), Some(".."))
        && p_path::inspect("/a/../../..") == ("/", None, None)
        && p_path::inspect("目录/🦀/../文件") == ("目录/文件", Some("目录"), Some("文件"))
        && p_path::inspect("a\\b") == ("a\\b", Some("."), Some("a\\b")))
});

pub def path_join: test::Test = test::should_ok(fn() {
    match p_path::answer {
        Value::Object(fields) => equal(fields.joins, codec::encode([".", ".", "a/b", "b", "/root/b", "/", "../b", "目录/文件"])),
        _ => fail!("expected path object")
    }
});
use std::codec as codec;
use std::value::{Value};
use crate::runtime_support::{equal, all};
use crate::test_support::{expect};
use self::format_equality as p_format_equality;
data expected_format_equality = import(json) "./format-equality.expected.json";
use self::hash as p_hash;
data expected_hash = import(json) "./hash.expected.json";
use self::regex as p_regex;
use self::regex_prepare as p_regex_prepare;
data expected_regex_prepare = import(json) "./regex-prepare.expected.json";
data expected_regex = import(json) "./regex.expected.json";
use self::string_parse as p_string_parse;
use self::string_parse_record as p_string_parse_record;
data expected_string_parse_record = import(json) "./string-parse-record.expected.json";
data expected_string_parse = import(json) "./string-parse.expected.json";

pub def verifies_hash: test::Test = test::should_ok(fn() {
    equal(p_hash::answer, expected_hash)
});

pub def verifies_string_parse_record: test::Test = test::should_ok(fn() {
    equal(p_string_parse_record.answer, expected_string_parse_record)
});

pub def verifies_regex_prepare: test::Test = test::should_ok(fn() {
    equal(p_regex_prepare.answer, expected_regex_prepare)
});

pub def verifies_string_parse: test::Test = test::should_ok(fn() {
    equal(p_string_parse.answer, expected_string_parse)
});

pub def verifies_regex: test::Test = test::should_ok(fn() {
    equal(p_regex::answer, expected_regex)
});

pub def verifies_format_equality: test::Test = test::should_ok(fn() {
    equal(p_format_equality.answer, expected_format_equality)
});

pub def format_deep_equality: test::Test = test::should_ok(fn() {
    all(p_format_equality.deep_checks(), 2)
});

pub def hash_repeated_calls: test::Test = test::should_ok(fn() {
    let first = all(p_hash::checks(), 12);
    let second = all(p_hash::checks(), 12);
    let third = all(p_hash::checks(), 12);
    expect(first && second && third)
});
