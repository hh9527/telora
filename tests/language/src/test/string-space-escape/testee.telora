use std::test as test;
use crate::test_support::{expect};

pub def space_escape: test::Test = test::should_ok(fn() {
    expect("a\ b" == "ab");
    expect("a\  b" == "ab");
    expect("a\  b" == "ab");
    expect("a\ 	
        b" == "ab");
    expect(`a\ 	
        b` == "ab");
    expect(`a\ b` == "ab");
    expect(`a\ \{ "b" }` == "ab");
    expect(r#"a\ b"# == "a\\ b");
});
