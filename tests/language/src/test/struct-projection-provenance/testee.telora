use std::test as test;
use self::provider as provider;
type Target = struct {x: Int, Y: String};
def selected: Target = provider::source.{x, y as Y};

pub def original: test::Test = test::should_ok(fn() { fail!("original", selected.x) });
pub def renamed: test::Test = test::should_ok(fn() { fail!("renamed", selected.Y) });
pub def container: test::Test = test::should_ok(fn() { fail!("container", selected) });
pub def update: test::Test = test::should_ok(fn() {
    let base: Target = {x: 0, Y: "base"};
    let updated = base <~ provider::source.{y as Y};
    fail!("update", updated.Y)
});

def notice: Fn() -> Result(Int, String) = fn() { Err("receiver evaluated") };
def receiver: Fn() -> provider::Source = fn() {
    let warning = notice().ok_or_warn!();
    provider::source
};
pub def once: test::Test = test::should_ok(fn() {
    let selected: Target = receiver().{x, y as Y};
    selected
});
