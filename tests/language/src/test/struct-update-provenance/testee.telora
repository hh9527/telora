use std::test as test;
use self::provider as provider;

pub def kept: test::Test = test::should_ok(fn() {
    fail!("kept", provider::updated.kept)
});
pub def spread: test::Test = test::should_ok(fn() {
    fail!("spread", provider::updated.replaced)
});
pub def literal: test::Test = test::should_ok(fn() {
    let updated = provider::base <~ {replaced: provider::replacement};
    fail!("literal", updated.replaced)
});
pub def container: test::Test = test::should_ok(fn() {
    fail!("container", provider::updated)
});
