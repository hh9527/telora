use std::test as test;
use std::dyn as dyn;
use crate::test_support::{expect};

type Full = struct {x: Int, label: String};
type Label = struct {label: String};
type Count = struct {x: Int};
type WrongCount = struct {x: String};
type SameShape = struct {x: Int, label: String};
type Child = struct {value: Int};
type Parent = struct {child: Child, values: Array(Int)};
type Box(A) = struct {value: A};

pub def nominal_chain: test::Test = test::should_ok(fn() {
    let base: Full = {x: 1, label: "base"};
    let label: Label = {label: "patch"};
    let count: Count = {x: 2};
    let updated = base <~ label <~ count <~ {x: 3,};
    let checked: Full = updated;
    expect(checked.x == 3 && checked.label == "patch"
        && base.x == 1 && base.label == "base"
        && dyn::project_with((SameShape).type, dyn::pack((Full).type, updated)) == None
        && dyn::project_with((Full).type, dyn::pack((Full).type, updated)) == Some(checked))
});

pub def spread_order: test::Test = test::should_ok(fn() {
    let base: Full = {x: 1, label: "base"};
    let count: Count = {x: 2};
    let wrong: WrongCount = {x: "overwritten"};
    let first = base <~ {x: "overwritten", ...count};
    let second = base <~ {...wrong, x: 3};
    expect(first.x == 2 && second.x == 3
        && (base <~ {...count, ...count}).x == 2
        && (base <~ {}).label == "base")
});

pub def contextual_fields: test::Test = test::should_ok(fn() {
    let base: Parent = {child: {value: 1}, values: [1]};
    let updated = base <~ {child: {value: 2}, values: []};
    let child: Child = updated.child;
    expect(child.value == 2 && updated.values == [] && base.child.value == 1)
});

decl replace: for(A) Fn(Box(A), A) -> Box(A);
def replace = fn(base, value) { base <~ {value: value} };

pub def generic_identity: test::Test = test::should_ok(fn() {
    let base: Box(String) = {value: "base"};
    let updated = replace(base, "updated");
    let checked: Box(String) = updated;
    expect(checked.value == "updated")
});

pub def integer_and: test::Test = test::should_ok(fn() {
    expect((7 & 3 & 1) == 1 && (7 & 2) == 2)
});

pub def update_precedence: test::Test = test::should_ok(fn() {
    let base: Full = {x: 1, label: "base"};
    let expected: Full = {x: 3, label: "base"};
    expect(base<~{x: 7 & 3}<~{} == expected)
});

pub def overwritten_failure: test::Test = test::should_fail_with(fn() {
    let base: Full = {x: 1, label: "base"};
    let count: Count = {x: 2};
    base <~ {x: fail!("update evaluated"), ...count}
}, "update evaluated");
