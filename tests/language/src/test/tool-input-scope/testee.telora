import "std/test" as test;
import "@src/test-support" {expect};

type T = struct {value: String};
type Wrapped = struct(Type);
type Box(T) = struct(T);
type Inner = Int;

def identity: for(T) Fn(T) -> T = fn(value: T) { value };
def metadata: Fn(Type) -> Type = fn(value) { value };

export def lexical_type_inputs = test.should_ok(fn() {
    let value: Box(Int) = Box@[Int](42);
    let scalar: Inner = identity(value.0);
    expect(scalar == 42)
});

export def annotation_dependency = test.should_ok(fn() {
    let value: String = "scope";
    expect(value == "scope" && metadata(String.type) == String.type)
});
