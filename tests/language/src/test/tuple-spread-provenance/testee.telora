use std::test as test;
use self::provider as provider;
def copied: (Int, String, Int) = (...provider::pair, 3);
pub def original: test::Test = test::should_ok(fn() { fail!("original", copied.0) });
pub def container: test::Test = test::should_ok(fn() { fail!("container", copied) });

def notice: Fn(String) -> Result(Int, String) = fn(message) { Err(message) };
def item: Fn(String) -> Tuple([Int]) = fn(message) {
    let warning = notice(message).ok_or_warn!();
    (1,)
};
def empty: Fn(String) -> Tuple([]) = fn(message) {
    let warning = notice(message).ok_or_warn!();
    ()
};
pub def order: test::Test = test::should_ok(fn() {
    (...item("first"), ...empty("middle"), ...item("last"))
});
