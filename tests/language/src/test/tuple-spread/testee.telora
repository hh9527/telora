use std::test as test;
use crate::test_support::{expect};
type Item = struct {value: Int};

pub def heterogeneous: test::Test = test::should_ok(fn() {
    let a = (1, "hi");
    let b = (...a, True.ty!(Bool), 3);
    let expected: Tuple([Int, String, Bool, Int]) = (1, "hi", True, 3);
    expect(b == expected)
});

pub def composition: test::Test = test::should_ok(fn() {
    let a = (1, "hi");
    let b = (2,);
    expect((...(), ...a, ...b, ...()) == (1, "hi", 2)
        && (...a) == a && (...a,) == a
        && (...()) == () && (...b) == (2,)
        && (...((1, 2),), 3) == ((1, 2), 3)
        && (a) == a && (a,) == ((1, "hi"),))
});

pub def nominal_context: test::Test = test::should_ok(fn() {
    let values: Tuple([Int, Item, String]) = (...(1, {value: 2}), "hi");
    let expected: Tuple([Int, Item, String]) = (1, {value: 2}, "hi");
    let nested: Tuple([Item, Int]) = (...(...({value: 2},), 3));
    expect(values == expected && nested.0 == expected.1 && nested.1 == 3)
});

pub def equality_context: test::Test = test::should_ok(fn() {
    let item: Item = {value: 1};
    expect((item, 2) == (...({value: 1},), 2)
        && (...({value: 1},), 2) == (item, 2))
});

def append: for(A) Fn(Tuple([A, String])) -> Tuple([A, String, Int]) =
    fn(value) { (...value, 3) };
pub def generic: test::Test = test::should_ok(fn() {
    expect(append((1, "hi")) == (1, "hi", 3))
});

def consume: Fn(Tuple([Item, String])) -> Int = fn(value) { value.0.value };
pub def argument_context: test::Test = test::should_ok(fn() {
    expect(consume((...({value: 7},), "hi")) == 7)
});

pub def failed_operand: test::Test = test::should_fail_with(fn() {
    let broken: Fn() -> Tuple([Int]) = fn() { fail!("tuple spread failed") };
    (...broken(), 2)
}, "tuple spread failed");
