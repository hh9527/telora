use self::provider as model;
use std::test as test;
use crate::test_support::{expect};

def request: Fn(Int) -> model::Request = fn(take) { {by: ["region"], take} };

pub def accepts: test::Test = test::should_ok(fn() { expect(request(1).take == 1) });
pub def empty: test::Test = test::should_fail_with(fn() {
    let value: model::Request = {by: [], take: 1};
    value
}, "empty groups");
pub def rejects_completion: test::Test = test::should_fail_with(fn() {
    let candidate: Unchecked(model::Request) = {by: ["region"], take: 0};
    let value: model::Request = candidate;
    value
}, "invalid take");
pub def accepts_completion: test::Test = test::should_ok(fn() {
    let candidate: Unchecked(model::Request) = {by: ["region"], take: 2};
    let value: model::Request = candidate;
    expect(value.take == 2)
});
