use std::test as test;
use crate::test_support::{expect};

type Empty = ();
type Old = Tuple([]);
def zero: Fn() -> () = fn() {};
def one: Fn(()) -> Unit = fn(value: ()) -> () { value };
def early: Fn() -> Int = fn() { 1; return 42; };

pub def identity: test::Test = test::should_ok(fn() {
    let a: Empty = zero();
    let b: Old = one(a);
    expect(a == () && b == () && (Unit).type == (Empty).type && (Empty).type == (Old).type);
});

pub def tails: test::Test = test::should_ok(fn() {
    let empty = do {};
    let bindings = do { let a = 42; };
    let discarded = do { 42; };
    let tail = do { 1; let a = 2; a + 3 };
    expect(empty == () && bindings == () && discarded == () && tail == 5);
    expect(early() == 42);
});

pub def branches: test::Test = test::should_ok(fn() {
    let unit = if True { 1; } else {};
    let value = if False { fail!("unreachable"); } else { 42 };
    let other = if True { 42 } else { fail!("unreachable"); };
    expect(unit == () && value == 42 && other == 42);
});

pub def failure: test::Test = test::should_fail_with(fn() {
    fail!("discarded failure");
}, "discarded failure");

pub def bound_failure: test::Test = test::should_fail_with(fn() {
    let value = fail!("bound failure");
}, "bound failure");
