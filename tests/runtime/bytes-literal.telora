import "std/codec" {encode, Value};
import "std/transform-service" as entry;
import "std/hash" as hash;
def empty: Bytes = b"";
def shared: Bytes = b"long byte literal retained across initialization and entry";
def checks: Fn() -> Value = fn() {
    encode([
        empty == b"",
        b"a\nb" == b"a\nb",
        b"文本" == b"文本",
        b"a" != b"b",
        shared == b"long byte literal retained across initialization and entry",
        hash.finish(hash.update_bytes(hash.new(), shared)) == hash.finish(hash.update_bytes(hash.new(), b"long byte literal retained across initialization and entry")),
    ])
};
export def answer: Value = checks();
type MainService = struct {};
impl entry.TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) { checks() },
};
export {MainService};
