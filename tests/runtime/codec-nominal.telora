import "std/codec" {decode, encode, Decode, Value};

type Wrapped(T) = struct(T);
type Rec = struct {a: Int, note: Option(String)};
type Node = struct {children: Array(Node), value: Int};
type Choice = enum {Empty, Payload(Wrapped(Int))};
type Temporal = enum {LocalDate(String)};

def read: for(T: Decode) Fn(Value) -> T = fn(input) {
    match decode@[T](input) {
        Ok(value) => value,
        Err(error) => raise!(error),
    }
};

export def answer: Value = encode((
    read@[Wrapped(Int)](Value.Int(42)),
    read@[Rec](Value.Object({a: Value.Int(1)})),
    read@[Choice](Value.String("Empty")),
    read@[Choice](Value.Object({Payload: Value.Int(2)})),
    read@[Node](Value.Object({
        value: Value.Int(3),
        children: Value.Array([Value.Object({value: Value.Int(4), children: Value.Array([])})]),
    })),
    read@[Temporal](Value.LocalDate("2026-09-12")),
));
