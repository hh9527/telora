use std::json as json;
use std::yaml as yaml;
use std::toml as toml;
use std::codec::{Value, BlameError};

def read: Fn(Result(Value, BlameError)) -> Value = fn(result) {
    match result { Ok(value) => value, Err(error) => raise!(error) }
};

pub def answer: String = json::stringify(Value::Array([
    read(json::parse(r#"{"z": [1, true, null], "a": "文本"}"#)),
    read(yaml::parse("a: &shared [1, 2]\nb: *shared\n")),
    read(toml::parse("count = 42\nname = \"sample\"\n")),
]));
