import "std/codec" {encode, Value};
import "std/transform-service" as entry;
def original: String = "shared debug payload";
def shared: String = dbg!(original, "initialize");
def checks: Fn() -> Value = fn() {
    let data = dbg!((True, 1, 1.5, "text", b"ab", [1, 2], {x: 3}.ty!(Dict(Int)), Some(4)), "entry");
    encode([dbg!(shared) == original, data.1 == 1])
};
export def answer: Value = encode(shared);
type MainService = struct {};
impl entry.TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) { checks() },
};
export {MainService};
