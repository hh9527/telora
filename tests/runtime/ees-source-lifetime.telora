import "std/actor" as actor;
import "std/value" {Value, ScalarValue};
import "std/entry" as entry;
import "std/ees" as effect;
def config: entry.ContextConfig = {sources: [], envs: [], args: False};
def ees: effect.Config = {vars: {}, models: [effect.sqlite_model("catalog", "user-data:catalog.sqlite")]};
type State = struct {request: String, round: Int, first: Option(Value)};
def query = fn(id: String, round: Int) {
    actor.ees_call("query", id, effect.sqlite_query("catalog", "SELECT ? AS score", [ScalarValue.Int(round)]))
};
export def run = entry.run(State.type, config, ees, fn(ctx) {
    let reduce: Fn(State, actor.Event) -> actor.Transition(State) = fn(state, event) {
        match event {
            actor.Event.Request(request) => (
                {request: request.id, round: 0, first: None}, [query(request.id, 0)]
            ),
            actor.Event.EesReply(reply) => {
                let value = reply.result.unwrap!();
                let first = match state.first {Some(value) => value, None => value};
                if state.round == 127 {
                    (state, [actor.reply(state.request, Value.Array([first, value]))])
                } else {
                    ({request: state.request, round: state.round + 1, first: Some(first)},
                     [query(state.request, state.round + 1)])
                }
            },
        }
    };
    let initial: State = {request: "", round: 0, first: None};
    (initial, reduce)
});
