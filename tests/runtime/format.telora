import "std/fmt" as fmt;
def integer: fmt.Fmt = fmt.from_int(42);
def nested: fmt.Fmt = fmt.concat(["[", ", ", ", ", "]"], [integer, fmt.from_float(1.25), fmt.from_string("text")]);
export def answer: (fmt.Fmt, String, (Array(String), Array(String))) = (nested, fmt.render(nested), fmt.prepare("{{{name}}}:{other}{name}"));
