import "std/value" as value;
import "std/codec" as codec;
import "std/transform-service" as entry;
def functions: (Fn(Int, String) -> Int, Fn(Int, Int) -> Int) = do {
    let offset = 42;
    decl even: for(T) Fn(Int, T) -> Int;
    def even = fn(n, witness) {
        if n == 0 {offset} else {odd(n - 1, witness)}
    };
    def odd: for(T) Fn(Int, T) -> Int = fn(n, witness) {
        if n == 0 {0} else {even(n - 1, witness)}
    };
    (even@[String], even@[Int])
};
export def answer: value.Value = codec.encode(functions.0(4, "text"));
type MainService = struct {};
impl entry.TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) {codec.encode(functions.1(4, 7))},
};
export {MainService};
