use std::codec::{encode, Value};
use std::transform_service as entry;
def make: Fn(Int) -> Fn() -> Int = fn(offset) {
    def add: for(T) Fn(T) -> Int = fn(value) {offset};
    fn() {add(0) + add@[String]("ignored")}
};
def shared: Fn() -> Int = make(21);
def checks: Fn() -> Value = fn() {
    let offset = 2;
    def sum: Fn(Int) -> Int = fn(n) {if n == 0 {if sum == sum {offset} else {0}} else {n + sum(n - 1)}};
    encode([shared() == 42, make(20)() == 40, sum(8) == 38])
};
pub def answer: Value = checks();
type MainService = struct {};
impl entry::TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) {checks()},
};
pub use self::{MainService};
