import "std/value" as value;
import "std/codec" as codec;
import "std/transform-service" as entry;
def functions: (Fn(Int) -> Int, Fn(Int) -> Int) = do {
    let offset = 42;
    def even: Fn(Int) -> Int = fn(n) {
        if n == 0 { offset } else { odd(n - 1) }
    };
    def odd: Fn(Int) -> Int = fn(n) {
        if n == 0 { 0 } else { even(n - 1) }
    };
    def alias: Fn(Int) -> Int = even;
    let same = alias == even;
    (fn(n) {if same {alias(n)} else {0}}, odd)
};
export def answer: value.Value = codec.encode(functions.0(4));
type MainService = struct {};
impl entry.TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) {codec.encode(functions.0(4))},
};
export {MainService};
