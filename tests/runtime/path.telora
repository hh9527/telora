use std::path as path;
use std::array as array;
use std::codec::{encode, Value};
use std::transform_service as entry;

def inputs: Array(String) = ["", ".", "..", "/", "/../a//b/./../c/", "../../a/../b", "a/../../..", "a/..", "a", "/a", "a\\b", "目录/../文件", "a/../.."];
pub def answer: Value = encode((
    array::map(inputs, fn(input) { (path::normalize(input), path::parent(input), path::file_name(input)) }),
    [path::join([]), path::join(["a", "b", "..", "c"]), path::join(["a", "/b", "c"]), path::join(["a", "", ".."]), path::join(["..", "..", "a"])],
));
type LegacyService = struct {};
impl entry::TransformService for LegacyService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) { answer },
};
@entry::collection
pub type MainService = struct { @entry::slot("transform") service: LegacyService };
