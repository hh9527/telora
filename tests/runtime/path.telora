import "std/path" as path;
import "std/array" as array;
import "std/codec" {encode, Value};
import "std/transform-service" as entry;

def inputs: Array(String) = ["", ".", "..", "/", "/../a//b/./../c/", "../../a/../b", "a/../../..", "a/..", "a", "/a", "a\\b", "目录/../文件", "a/../.."];
export def answer: Value = encode(Value.type, (
    array.map(inputs, fn(input) { (path.normalize(input), path.parent(input), path.file_name(input)) }),
    [path.join([]), path.join(["a", "b", "..", "c"]), path.join(["a", "/b", "c"]), path.join(["a", "", ".."]), path.join(["..", "..", "a"])],
));
type MainService = struct {};
impl entry.TransformService for MainService {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) { answer },
};
export {MainService};
