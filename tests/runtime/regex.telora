use std::regex as regex;
use std::type_property as properties;
def pattern: regex::Regex = regex::compile("^(?P<a>[0-9]+)(?:-(?P<b>[a-z]+))?$");
@regex::parse_by(pattern)
type Item = struct { a: Int, b: Option(String) };
pub def answer: (regex::Regex, Bool, Bool, regex::ParseBy) = (pattern, regex::is_match(pattern, "42"), regex::is_match(pattern, "wrong"), properties::evidence(Item.type, regex::ParseBy.type));
