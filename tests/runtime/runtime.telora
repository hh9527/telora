pub def integer: Int = 1;
pub def text: String = "text";
pub def ints: Array(Int) = [1, 2];
pub def mapping: Dict(Array(Int)) = {a: ints};
pub def repeated: (Array(Int), Array(Int)) = (ints, ints);
pub type Rec = struct {count: Int, label: String};
pub def record: Rec = {count: 1, label: "text"};
pub def pair: (Int, String) = (1, "text");
pub def function: Fn(Int) -> Int = fn(value) { value };
