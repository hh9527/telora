pub def configure: Fn(Int) -> (Int, Fn(Int) -> (Int, Fn(Int, Int) -> (Int, Array(Int)))) = fn(env: Int) {
    (env, fn(resources: Int) {
        (env + resources, fn(state: Int, event: Int) {
            if event == 0 { fail!("service event failed") }
            else { (state + event, [state + event]) }
        })
    })
};
