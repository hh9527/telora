import "std/string" as string;
import "std/regex" as regex;
import "std/codec" {encode, Value};

@regex.parse_by(regex.compile(r"^(?P<host>[^:]+):(?P<port>-?\d+)(?:#(?P<label>.*))?$"))
@check(fn(value) {
    if value.port > 0 { Ok(()) } else { Err(blame!("positive port required", value.port)) }
})
type Endpoint = struct {host: String, port: Int, label: Option(String)};

@regex.parse_by(regex.compile(r"^(?P<name>\w+)@(?P<endpoint>.+)$"))
type Service = struct {name: String, endpoint: Endpoint};

def read: for(T: string.FromStr) Fn(String) -> T = fn(input) {
    match string.parse@[T](input) {
        Ok(value) => value,
        Err(error) => fail!(error.message, error.value),
    }
};

export def answer: Value = encode(Value.type, (
    read@[Int]("42"),
    read@[Float]("-1.5"),
    read@[Option(Int)]("7"),
    read@[Service]("api@localhost:80"),
    read@[Endpoint]("节点:81#标签"),
    match string.parse@[Float]("NaN") { Err(_) => True, Ok(_) => False },
));
