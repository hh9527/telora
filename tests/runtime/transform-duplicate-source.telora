use std::transform_service as service;
@service::source("a")
@service::source("a")
type DuplicateSource = struct {};
impl service::TransformService for DuplicateSource {
    init: fn(ctx) { {}.ty!(Self) },
    transform: fn(self, input) { input },
};
@service::collection
pub type MainService = struct { @service::slot("transform") service: DuplicateSource };
