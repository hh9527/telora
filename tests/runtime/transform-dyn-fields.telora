use std::dyn as dyn;
use std::transform_service as service;
use std::value::{Value};

type MainService = struct {answer: Int};

impl service::TransformService for MainService {
    init: fn(ctx) {
        match dyn::construct@[MainService]([dyn::pack(Int.type, 42)]) {
            Ok(value) => value,
            Err(_) => fail!("service construction failed"),
        }
    },
    transform: fn(self, input) {Value::Int(self.answer)},
};

pub use self::{MainService};
