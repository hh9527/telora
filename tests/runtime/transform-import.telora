import "@src/lib" {output};
import "std/transform-service" as service;
import "std/value" {Value};
type MainService = struct {output: String};
impl service.TransformService for MainService {
    init: fn(ctx) { {output}.ty!(Self) },
    transform: fn(self, input) { Value.String(self.output) },
};
export {MainService};
