use std::transform_service as service;
use std::codec as codec;
use std::value::{Value};
data base = import(json) "./base.json";

@check(fn(value) { if value > 0 { Ok(()) } else { Err(blame!("positive input required", value)) } })
type Count = struct(Int);

type Input = struct {answer: Count, endpoint: String};

@service::source("config")
type InputService = struct {config: Value, base: Value};
impl service::TransformService for InputService {
    init: fn(ctx) {
        {config: ctx.sources["config"], base}.ty!(Self)
    },
    transform: fn(self, input) {
        let decoded: Input = codec::decode@[Input](input).unwrap!();
        Value::Array([self.config, self.base, codec::encode(decoded)])
    },
};
@service::collection
pub type MainService = struct { @service::slot("transform") service: InputService };
