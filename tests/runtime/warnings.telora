import "std/entry" as entry; import "std/blame" {BlameError};
import "std/value" {Value};

def subject: Int = 7;
def warning: Option(Int) = warn!(blame!("initialization warning", subject));
def issue: BlameError = blame!("entry warning", subject);
export def answer: Value = match warning { None => Value.Int(42), Some(value) => fail!("warn returned Some") };
export def main: entry.Eval = entry.main(
    { sources: [], envs: [], args: False },
    fn(ctx) {
        let warning: Option(Int) = warn!(issue);
        match warning { None => Value.Int(43), Some(value) => fail!("warn returned Some") }
    },
);
